---
// src/layouts/DashboardLayout.astro
import '../styles/global.css';
import { getAuthorProfile } from '../config/authors';

const { title = "Dashboard" } = Astro.props;
const user = Astro.locals.user;
const authorProfile = getAuthorProfile(user?.email);
const license = Astro.locals.license;

// 1. Get the current URL path to highlight the active menu
const currentPath = Astro.url.pathname;

// Helper variables for styling
const activeClass = "bg-[#e8f0fe] text-[#1a73e8]";
const inactiveClass = "hover:bg-[#f8f9fa] text-[#475569] hover:text-[#1e293b]";
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Dashboard</title>
    <style>
        #mainSidebar {
            transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            white-space: nowrap;
            min-width: 0;
        }
        #mainSidebar.collapsed {
            width: 56px !important;
            min-width: 56px;
        }
        #mainSidebar.collapsed .sidebar-menu-text {
            opacity: 0;
            width: 0;
            min-width: 0;
            overflow: hidden;
            transition: opacity 0.15s ease, width 0.15s ease;
        }
        #mainSidebar:not(.collapsed) .sidebar-menu-text {
            opacity: 1;
            transition: opacity 0.3s ease 0.1s;
        }
        #mainSidebar.collapsed .sidebar-header-title {
            opacity: 0;
            width: 0;
            overflow: hidden;
        }
        #sidebarToggleBtn {
            cursor: pointer;
            flex-shrink: 0;
        }
        #sidebarToggleBtn:hover {
            background-color: #e8f0fe;
        }
        .sidebar-nav-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.5rem 0.75rem;
            border-radius: 0.5rem;
            transition: background-color 0.2s, color 0.2s;
            white-space: nowrap;
        }
        .sidebar-nav-item .sidebar-menu-text {
            font-size: 0.875rem;
            font-weight: 500;
        }
        #mainSidebar.collapsed .sidebar-nav-item {
            justify-content: center;
            padding: 0.5rem;
            gap: 0;
        }
        #mainSidebar.collapsed .sidebar-nav-item svg {
            margin: 0;
        }
    </style>
</head>
<body class="bg-[#f0f2f7] text-[#1e293b] font-sans flex overflow-hidden" style="height:100vh;height:100dvh;">

    <div id="mobileSidebarContainer" class="fixed inset-0 z-30 md:hidden hidden">
        <div id="mobileSidebarOverlay" class="absolute inset-0 bg-gray-900/50"></div>
        <aside id="mobileSidebar" class="relative z-10 w-64 h-full bg-white flex flex-col transition-transform duration-300 ease-in-out -translate-x-full">
            <div class="h-16 flex items-center justify-between px-4 border-b border-[#e2e8f0]">
                <h1 class="font-bold text-xl text-[#1a73e8]">AI Publisher</h1>
                <button id="closeMobileMenuBtn" class="w-9 h-9 flex items-center justify-center rounded-lg text-slate-500 hover:text-blue-600 hover:bg-[#e8f0fe]" aria-label="Close menu">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>
         
            <nav class="flex-1 px-2 py-3 space-y-1.5">
                <a href="/" class={`sidebar-nav-item ${currentPath === '/' ? activeClass : inactiveClass}`}>
                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                    <span class="sidebar-menu-text">Dashboard</span>
                </a>
                <a href="/write" class={`sidebar-nav-item ${currentPath.startsWith('/write') ? activeClass : inactiveClass}`}>
                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    <span class="sidebar-menu-text">Write Article</span>
                </a>
                <a href="/posts" class={`sidebar-nav-item ${currentPath.startsWith('/posts') ? activeClass : inactiveClass}`}>
                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
                    <span class="sidebar-menu-text">All Posts</span>
                </a>
                {user?.role === 'admin' && (
                    <a href="/hash" class={`sidebar-nav-item ${currentPath.startsWith('/hash') ? activeClass : inactiveClass}`}>
                        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 10-8 0v4h8z"/></svg>
                        <span class="sidebar-menu-text">Hash Tool</span>
                    </a>
                )}
                <a href="/messaging" class={`sidebar-nav-item ${currentPath.startsWith('/messaging') ? activeClass : inactiveClass}`}>
                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                    <span class="sidebar-menu-text">Messaging</span>
                </a>
                {user?.role === 'admin' && (
                    <a href="/images" class={`sidebar-nav-item ${currentPath.startsWith('/images') ? activeClass : inactiveClass}`}>
                        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        <span class="sidebar-menu-text">R2 Media</span>
                    </a>
                )}
            </nav>
            <div class="border-t border-[#e2e8f0] p-2 space-y-2">
                <div class="px-2 py-1">
                    {license?.isValid ? (
                        <span class="text-[10px] text-[#137333] bg-[#e6f4ea] px-2 py-0.5 rounded border border-[#ceead6] font-medium tracking-[0.2px] block text-center" style="font-family:'Google Sans',Roboto,sans-serif;">
                            ✔ Licensed to {license.buyerName}
                        </span>
                    ) : (
                        <span class="text-[10px] text-[#b06000] bg-[#fef7e0] px-2 py-0.5 rounded border border-[#feebc8] font-medium tracking-[0.2px] block text-center" style="font-family:'Google Sans',Roboto,sans-serif;">
                            ⚠ Unlicensed Copy (Evaluation)
                        </span>
                    )}
                </div>
                <form method="POST" action="/api/logout">
                    <button type="submit" class="sidebar-nav-item w-full text-[#475569] hover:bg-[#fef2f2] hover:text-[#dc2626]">
                        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                        <span class="sidebar-menu-text">Logout</span>
                    </button>
                </form>
            </div>
        </aside>
    </div>
    
    <aside id="mainSidebar" class="w-56 bg-white border-r border-[#e2e8f0] flex-col hidden md:flex shrink-0 overflow-hidden">
        <div class="h-16 flex items-center gap-2 px-4 border-b border-[#e2e8f0]">
            <button id="sidebarToggleBtn" class="w-9 h-9 flex items-center justify-center rounded-lg text-slate-500 hover:text-blue-600 hover:bg-[#e8f0fe] transition-all duration-200 shrink-0" aria-label="Toggle Sidebar" title="Toggle Sidebar">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path id="sidebarIcon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
            <h1 class="sidebar-header-title font-bold text-xl text-[#1a73e8] transition-all duration-300">AI Publisher</h1>
        </div>
        <nav class="flex-1 px-2 py-3 space-y-1.5">
            <a href="/" class={`sidebar-nav-item ${currentPath === '/' ? activeClass : inactiveClass}`}>
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span class="sidebar-menu-text">Dashboard</span>
            </a>
            <a href="/write" class={`sidebar-nav-item ${currentPath.startsWith('/write') ? activeClass : inactiveClass}`}>
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                <span class="sidebar-menu-text">Write Article</span>
            </a>
            <a href="/posts" class={`sidebar-nav-item ${currentPath.startsWith('/posts') ? activeClass : inactiveClass}`}>
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
                <span class="sidebar-menu-text">All Posts</span>
            </a>
            {user?.role === 'admin' && (
                <a href="/hash" class={`sidebar-nav-item ${currentPath.startsWith('/hash') ? activeClass : inactiveClass}`}>
                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 10-8 0v4h8z"/></svg>
                    <span class="sidebar-menu-text">Hash Tool</span>
                </a>
            )}
            <a href="/messaging" class={`sidebar-nav-item ${currentPath.startsWith('/messaging') ? activeClass : inactiveClass}`}>
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                <span class="sidebar-menu-text">Messaging</span>
            </a>
            {user?.role === 'admin' && (
                <a href="/images" class={`sidebar-nav-item ${currentPath.startsWith('/images') ? activeClass : inactiveClass}`}>
                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    <span class="sidebar-menu-text">R2 Media</span>
                </a>
            )}
        </nav>
        <div class="border-t border-[#e2e8f0] p-2 space-y-2">
            <div class="px-2 py-1">
                {license?.isValid ? (
                    <span class="text-[10px] text-[#137333] bg-[#e6f4ea] px-2 py-0.5 rounded border border-[#ceead6] font-medium tracking-[0.2px] block text-center" style="font-family:'Google Sans',Roboto,sans-serif;">
                        ✔ Licensed to {license.buyerName}
                    </span>
                ) : (
                    <span class="text-[10px] text-[#b06000] bg-[#fef7e0] px-2 py-0.5 rounded border border-[#feebc8] font-medium tracking-[0.2px] block text-center" style="font-family:'Google Sans',Roboto,sans-serif;">
                        ⚠ Unlicensed Copy (Evaluation)
                    </span>
                )}
            </div>
            <form method="POST" action="/api/logout">
                <button type="submit" class="sidebar-nav-item w-full text-[#475569] hover:bg-[#fef2f2] hover:text-[#dc2626]">
                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                    <span class="sidebar-menu-text">Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="flex-1 flex flex-col overflow-hidden min-w-0">
        
        <header id="dashboardHeader" class="h-16 bg-white border-b border-[#e2e8f0] flex items-center justify-between px-4 lg:px-6 shadow-sm z-10">
            <div class="flex items-center gap-3">
                <button id="mobileMenuBtn" class="md:hidden w-9 h-9 -ml-2 flex items-center justify-center rounded-lg text-slate-500 hover:text-blue-600 hover:bg-[#e8f0fe]" aria-label="Open menu">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path></svg>
                </button>
                <h2 class="font-semibold text-lg">{title}</h2>
            </div>
           
            <div class="flex items-center gap-4">

                <div class="flex items-center gap-2.5">
                    {user && authorProfile.avatarUrl ? (
                        <img 
                            src={authorProfile.avatarUrl} 
                            alt={authorProfile.name} 
                            class="w-9 h-9 rounded-full object-cover shadow-sm shrink-0 border border-slate-100" 
                            title={user ? `${authorProfile.name} (${user?.role === 'admin' ? '👑 Admin' : '👤 User'})` : 'Guest'}
                        />
                    ) : (
                        <div 
                            class="w-9 h-9 bg-[#1a73e8] rounded-full text-white flex items-center justify-center font-bold text-sm shadow-sm shrink-0"
                            title={user ? `${user?.email} (${user?.role === 'admin' ? '👑 Admin' : '👤 User'})` : 'Guest'}
                        >
                            {user?.email?.charAt(0).toUpperCase() ?? 'U'}
                        </div>
                    )}
                </div>
            </div>
        </header>
        
        <main class="flex-1 overflow-auto p-4 lg:p-8 pb-20 md:pb-4 lg:pb-8">
            <slot />
        </main>
    </div>

    <script is:inline>
        (function() {
            const sidebar = document.getElementById('mainSidebar');
            const toggleBtn = document.getElementById('sidebarToggleBtn');
            const sidebarIcon = document.getElementById('sidebarIcon');

            if (sidebar && toggleBtn) {
                const savedState = localStorage.getItem('sidebarCollapsed');
                const isCollapsed = savedState === 'true';
                
                function updateSidebarState(collapsed) {
                    if (collapsed) {
                        sidebar.classList.add('collapsed');
                        if(sidebarIcon) sidebarIcon.setAttribute('d', 'M13 5l7 7-7 7M5 5l7 7-7 7');
                    } else {
                        sidebar.classList.remove('collapsed');
                        if(sidebarIcon) sidebarIcon.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
                    }
                    localStorage.setItem('sidebarCollapsed', collapsed ? 'true' : 'false');
                }

                updateSidebarState(isCollapsed);
                toggleBtn.addEventListener('click', function() {
                    const currentlyCollapsed = sidebar.classList.contains('collapsed');
                    updateSidebarState(!currentlyCollapsed);
                });
            }
        })();

        // Mobile menu script
        (function() {
            const mobileSidebarContainer = document.getElementById('mobileSidebarContainer');
            const mobileSidebar = document.getElementById('mobileSidebar');
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const closeMobileMenuBtn = document.getElementById('closeMobileMenuBtn');
            const mobileSidebarOverlay = document.getElementById('mobileSidebarOverlay');

            if (!mobileSidebarContainer || !mobileSidebar || !mobileMenuBtn || !closeMobileMenuBtn || !mobileSidebarOverlay) {
                return;
            }

            const openMenu = () => {
                mobileSidebarContainer.classList.remove('hidden');
                requestAnimationFrame(() => {
                    mobileSidebar.classList.remove('-translate-x-full');
                });
            };

            const closeMenu = () => {
                mobileSidebar.classList.add('-translate-x-full');
                const onTransitionEnd = () => {
                    mobileSidebarContainer.classList.add('hidden');
                    mobileSidebar.removeEventListener('transitionend', onTransitionEnd);
                };
                mobileSidebar.addEventListener('transitionend', onTransitionEnd);
            };

            mobileMenuBtn.addEventListener('click', openMenu);
            closeMobileMenuBtn.addEventListener('click', closeMenu);
            mobileSidebarOverlay.addEventListener('click', closeMenu);
        })();
    </script>
</body>
</html>