</style>

<script is:inline>
    // 1. Toast Notification Logic
    window.showToast = function (message, type = "success") {
        const container = document.getElementById("toast-container");
        if (!container) return;

        const toast = document.createElement("div");
        const bgColor = type === "success" ? "bg-[#059669]" : "bg-[#dc2626]";
        const icon =
            type === "success"
                ? `<svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>`
                : `<svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`;

        toast.className = `flex items-center gap-3 px-4 py-3 rounded-lg text-white shadow-lg transform transition-all duration-300 translate-y-4 opacity-0 ${bgColor}`;
        toast.innerHTML = `
            ${icon}
            <span class="font-medium text-sm">${message}</span>
        `;

        container.appendChild(toast);

        // Animate in
        requestAnimationFrame(() => {
            toast.classList.remove("translate-y-4", "opacity-0");
            toast.classList.add("translate-y-0", "opacity-100");
        });

        // Remove after 3 seconds
        setTimeout(() => {
            toast.classList.remove("translate-y-0", "opacity-100");
            toast.classList.add("translate-y-4", "opacity-0");
            setTimeout(() => {
                if (container.contains(toast)) {
                    container.removeChild(toast);
                }
            }, 300);
        }, 3000);
    };

    // 1b. Custom Confirm Modal (Promise-based, replaces native browser confirm())
    function showConfirm(
        title,
        message,
        btnText = "Confirm",
        confirmColor = "bg-rose-600 hover:bg-rose-700",
    ) {
        return new Promise((resolve) => {
            const overlay = document.getElementById("customConfirmOverlay");
            const titleEl = document.getElementById("customConfirmTitle");
            const msgEl = document.getElementById("customConfirmMsg");
            const btnOk = document.getElementById("customConfirmOk");
            const btnCancel = document.getElementById("customConfirmCancel");

            titleEl.textContent = title;
            msgEl.textContent = message;

            btnOk.className = `px-5 py-2.5 text-sm font-semibold text-white rounded-lg transition-colors shadow-sm ${confirmColor}`;
            btnOk.textContent = btnText;

            overlay.classList.remove("hidden");
            overlay.classList.add("flex");
            void overlay.offsetWidth;
            overlay.classList.remove("opacity-0");
            overlay.firstElementChild.classList.remove("scale-95");

            const cleanup = (result) => {
                overlay.classList.add("opacity-0");
                overlay.firstElementChild.classList.add("scale-95");
                setTimeout(() => {
                    overlay.classList.add("hidden");
                    overlay.classList.remove("flex");
                }, 300);
                btnOk.removeEventListener("click", onOk);
                btnCancel.removeEventListener("click", onCancel);
                resolve(result);
            };

            const onOk = () => cleanup(true);
            const onCancel = () => cleanup(false);

            btnOk.addEventListener("click", onOk);
            btnCancel.addEventListener("click", onCancel);
        });
    }

    // 2. Real-time Search Functionality
    const searchInput = document.getElementById("searchInput");
    const rows = document.querySelectorAll(".post-row");
    const noResultsState = document.getElementById("noResultsState");
    const tableBody = document.getElementById("postsTableBody");

    if (searchInput) {
        searchInput.addEventListener("input", (e) => {
            const term = e.target.value.toLowerCase();
            let hasVisibleRows = false;

            rows.forEach((row) => {
                const name = row.getAttribute("data-name") || "";
                const slug = row.getAttribute("data-slug") || "";

                if (name.includes(term) || slug.includes(term)) {
                    row.style.display = "";
                    hasVisibleRows = true;
                } else {
                    row.style.display = "none";
                }
            });

            if (!hasVisibleRows && term !== "") {
                tableBody.style.display = "none";
                noResultsState.classList.remove("hidden");
                noResultsState.classList.add("flex");
            } else {
                tableBody.style.display = "";
                noResultsState.classList.add("hidden");
                noResultsState.classList.remove("flex");
            }
        });
    }

    // 3. Bulk Sync SEO (Google Search Console) Status
    const STATUS_STYLES = {
        indexed: {
            bg: "bg-[#d1fae5]",
            text: "text-[#059669]",
            border: "border-[#a7f3d0]",
            label: "Indexed"
        },
        pending: {
            bg: "bg-[#fef3c7]",
            text: "text-[#d97706]",
            border: "border-[#fde68a]",
            label: "Pending"
        },
        crawled: {
            bg: "bg-[#ffedd5]",
            text: "text-[#ea580c]",
            border: "border-[#fed7aa]",
            label: "Crawled"
        },
        error: {
            bg: "bg-[#fee2e2]",
            text: "text-[#dc2626]",
            border: "border-[#fecaca]",
            label: "Error"
        },
        unknown: {
            bg: "bg-[#f1f5f9]",
            text: "text-[#64748b]",
            border: "border-[#e2e8f0]",
            label: "Unknown"
        }
    };

    window.hydrateGscBadges = function () {
        const cacheData = localStorage.getItem("seo_cache_data");
        let urlsCache = {};
        if (cacheData) {
            try {
                const parsed = JSON.parse(cacheData);
                urlsCache = parsed.urls || {};
            } catch (e) {}
        }

        // Hydrate mobile badges
        document.querySelectorAll(".gsc-mobile-badge").forEach((el) => {
            const url = el.getAttribute("data-url");
            const info = urlsCache[url];
            const status = info?.status || "unknown";
            const styles = STATUS_STYLES[status] || STATUS_STYLES.unknown;

            // Update classes
            el.className = `seo-badge mobile-menu-item w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium border-b border-[#f1f5f9] hover:bg-[#f8fafc] transition-colors cursor-pointer ${styles.text}`;
            // Update text
            const textEl = el.querySelector(".gsc-mobile-text");
            if (textEl) {
                textEl.textContent = `GSC SEO: ${styles.label}`;
            }
        });

        // Hydrate desktop badges
        document.querySelectorAll(".gsc-desktop-badge").forEach((el) => {
            const url = el.getAttribute("data-url");
            const info = urlsCache[url];
            const status = info?.status || "unknown";
            const styles = STATUS_STYLES[status] || STATUS_STYLES.unknown;

            // Update classes
            el.className = `seo-badge inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium border cursor-pointer transition-all hover:opacity-80 active:scale-95 ${styles.bg} ${styles.text} ${styles.border} gsc-desktop-badge`;
            // Update text
            const textEl = el.querySelector(".gsc-desktop-text");
            if (textEl) {
                textEl.textContent = styles.label;
            }
        });
    };

    // Hydrate GSC badges immediately on load
    window.hydrateGscBadges();

    const bulkRefreshBtn = document.getElementById("bulkRefreshSeoBtn");
    if (bulkRefreshBtn) {
        bulkRefreshBtn.addEventListener("click", async () => {
            const originalContent = bulkRefreshBtn.innerHTML;
            bulkRefreshBtn.disabled = true;

            try {
                // Get all slugs from rows
                const rows = document.querySelectorAll(".post-row");
                const slugs = Array.from(rows)
                    .map((row) => row.getAttribute("data-slug"))
                    .filter(Boolean);

                if (slugs.length === 0) {
                    showToast("No posts found to sync.", "error");
                    bulkRefreshBtn.disabled = false;
                    return;
                }

                const CHUNK_SIZE = 10;
                let successCount = 0;
                let failedCount = 0;

                for (let i = 0; i < slugs.length; i += CHUNK_SIZE) {
                    const chunk = slugs.slice(i, i + CHUNK_SIZE);
                    const progressText = `Syncing (${Math.min(i + chunk.length, slugs.length)}/${slugs.length})...`;
                    bulkRefreshBtn.innerHTML = `<svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-[#475569]" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> ${progressText}`;

                    const response = await fetch("/api/google/bulk-refresh", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ slugs: chunk }),
                    });
                    const data = await response.json();

                    if (response.ok && data.success) {
                        successCount += (data.results || []).length;
                        // Update localStorage incrementally
                        const cacheData = localStorage.getItem("seo_cache_data");
                        let cache = { lastSync: null, urls: {} };
                        if (cacheData) {
                            try {
                                cache = JSON.parse(cacheData) || cache;
                            } catch (e) {}
                        }
                        cache.lastSync = new Date().toISOString();
                        if (data.results && Array.isArray(data.results)) {
                            data.results.forEach((r) => {
                                if (r.url) {
                                    cache.urls[r.url] = r;
                                }
                            });
                        }
                        localStorage.setItem("seo_cache_data", JSON.stringify(cache));

                        // Instantly hydrate UI badges
                        window.hydrateGscBadges();
                    } else {
                        failedCount += chunk.length;
                        console.error("GSC Sync chunk failed:", data.error || "Unknown error");
                    }
                }

                if (successCount > 0) {
                    showToast(
                        `Successfully synced SEO status for ${successCount} posts${failedCount > 0 ? `, ${failedCount} failed` : ""}.`,
                        "success",
                    );
                    setTimeout(() => {
                        window.location.reload();
                    }, 1500);
                } else {
                    throw new Error("All batches failed to sync. Please try again.");
                }

            } catch (err) {
                console.error("Bulk refresh error:", err);
                showToast(
                    err.message || "Network error while syncing SEO status.",
                    "error",
                );
                bulkRefreshBtn.innerHTML = originalContent;
                bulkRefreshBtn.disabled = false;
            }
        });
    }

    // 3.5. Manual IndexNow Submit (with per-URL 60s cooldown)
    const INDEXNOW_COOLDOWN_MS = 60_000; // 60 seconds between submissions per URL
    const INDEXNOW_COOLDOWN_PREFIX = "indexNowSubmit_";

    window.submitToIndexNow = async function (event, postUrl) {
        if (event) {
            event.preventDefault();
            event.stopPropagation();
        }

        // ── Per-URL cooldown check ──
        const cooldownKey = INDEXNOW_COOLDOWN_PREFIX + postUrl;
        const lastSubmitTs = parseInt(
            localStorage.getItem(cooldownKey) || "0",
            10,
        );
        const elapsed = Date.now() - lastSubmitTs;
        if (elapsed < INDEXNOW_COOLDOWN_MS) {
            const waitSec = Math.ceil((INDEXNOW_COOLDOWN_MS - elapsed) / 1000);
            showToast(
                `⏳ Please wait ${waitSec}s before re-submitting this URL (rate-limit protection).`,
                "warning",
            );
            return;
        }

        const btn = event.currentTarget;
        const originalContent = btn.innerHTML;

        btn.disabled = true;
        btn.innerHTML = `<svg class="animate-spin w-3 h-3 text-indigo-600" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Sending...`;

        try {
            const response = await fetch("/api/google/indexnow", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({ url: postUrl }),
            });
            const data = await response.json();

            if (response.ok && data.success) {
                // Record successful submission timestamp for cooldown
                localStorage.setItem(cooldownKey, String(Date.now()));
                showToast(
                    data.message || "URL successfully submitted to IndexNow!",
                    "success",
                );
                btn.innerHTML = `<svg class="w-3 h-3 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Sent`;
                btn.className = btn.className.replace(
                    "text-slate-700",
                    "text-emerald-700 bg-emerald-50 border-emerald-200",
                );
            } else {
                throw new Error(data.error || "Failed to submit URL");
            }
        } catch (err) {
            console.error("IndexNow submit error:", err);
            showToast(err.message || "Error submitting to IndexNow.", "error");
            btn.innerHTML = originalContent;
            btn.disabled = false;
        }
    };

    // 4. Delete Connection to API
    window.confirmDelete = async function (event, path, sha) {
        // Capture the button reference up-front (same safe pattern as the
        // dashboard's confirmDeleteArticle) so it never depends on the
        // event object surviving past an async boundary.
        const btn = event.currentTarget;

        const confirmed = await showConfirm(
            "Delete Article",
            `Are you sure you want to delete "${path}"? This action cannot be undone.`,
            "Delete",
            "bg-rose-600 hover:bg-rose-700",
        );
        if (!confirmed) return;

        const originalContent = btn.innerHTML;
        btn.innerHTML = `<svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Deleting...`;
        btn.disabled = true;

        try {
            const response = await fetch("/api/delete-post", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ path, sha }),
            });

            const data = await response.json();

            if (response.ok && data.success) {
                showToast("Article deleted successfully!", "success");
                // 1.5 सेकंड का डिले ताकि यूजर Toast देख सके
                setTimeout(() => {
                    window.location.reload();
                }, 1500);
            } else {
                showToast(
                    "Error: " + (data.error || "Failed to delete"),
                    "error",
                );
                btn.innerHTML = originalContent;
                btn.disabled = false;
            }
        } catch (error) {
            console.error("Fetch error:", error);
            showToast("Network error while deleting.", "error");
            btn.innerHTML = originalContent;
            btn.disabled = false;
        }
    };

    // 4. Publish Date + Real View Count (Cloudflare Analytics)
    function formatPublishDate(iso) {
        if (!iso) return "Date unavailable";
        const d = new Date(iso);
        if (isNaN(d.getTime())) return "Date unavailable";
        return d.toLocaleDateString("en-IN", {
            day: "numeric",
            month: "short",
            year: "numeric",
        });
    }

    function formatViews(n) {
        if (n === null || n === undefined) return null; // analytics not configured yet
        if (n >= 1000)
            return (n / 1000).toFixed(1).replace(/\.0$/, "") + "K views";
        return `${n} view${n === 1 ? "" : "s"}`;
    }

    (async function hydratePostsMeta() {
        const postRows = document.querySelectorAll(".post-row");
        if (postRows.length === 0) return;

        try {
            const res = await fetch("/api/post-views");
            if (!res.ok) throw new Error("post-views fetch failed");
            const data = await res.json();
            if (!data || !Array.isArray(data.posts)) return;

            const byPath = new Map(data.posts.map((p) => [p.path, p]));

            postRows.forEach((row) => {
                const path = row.getAttribute("data-path");
                const info = path ? byPath.get(path) : null;
                const dateEls = row.querySelectorAll(".post-meta-date-text");
                const viewsEls = row.querySelectorAll(".post-meta-views-text");

                dateEls.forEach((el) => {
                    el.textContent = info
                        ? formatPublishDate(info.publishedAt)
                        : "Date unavailable";
                });
                viewsEls.forEach((el) => {
                    const viewsLabel = info ? formatViews(info.views) : null;
                    el.textContent = viewsLabel === null ? "" : viewsLabel;
                });
            });
        } catch (err) {
            console.error("hydratePostsMeta error:", err);
            document.querySelectorAll(".post-meta-date-text").forEach((el) => {
                el.textContent = "Date unavailable";
            });
            document.querySelectorAll(".post-meta-views-text").forEach((el) => {
                el.textContent = "";
            });
        }
    })();
    // ── Mobile Hamburger Menu Logic ──
    window.toggleMobileMenu = function (event, btn) {
        event.stopPropagation();
        const dropdown = btn.nextElementSibling;
        const isOpen = !dropdown.classList.contains("hidden");

        // Close all other open dropdowns first
        document
            .querySelectorAll(".mobile-actions-dropdown")
            .forEach(function (d) {
                d.classList.add("hidden");
            });

        if (!isOpen) {
            dropdown.classList.remove("hidden");
        }
    };

    window.closeMobileMenuAndRun = function (event, fn) {
        event.stopPropagation();
        // Close all dropdowns
        document
            .querySelectorAll(".mobile-actions-dropdown")
            .forEach(function (d) {
                d.classList.add("hidden");
            });
        // Execute the intended function
        fn();
    };

    // Close dropdown when clicking outside
    document.addEventListener("click", function (e) {
        if (!e.target.closest(".mobile-actions-menu")) {
            document
                .querySelectorAll(".mobile-actions-dropdown")
                .forEach(function (d) {
                    d.classList.add("hidden");
                });
        }
    });

    // ── Git Sync Button ─────────────────────────────────────────────────────
    // Strategy:
    //   1. POST /api/post-sync → clears catalogKey KV, re-fetches from GitHub
    //   2. API returns sorted posts (publishedAt desc, same as server sort)
    //   3. Before reload: seo_cache_data is explicitly re-written to localStorage
    //      so existing GSC status badges survive the page reload.
    //      New posts won't have entries in seo_cache_data → correctly show "Unknown".
    (function () {
        const btn = document.getElementById("gitSyncBtn");
        const icon = document.getElementById("gitSyncIcon");
        const label = document.getElementById("gitSyncLabel");
        if (!btn) return;

        btn.addEventListener("click", async function () {
            btn.disabled = true;
            btn.classList.add("opacity-70", "cursor-not-allowed");
            icon.style.animation = "spin 1s linear infinite";
            label.textContent = "Syncing…";

            try {
                const res = await fetch("/api/post-sync", { method: "POST" });
                const data = await res.json();

                if (data.ok) {
                    icon.style.animation = "";
                    btn.classList.remove("opacity-70", "cursor-not-allowed");
                    btn.disabled = false;
                    label.textContent = `${data.synced} posts synced`;

                    // ── GSC cache preserve ──────────────────────────────────
                    // Re-write seo_cache_data so it survives the reload.
                    // We do NOT clear it — old posts keep their GSC status.
                    // New posts (not yet in cache) will correctly show "Unknown".
                    try {
                        const existing = localStorage.getItem("seo_cache_data");
                        if (existing) {
                            localStorage.setItem("seo_cache_data", existing);
                        }
                    } catch (e) { /* ignore storage errors */ }

                    // Show success toast with new post count
                    const newCount = (data.synced - (data.previousCount || 0));
                    const msg = newCount > 0
                        ? `${newCount} new post${newCount > 1 ? "s" : ""} found — ${data.synced} total`
                        : `Sync complete — ${data.synced} posts (no new posts)`;
                    showGitSyncToast(msg, "success");

                    // Reload after 1.8s — server will sort by publishedAt (latest first)
                    setTimeout(() => { window.location.reload(); }, 1800);
                } else {
                    throw new Error(data.message || "Sync failed");
                }
            } catch (err) {
                icon.style.animation = "";
                label.textContent = "Git Sync";
                btn.classList.remove("opacity-70", "cursor-not-allowed");
                btn.disabled = false;
                showGitSyncToast(err.message || "Git Sync failed", "error");
            }
        });

        function showGitSyncToast(msg, type) {
            const existing = document.getElementById("gitSyncToast");
            if (existing) existing.remove();

            const isSuccess = type === "success";

            // SVG icons
            const successSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
            const errorSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>`;

            const toast = document.createElement("div");
            toast.id = "gitSyncToast";
            toast.innerHTML = `${isSuccess ? successSvg : errorSvg}<span>${msg}</span>`;
            toast.style.cssText = [
                "position:fixed",
                "bottom:1.5rem",
                "right:1.5rem",
                "z-index:9999",
                "display:flex",
                "align-items:center",
                "gap:0.5rem",
                "padding:0.75rem 1.25rem",
                "border-radius:0.75rem",
                "font-size:0.875rem",
                "font-weight:600",
                "box-shadow:0 4px 20px rgba(0,0,0,0.18)",
                "transition:opacity 0.4s",
                isSuccess
                    ? "background:#ecfdf5;color:#065f46;border:1px solid #6ee7b7"
                    : "background:#fef2f2;color:#991b1b;border:1px solid #fca5a5",
            ].join(";");

            document.body.appendChild(toast);
            setTimeout(() => { toast.style.opacity = "0"; }, 4000);
            setTimeout(() => { toast.remove(); }, 4500);
        }
    })();

    // Spin keyframe for Git Sync icon
    (function () {
        if (!document.getElementById("gitSyncSpinStyle")) {
            const s = document.createElement("style");
            s.id = "gitSyncSpinStyle";
            s.textContent = "@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }";
            document.head.appendChild(s);
        }
    })();
</script>
