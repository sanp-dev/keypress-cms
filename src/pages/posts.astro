---
// src/pages/posts.astro
import DashboardLayout from "../layouts/DashboardLayout.astro";
import { sitesConfig, getActiveSite } from "../config/sitesConfig";
import { getPostsCatalog } from "../lib/github";
import { env } from "cloudflare:workers";
import { getAllCachedSeoMetadata } from "../lib/seo";
import SeoInspectionModal from "../components/SeoInspectionModal.astro";

const activeSite = getActiveSite();
const token = env?.GITHUB_PAT || import.meta.env.GITHUB_PAT;
const { posts } = await getPostsCatalog(
    activeSite.githubOwner,
    activeSite.githubRepo,
    activeSite.contentPath,
    token,
    activeSite.branch,
    env?.CACHE_KV,
);

// Sort posts by publish date (most recent first)
posts.sort((a: any, b: any) => {
    const timeA = a.publishedAt ? new Date(a.publishedAt).getTime() : 0;
    const timeB = b.publishedAt ? new Date(b.publishedAt).getTime() : 0;
    if (timeA === timeB) {
        return (b.slug || "").localeCompare(a.slug || "");
    }
    return timeB - timeA;
});

function formatPublishDateServer(iso: string | null) {
    if (!iso) return "···";
    const d = new Date(iso);
    if (isNaN(d.getTime())) return "Date unavailable";
    return d.toLocaleDateString("en-IN", {
        day: "numeric",
        month: "short",
        year: "numeric",
    });
}

const bingIndexNowKey = env?.BING_INDEXNOW_KEY || "";
---

<DashboardLayout title="All Posts">
    <div
        class="bg-white rounded-xl shadow-sm border border-[#e2e8f0] overflow-hidden flex flex-col sm:h-[calc(100vh-8rem)]"
    >
        <div
            class="p-4 sm:p-5 border-b border-[#e2e8f0] bg-[#f8fafc] flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 sm:gap-4 sm:shrink-0"
        >
            <div>
                <h2 class="text-lg font-bold text-[#1e293b]">
                    Published Articles
                </h2>
                <p class="text-sm text-[#64748b] mt-1">
                    Manage {posts.length} markdown files directly from GitHub.
                </p>
            </div>

            <div
                class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto"
            >
                <div class="relative w-full sm:w-64">
                    <div
                        class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
                    >
                        <svg
                            class="w-4 h-4 text-gray-400"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                            ></path></svg
                        >
                    </div>
                    <input
                        type="text"
                        id="searchInput"
                        class="block w-full pl-10 pr-3 py-2 border border-[#e2e8f0] rounded-lg leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:border-[#1a73e8] focus:ring-1 focus:ring-[#1a73e8] sm:text-sm transition-colors"
                        placeholder="Search file or slug..."
                    />
                </div>

                <button
                    id="bulkRefreshSeoBtn"
                    class="bg-white border border-[#e2e8f0] text-[#475569] hover:bg-slate-50 px-4 py-2 rounded-lg text-sm font-semibold shadow-sm transition-all flex items-center justify-center gap-2 w-full sm:w-auto whitespace-nowrap cursor-pointer"
                >
                    <svg
                        id="bulkRefreshIcon"
                        class="w-4 h-4 shrink-0"
                        viewBox="0 0 157.7 157.7"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            fill="#fbbc04"
                            d="M33.2,132.6l-23.7,23.7c-1.8,1.8-4.8,1.8-6.6,0l-1.5-1.5c-1.8-1.8-1.8-4.8,0-6.6l23.7-23.7c1.8-1.8,4.8-1.8,6.6,0l1.5,1.5c1.8,1.8,1.8,4.8,0,6.6h0Z"
                        ></path>
                        <path
                            fill="#4285f4"
                            d="M96.9,142.5h30.4c16.8,0,30.4-13.6,30.4-30.4V30.4c0-16.8-13.6-30.4-30.4-30.4h0c-16.8,0-30.4,13.6-30.4,30.4v112.1h0Z"
                        ></path>
                        <path
                            fill="#fbbc04"
                            d="M46.6,142.5c16.8,0,30.4-13.6,30.4-30.4h0c0-16.8-13.6-30.4-30.4-30.4h0c-16.8,0-30.4,13.6-30.4,30.4h0c0,16.8,13.6,30.4,30.4,30.4h0Z"
                        ></path>
                        <path
                            fill="#34a853"
                            d="M118.1,142.5h-29.6c-16.8,0-30.4-13.6-30.4-30.4v-39.8c0-16.8,13.6-30.4,30.4-30.4h0c16.8,0,30.4,13.6,30.4,30.4v69.4c0,.4-.3.8-.8.8h0Z"
                        ></path>
                        <path
                            fill="#1967d2"
                            d="M118.9,141.7v-69.4c0-13.5-9-25.5-22-29.2v99.4h21.2c.4,0,.8-.3.8-.8h0Z"
                        ></path>
                        <path
                            fill="#ea4335"
                            d="M77,112.7c0-12.3-7.4-23.4-18.9-28.1v28.1c0,8.7,3.6,16.5,9.4,22,6-5.7,9.4-13.7,9.4-22Z"
                        ></path>
                    </svg>
                    <span>Sync GSC</span>
                </button>

                <!-- Git Sync Button —— syncs locally-pushed .md posts into dashboard -->
                <button
                    id="gitSyncBtn"
                    class="bg-white border border-[#e2e8f0] text-[#475569] hover:bg-emerald-50 hover:border-emerald-300 hover:text-emerald-700 px-4 py-2 rounded-lg text-sm font-semibold shadow-sm transition-all flex items-center justify-center gap-2 w-full sm:w-auto whitespace-nowrap cursor-pointer"
                    title="Sync posts pushed directly via Git (clears cache and re-fetches from GitHub)"
                >
                    <svg id="gitSyncIcon" class="w-4 h-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M18.13 17.13c-.15.18-.31.36-.48.52-.73.74-1.59 1.31-2.54 1.71-1.97.83-4.26.83-6.23 0-.95-.4-1.81-.98-2.54-1.72a7.8 7.8 0 0 1-1.71-2.54c-.42-.99-.63-2.03-.63-3.11H2c0 1.35.26 2.66.79 3.89.5 1.19 1.23 2.26 2.14 3.18s1.99 1.64 3.18 2.14c1.23.52 2.54.79 3.89.79s2.66-.26 3.89-.79c1.19-.5 2.26-1.23 3.18-2.14.17-.17.32-.35.48-.52L22 20.99v-6h-6l2.13 2.13Zm.94-12.2a9.9 9.9 0 0 0-3.18-2.14 10.12 10.12 0 0 0-7.79 0c-1.19.5-2.26 1.23-3.18 2.14-.17.17-.32.35-.48.52L1.99 3v6h6L5.86 6.87c.15-.18.31-.36.48-.52.73-.74 1.59-1.31 2.54-1.71 1.97-.83 4.26-.83 6.23 0 .95.4 1.81.98 2.54 1.72.74.73 1.31 1.59 1.71 2.54.42.99.63 2.03.63 3.11h2c0-1.35-.26-2.66-.79-3.89-.5-1.19-1.23-2.26-2.14-3.18Z"></path>
                    </svg>
                    <span id="gitSyncLabel">Git Sync</span>
                </button>

                <a
                    href="/write"
                    class="bg-gradient-to-r from-[#1a73e8] to-[#1e40af] text-white px-4 py-2 rounded-lg text-sm font-semibold shadow-sm hover:opacity-90 transition-all flex items-center justify-center gap-2 w-full sm:w-auto whitespace-nowrap"
                >
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 4v16m8-8H4"></path></svg
                    >
                    Write New
                </a>
            </div>
        </div>

        <div class="overflow-auto flex-1 relative">
            <table class="posts-table w-full text-left border-collapse">
                <thead
                    class="sticky top-0 bg-white z-10 shadow-sm border-b border-[#e2e8f0]"
                >
                    <tr class="text-[#64748b] text-xs uppercase tracking-wider">
                        <th
                            class="pl-2.5 sm:pl-3 pr-4 sm:pr-6 py-3 sm:py-4 font-medium w-[45%]"
                            >File Name</th
                        >
                        <th
                            class="posts-col-published px-4 sm:px-6 py-3 sm:py-4 font-medium whitespace-nowrap min-w-[120px] w-[15%]"
                            >Published</th
                        >
                        <th
                            class="posts-col-status px-4 sm:px-6 py-3 sm:py-4 font-medium w-[10%]"
                            >Status</th
                        >
                        <th
                            class="posts-col-seo px-4 sm:px-6 py-3 sm:py-4 font-medium w-[10%]"
                            >SEO</th
                        >
                        <th
                            class="posts-col-indexnow px-4 sm:px-6 py-3 sm:py-4 font-medium w-[12%]"
                            >IndexNow</th
                        >
                        <th
                            class="posts-col-actions px-4 sm:px-6 py-3 sm:py-4 font-medium text-right w-[8%]"
                            >Actions</th
                        >
                    </tr>
                </thead>
                <tbody id="postsTableBody" class="divide-y divide-[#e2e8f0]">
                    {
                        posts.length === 0 ? (
                            <tr>
                                <td
                                    colspan="5"
                                    class="px-6 py-12 text-center text-[#64748b]"
                                >
                                    <div class="text-4xl mb-3">📄</div>
                                    <p class="font-medium text-base">
                                        No articles found in repository.
                                    </p>
                                    <p class="text-sm mt-1">
                                        Path checked:{" "}
                                        <code class="bg-gray-100 px-1 rounded">
                                            {activeSite.contentPath}
                                        </code>
                                    </p>
                                </td>
                            </tr>
                        ) : (
                            posts.map((post, i) => (
                                <tr
                                    class="hover:bg-[#f8fafc] transition-colors group post-row"
                                    data-name={post.name.toLowerCase()}
                                    data-slug={post.slug.toLowerCase()}
                                    data-path={post.path}
                                >
                                    <td class="pl-2.5 sm:pl-3 pr-4 sm:pr-6 py-3 sm:py-4">
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs font-bold text-[#94a3b8] w-6 shrink-0 text-center">
                                                {i + 1}
                                            </span>
                                            <div class="min-w-0 flex-1">
                                                <p class="text-xs text-[#64748b] font-mono break-all leading-relaxed">
                                                    <span class="mr-1.5">
                                                        {post.slug}
                                                    </span>
                                                    <a
                                                        href={`${activeSite.url}/post/${post.slug}/`}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="inline-block align-middle text-[#94a3b8] hover:text-[#1a73e8] transition-colors"
                                                        title="View Live Post"
                                                    >
                                                        <svg
                                                            class="w-3.5 h-3.5"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            viewBox="0 0 24 24"
                                                        >
                                                            <path
                                                                stroke-linecap="round"
                                                                stroke-linejoin="round"
                                                                stroke-width="2"
                                                                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                                            />
                                                        </svg>
                                                    </a>
                                                </p>
                                                {/* Mobile-only: inline meta */}
                                                <div class="posts-mobile-meta hidden mt-2.5 flex">
                                                    {/* Row: Date, Views और Hamburger Menu */}
                                                    <div class="flex items-center gap-2 text-xs text-[#64748b] w-full">
                                                        <span class="inline-flex items-center gap-1.5 shrink-0">
                                                            <svg
                                                                class="w-3.5 h-3.5 text-[#94a3b8]"
                                                                fill="none"
                                                                stroke="currentColor"
                                                                viewBox="0 0 24 24"
                                                            >
                                                                <path
                                                                    stroke-linecap="round"
                                                                    stroke-linejoin="round"
                                                                    stroke-width="2"
                                                                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                                                />
                                                            </svg>
                                                            <span class="post-meta-date-text">
                                                                {formatPublishDateServer(
                                                                    post.publishedAt,
                                                                )}
                                                            </span>
                                                        </span>
                                                        <span class="text-[#cbd5e1]">•</span>
                                                        <span class="inline-flex items-center gap-1.5 shrink-0">
                                                            <svg
                                                                class="w-3.5 h-3.5 text-[#94a3b8]"
                                                                fill="none"
                                                                stroke="currentColor"
                                                                viewBox="0 0 24 24"
                                                            >
                                                                <path
                                                                    stroke-linecap="round"
                                                                    stroke-linejoin="round"
                                                                    stroke-width="2"
                                                                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                                                                />
                                                                <path
                                                                    stroke-linecap="round"
                                                                    stroke-linejoin="round"
                                                                    stroke-width="2"
                                                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                                                                />
                                                            </svg>
                                                            <span class="post-meta-views-text">···</span>
                                                        </span>

                                                        {/* Hamburger Menu — Live की जगह */}
                                                        <div class="mobile-actions-menu relative inline-block ml-auto">
                                                            <button
                                                                class="mobile-hamburger-btn flex items-center justify-center w-7 h-7 rounded-lg border border-[#e2e8f0] bg-white text-[#64748b] hover:bg-[#f1f5f9] hover:border-[#cbd5e1] transition-all active:scale-95 shadow-sm"
                                                                title="More actions"
                                                                aria-label="Post actions"
                                                                onclick="toggleMobileMenu(event, this)"
                                                            >
                                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                                                                </svg>
                                                            </button>

                                                            {/* Dropdown menu */}
                                                            <div class="mobile-actions-dropdown hidden absolute right-0 top-8 z-50 min-w-[210px] bg-white rounded-xl shadow-xl border border-[#e2e8f0] overflow-hidden">
                                                                {/* SEO Status */}
                                                                <button
                                                                    onclick={`closeMobileMenuAndRun(event, () => openSeoModal(event, '${activeSite.url}/post/${post.slug}/'))`}
                                                                    class="seo-badge mobile-menu-item w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium border-b border-[#f1f5f9] hover:bg-[#f8fafc] transition-colors cursor-pointer text-[#64748b] gsc-mobile-badge"
                                                                    data-url={`${activeSite.url}/post/${post.slug}/`}
                                                                >
                                                                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 157.7 157.7" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                        <path fill="#fbbc04" d="M33.2,132.6l-23.7,23.7c-1.8,1.8-4.8,1.8-6.6,0l-1.5-1.5c-1.8-1.8-1.8-4.8,0-6.6l23.7-23.7c1.8-1.8,4.8-1.8,6.6,0l1.5,1.5c1.8,1.8,1.8,4.8,0,6.6h0Z"/>
                                                                        <path fill="#4285f4" d="M96.9,142.5h30.4c16.8,0,30.4-13.6,30.4-30.4V30.4c0-16.8-13.6-30.4-30.4-30.4h0c-16.8,0-30.4,13.6-30.4,30.4v112.1h0Z"/>
                                                                        <path fill="#fbbc04" d="M46.6,142.5c16.8,0,30.4-13.6,30.4-30.4h0c0-16.8-13.6-30.4-30.4-30.4h0c-16.8,0-30.4,13.6-30.4,30.4h0c0,16.8,13.6,30.4,30.4,30.4h0Z"/>
                                                                        <path fill="#34a853" d="M118.1,142.5h-29.6c-16.8,0-30.4-13.6-30.4-30.4v-39.8c0-16.8,13.6-30.4,30.4-30.4h0c16.8,0,30.4,13.6,30.4,30.4v69.4c0,.4-.3.8-.8.8h0Z"/>
                                                                        <path fill="#1967d2" d="M118.9,141.7v-69.4c0-13.5-9-25.5-22-29.2v99.4h21.2c.4,0,.8-.3.8-.8h0Z"/>
                                                                        <path fill="#ea4335" d="M77,112.7c0-12.3-7.4-23.4-18.9-28.1v28.1c0,8.7,3.6,16.5,9.4,22,6-5.7,9.4-13.7,9.4-22Z"/>
                                                                    </svg>
                                                                    <span class="gsc-mobile-text">GSC SEO: Loading...</span>
                                                                </button>

                                                                {/* Bing Submit */}
                                                                <button
                                                                    onclick={`closeMobileMenuAndRun(event, () => submitToIndexNow(event, '${activeSite.url}/post/${post.slug}/'))`}
                                                                    class="indexnow-btn mobile-menu-item w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-[#475569] border-b border-[#f1f5f9] hover:bg-[#f8fafc] transition-colors cursor-pointer"
                                                                >
                                                                    <svg class="w-4 h-4 shrink-0 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                                                                    </svg>
                                                                    <span>Bing Submit</span>
                                                                </button>

                                                                {/* IndexNow Direct Link */}
                                                                <a
                                                                    href={`https://api.indexnow.org/indexnow?url=${encodeURIComponent(`${activeSite.url}/post/${post.slug}/`)}&key=${bingIndexNowKey}`}
                                                                    target="_blank"
                                                                    rel="noopener noreferrer"
                                                                    class="mobile-menu-item w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-[#2563eb] border-b border-[#f1f5f9] hover:bg-[#eff6ff] transition-colors"
                                                                    title="IndexNow Direct Link"
                                                                >
                                                                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                                                    </svg>
                                                                    <span>IndexNow Direct Link</span>
                                                                </a>

                                                                {/* Edit */}
                                                                <a
                                                                    href={`/edit?file=${post.name}`}
                                                                    class="mobile-menu-item w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-[#1a73e8] border-b border-[#f1f5f9] hover:bg-[#e8f0fe] transition-colors"
                                                                    title="Edit Article"
                                                                >
                                                                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                                    </svg>
                                                                    <span>Edit</span>
                                                                </a>

                                                                {/* Delete */}
                                                                <button
                                                                    onclick={`closeMobileMenuAndRun(event, () => confirmDelete(event, '${post.path}', '${post.sha}'))`}
                                                                    class="mobile-menu-item w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-[#dc2626] border-b border-[#f1f5f9] hover:bg-[#fff1f2] transition-colors cursor-pointer"
                                                                    title="Delete Article"
                                                                >
                                                                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                                    </svg>
                                                                    <span>Delete</span>
                                                                </button>

                                                                {/* Live Status — सबसे नीचे */}
                                                                <div class="mobile-menu-item w-full flex items-center gap-3 px-4 py-2.5">
                                                                    <span class="w-4 h-4 shrink-0 flex items-center justify-center">
                                                                        <span class="w-2 h-2 rounded-full bg-[#059669]"></span>
                                                                    </span>
                                                                    <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-medium bg-[#d1fae5] text-[#059669] border border-[#a7f3d0]">
                                                                        <span class="w-1.5 h-1.5 rounded-full bg-[#059669]"></span>
                                                                        Live
                                                                    </span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="posts-col-published px-4 sm:px-6 py-3 sm:py-4 whitespace-nowrap min-w-[120px]">
                                        <p class="post-meta-date-text text-xs text-[#475569]">
                                            {formatPublishDateServer(
                                                post.publishedAt,
                                            )}
                                        </p>
                                        <p class="post-meta-views-text text-xs text-[#64748b] mt-0.5">
                                            ···
                                        </p>
                                    </td>
                                    <td class="posts-col-status px-4 sm:px-6 py-3 sm:py-4">
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-[#d1fae5] text-[#059669] border border-[#a7f3d0]">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[#059669]" />
                                            Live
                                        </span>
                                    </td>
                                    <td class="posts-col-seo px-4 sm:px-6 py-3 sm:py-4">
                                        <button
                                            onclick={`openSeoModal(event, '${activeSite.url}/post/${post.slug}/')`}
