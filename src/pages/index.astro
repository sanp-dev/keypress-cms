<script is:inline>
  // ── SEO Indexing Details Modal Logic ──────────────────────────────────────────
  const postTitleMapEl = document.getElementById("seo-post-data");
  const postTitleMap = postTitleMapEl ? JSON.parse(postTitleMapEl.getAttribute("data-map") || "{}") : {};

  let activeSeoTab = "indexed";
  let indexedUrls = [];
  let pendingUrls = [];
  let errorUrls = [];
  let unknownUrls = [];

  // Function to load and hydrate GSC data from localStorage
  window.hydrateIndexGsc = function () {
    const cacheData = localStorage.getItem("seo_cache_data");
    let cache = { lastSync: null, urls: {} };
    if (cacheData) {
      try {
        cache = JSON.parse(cacheData) || cache;
      } catch (e) {}
    }

    // Clean up cache to remove non-canonical URLs without trailing slash
    let cacheModified = false;
    const cleanUrls = {};
    if (cache.urls) {
      for (const u in cache.urls) {
        if (u.endsWith('/')) {
          cleanUrls[u] = cache.urls[u];
        } else {
          cacheModified = true;
        }
      }
      cache.urls = cleanUrls;
      if (cacheModified) {
        try {
          localStorage.setItem("seo_cache_data", JSON.stringify(cache));
        } catch (e) {}
      }
    }

    indexedUrls = [];
    pendingUrls = [];
    errorUrls = [];
    unknownUrls = [];

    const urlsObj = cache.urls || {};
    for (const url in urlsObj) {
      if (!url.endsWith('/')) continue; // Skip non-canonical URLs without trailing slash
      const info = urlsObj[url];
      const status = info.status;
      const item = { url, info };
      if (status === 'indexed') {
        indexedUrls.push(item);
      } else if (status === 'pending' || status === 'crawled') {
        pendingUrls.push(item);
      } else if (status === 'error') {
        errorUrls.push(item);
      } else {
        unknownUrls.push(item);
      }
    }

    // Update Card Counts
    const updateCount = (id, count) => {
      const el = document.getElementById(id);
      if (el) el.textContent = count;
    };

    updateCount("summary-count-indexed", indexedUrls.length);
    updateCount("summary-count-pending", pendingUrls.length);
    updateCount("summary-count-error", errorUrls.length);
    updateCount("summary-count-unknown", unknownUrls.length);

    updateCount("modal-count-indexed", indexedUrls.length);
    updateCount("modal-count-pending", pendingUrls.length);
    updateCount("modal-count-error", errorUrls.length);
    updateCount("modal-count-unknown", unknownUrls.length);

    // Update Last Sync Footer
    const lastSyncEl = document.getElementById("summary-last-sync");
    if (lastSyncEl) {
      if (cache.lastSync) {
        const date = new Date(cache.lastSync);
        lastSyncEl.textContent = date.toLocaleTimeString("en-IN", {
          hour: "2-digit",
          minute: "2-digit",
        });
        const wrapper = document.getElementById("summary-last-sync-wrapper");
        if (wrapper) {
          wrapper.title = "Last Sync: " + date.toLocaleString("en-IN");
        }
      } else {
        lastSyncEl.textContent = "Never";
      }
    }

    // Re-render modal content if open
    const modal = document.getElementById("seoDetailsModal");
    if (modal && modal.classList.contains("flex")) {
      renderSeoUrls();
    }
  };

  // Run on page load
  document.addEventListener("DOMContentLoaded", () => {
    window.hydrateIndexGsc();
  });
  // Fallback direct run in case DOMContentLoaded already fired
  window.hydrateIndexGsc();

  // Add click listener for GSC Sync button
  document.addEventListener("DOMContentLoaded", () => {
    const syncBtn = document.getElementById("cardSyncGscBtn");
    if (syncBtn) {
      syncBtn.addEventListener("click", async (e) => {
        e.preventDefault();
        e.stopPropagation();

        const originalHtml = syncBtn.innerHTML;
        syncBtn.disabled = true;
        syncBtn.innerHTML = `<svg class="animate-spin h-3.5 w-3.5 text-[#1a73e8]" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`;

        try {
          const urls = Object.keys(postTitleMap);
          if (urls.length === 0) {
            if (window.showToast) {
              window.showToast("No posts found to sync.", "error");
            }
            syncBtn.disabled = false;
            syncBtn.innerHTML = originalHtml;
            return;
          }

          const CHUNK_SIZE = 10;
          let successCount = 0;
          let failedCount = 0;

          for (let i = 0; i < urls.length; i += CHUNK_SIZE) {
            const chunk = urls.slice(i, i + CHUNK_SIZE);
            
            const response = await fetch("/api/google/bulk-refresh", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ urls: chunk }),
            });
            const data = await response.json();

            if (response.ok && data.success) {
              successCount += (data.results || []).length;
              const cacheData = localStorage.getItem("seo_cache_data");
              let cache = { lastSync: null, urls: {} };
              if (cacheData) {
                try {
                  cache = JSON.parse(cacheData) || cache;
                } catch (e) {}
              }
              cache.lastSync = new Date().toISOString();
              if (data.results && Array.isArray(data.results)) {
                data.results.forEach((r) => {
                  if (r.url) {
                    cache.urls[r.url] = r;
                  }
                });
              }
              localStorage.setItem("seo_cache_data", JSON.stringify(cache));
              
              // Hydrate UI after each chunk
              window.hydrateIndexGsc();
            } else {
              failedCount += chunk.length;
              console.error("GSC Sync chunk failed:", data.error || "Unknown error");
            }
          }

          if (successCount > 0) {
            if (window.showToast) {
              window.showToast(`SEO statuses synced successfully! (${successCount} posts)`, "success");
            }
          } else {
            throw new Error("All batches failed to sync. Please try again.");
          }
        } catch (err) {
          console.error("GSC Sync Error:", err);
          if (window.showToast) {
            window.showToast(err.message || "Network error while syncing GSC.", "error");
          }
        } finally {
          syncBtn.innerHTML = originalHtml;
          syncBtn.disabled = false;
        }
      });
    }
  });

  window.openSeoDetailsModal = function (status) {
    const overlay = document.getElementById("seoDetailsModal");
    if (!overlay) return;

    overlay.classList.remove("hidden");
    overlay.classList.add("flex");
    void overlay.offsetWidth;
    overlay.classList.remove("opacity-0");
    overlay.firstElementChild.classList.remove("scale-95");

    switchSeoTab(status || "indexed");
  };

  window.closeSeoDetailsModal = function () {
    const overlay = document.getElementById("seoDetailsModal");
    if (!overlay) return;

    overlay.classList.add("opacity-0");
    overlay.firstElementChild.classList.add("scale-95");
    setTimeout(() => {
      overlay.classList.add("hidden");
      overlay.classList.remove("flex");
    }, 300);
  };

  window.switchSeoTab = function (status) {
    activeSeoTab = status;

    // Update active tab styles
    const tabs = ["indexed", "pending", "error", "unknown"];
    tabs.forEach((t) => {
      const el = document.getElementById(`tab-${t}`);
      if (el) {
        if (t === status) {
          el.classList.add("border-[#1a73e8]", "text-[#1a73e8]");
          el.classList.remove("border-transparent", "text-[#64748b]");
        } else {
          el.classList.remove("border-[#1a73e8]", "text-[#1a73e8]");
          el.classList.add("border-transparent", "text-[#64748b]");
        }
      }
    });

    renderSeoUrls();
  };

  window.copySeoUrl = function (btn, url) {
    navigator.clipboard.writeText(url).then(() => {
      const originalContent = btn.innerHTML;
      btn.innerHTML = `<svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>`;
      if (window.showToast) {
        window.showToast("URL copied to clipboard!", "success");
      }
      setTimeout(() => {
        btn.innerHTML = originalContent;
      }, 1500);
    }).catch(err => {
      console.error("Copy failed", err);
      if (window.showToast) {
        window.showToast("Failed to copy URL", "error");
      }
    });
  };

  function renderSeoUrls() {
    const container = document.getElementById("seoModalListContainer");
    if (!container) return;

    let items = [];
    if (activeSeoTab === "indexed") items = indexedUrls;
    else if (activeSeoTab === "pending") items = pendingUrls;
    else if (activeSeoTab === "error") items = errorUrls;
    else if (activeSeoTab === "unknown") items = unknownUrls;

    if (items.length === 0) {
      container.innerHTML = `
        <div class="flex flex-col items-center justify-center py-10 text-[#94a3b8]">
          <svg class="w-10 h-10 mb-3 text-[#cbd5e1]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <p class="text-sm font-medium">No URLs found in this category.</p>
        </div>
      `;
      return;
    }

    // Render list
    container.innerHTML = `
      <div class="space-y-3">
        ${items.map((item) => {
          const url = typeof item === "string" ? item : (item.url || "");
          const info = (typeof item === "object" && item) ? item.info : null;
          const title = postTitleMap[url] || "";

          // Exact GSC error or coverage status
          let coverageText = info?.coverage || info?.error || "";
          if (!coverageText && activeSeoTab === "error") {
            coverageText = "Google Search Console reported an indexing error";
          }

          // Format fetch status text cleanly
          let fetchStatusText = info?.pageFetchStatus || "";
          if (fetchStatusText.includes("UNSPECIFIED") || fetchStatusText.includes("Unspecified")) {
            fetchStatusText = "Not attempted yet";
          } else if (fetchStatusText === "SUCCESSFUL") {
            fetchStatusText = "Successful";
          }

          let badgeColorClass = "";
          let iconSvg = "";

          if (activeSeoTab === "error") {
            badgeColorClass = "bg-rose-50 text-rose-700 border-rose-200/80";
            iconSvg = `<svg class="w-3.5 h-3.5 text-rose-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>`;
          } else if (activeSeoTab === "pending") {
            badgeColorClass = "bg-amber-50 text-amber-700 border-amber-200/80";
            iconSvg = `<svg class="w-3.5 h-3.5 text-amber-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`;
          } else if (activeSeoTab === "indexed") {
            badgeColorClass = "bg-emerald-50 text-emerald-700 border-emerald-200/80";
            iconSvg = `<svg class="w-3.5 h-3.5 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>`;
          } else {
            badgeColorClass = "bg-slate-100 text-slate-700 border-slate-200";
            iconSvg = `<svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`;
          }

          return `
            <div class="p-3 sm:p-3.5 rounded-xl border border-slate-100 bg-slate-50 hover:bg-slate-100/60 transition-colors flex items-center justify-between gap-3 sm:gap-4">
              <div class="min-w-0 flex-1">
                ${title ? `<p class="text-xs font-bold text-slate-800 truncate">${title}</p>` : ""}
                <p class="text-[10px] sm:text-[11px] text-slate-500 font-mono truncate mt-0.5" title="${url}">${url}</p>
                ${coverageText ? `
                  <div class="mt-1.5 sm:mt-2 flex items-center gap-1.5 sm:gap-2 flex-wrap max-w-full overflow-hidden">
                    <span class="inline-flex items-center gap-1 sm:gap-1.5 text-[10px] sm:text-[11px] font-semibold px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-md border ${badgeColorClass} whitespace-nowrap max-w-full overflow-hidden">
                      ${iconSvg}
                      <span class="truncate max-w-[200px] sm:max-w-none">${coverageText}</span>
                    </span>
                    ${fetchStatusText && fetchStatusText !== 'Successful' && fetchStatusText !== 'Unknown' ? `
                      <span class="inline-flex items-center gap-1 text-[9px] sm:text-[10px] font-medium px-1.5 py-0.5 sm:px-2 rounded bg-slate-200/70 text-slate-700 border border-slate-300/60 whitespace-nowrap">
                        Fetch: ${fetchStatusText}
                      </span>
                    ` : ""}
                  </div>
                ` : ""}
              </div>
              <div class="flex items-center gap-1.5 shrink-0">
                <button
                  onclick="openSeoModal(event, '${url}')"
                  class="w-7 h-7 flex items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-500 hover:text-[#1a73e8] hover:bg-blue-50 active:scale-95 transition-all cursor-pointer"
                  title="View full GSC inspection details"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                </button>
                <button
                  onclick="copySeoUrl(this, '${url}')"
                  class="w-7 h-7 flex items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-500 hover:text-slate-700 hover:bg-slate-50 active:scale-95 transition-all cursor-pointer"
                  title="Copy URL"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                  </svg>
                </button>
                <a
                  href="${url}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-7 h-7 flex items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-500 hover:text-[#1a73e8] hover:bg-blue-50 active:scale-95 transition-all"
                  title="Open live URL"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            </div>
          `;
        }).join("")}
      </div>
    `;
  }

  // ── Modern Confirm Modal ──────────────────────────────────────────────────────
  function showConfirm(
    title,
    message,
    btnText = "Confirm",
    confirmColor = "bg-rose-600 hover:bg-rose-700",
  ) {
    return new Promise((resolve) => {
      const overlay = document.getElementById("customConfirmOverlay");
      const titleEl = document.getElementById("customConfirmTitle");
      const msgEl = document.getElementById("customConfirmMsg");
      const btnOk = document.getElementById("customConfirmOk");
      const btnCancel = document.getElementById("customConfirmCancel");

      titleEl.textContent = title;
      msgEl.textContent = message;

      btnOk.className = `px-5 py-2.5 text-sm font-semibold text-white rounded-lg transition-colors shadow-sm ${confirmColor}`;
      btnOk.textContent = btnText;

      overlay.classList.remove("hidden");
      overlay.classList.add("flex");
      void overlay.offsetWidth;
      overlay.classList.remove("opacity-0");
      overlay.firstElementChild.classList.remove("scale-95");

      const cleanup = (result) => {
        overlay.classList.add("opacity-0");
        overlay.firstElementChild.classList.add("scale-95");
        setTimeout(() => {
          overlay.classList.add("hidden");
          overlay.classList.remove("flex");
        }, 300);
        btnOk.removeEventListener("click", onOk);
        btnCancel.removeEventListener("click", onCancel);
        resolve(result);
      };

      const onOk = () => cleanup(true);
      const onCancel = () => cleanup(false);

      btnOk.addEventListener("click", onOk);
      btnCancel.addEventListener("click", onCancel);
    });
  }

  // ── Toast System ─────────────────────────────────────────────────────────────
  window.showToast = function (message, type = "success") {
    const container = document.getElementById("toast-container");
    if (!container) return;
    const colors = {
      success: "bg-emerald-600",
      error: "bg-red-600",
      info: "bg-[#1a73e8]",
      warning: "bg-amber-500",
    };
    const icons = {
      success: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>`,
      error: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
      info: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
      warning: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>`,
    };
    const toast = document.createElement("div");
    toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl text-white shadow-xl transform transition-all duration-300 translate-y-4 opacity-0 ${colors[type] || colors.info} max-w-xs`;
    toast.innerHTML = `
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">${icons[type] || icons.info}</svg>
      <span class="text-sm font-medium">${message}</span>
    `;
    container.appendChild(toast);
    requestAnimationFrame(() => {
      toast.classList.remove("translate-y-4", "opacity-0");
      toast.classList.add("translate-y-0", "opacity-100");
    });
    setTimeout(() => {
      toast.classList.add("translate-y-4", "opacity-0");
      setTimeout(() => toast.remove(), 300);
    }, 4000);
  };

  // ── Draft Banner Dismiss ──────────────────────────────────────────────────────
  const dismissBtn = document.getElementById("dismissDraftBanner");
  if (dismissBtn) {
    dismissBtn.addEventListener("click", () => {
      const banner = document.getElementById("draftBanner");
      if (banner) {
        banner.style.transition = "opacity 0.3s, transform 0.3s";
        banner.style.opacity = "0";
        banner.style.transform = "translateY(-8px)";
        setTimeout(() => banner.remove(), 300);
      }
    });
  }

  // ── SEO Ping Handler (with 60s cooldown to avoid IndexNow 429) ──────────────
  const seoPingBtn = document.getElementById("seoPingBtn");
  const seoPingIcon = document.getElementById("seoPingIcon");
  const seoPingStatus = document.getElementById("seoPingStatus");
  const SEO_PING_COOLDOWN_KEY = "seoPingLastTimestamp";
  const SEO_PING_COOLDOWN_MS = 60_000; // 60 seconds between pings

  if (seoPingBtn) {
    seoPingBtn.addEventListener("click", async () => {
      // ── Client-side cooldown check ──
      const lastPingTs = parseInt(localStorage.getItem(SEO_PING_COOLDOWN_KEY) || "0", 10);
      const elapsed = Date.now() - lastPingTs;
      if (elapsed < SEO_PING_COOLDOWN_MS) {
        const waitSec = Math.ceil((SEO_PING_COOLDOWN_MS - elapsed) / 1000);
        showToast(`⏳ Please wait ${waitSec}s before pinging again (rate-limit protection).`, "warning");
        return;
      }

      seoPingBtn.disabled = true;
      if (seoPingIcon) {
        seoPingIcon.innerHTML = `<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" stroke="none" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>`;
        seoPingIcon.setAttribute("class", "w-4 h-4 animate-spin");
      }
      if (seoPingStatus) seoPingStatus.textContent = "Pinging engines...";

      try {
        const res = await fetch("/api/ping-seo", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({}),
        });
        const data = await res.json();

        // Record successful ping timestamp for cooldown
        localStorage.setItem(SEO_PING_COOLDOWN_KEY, String(Date.now()));

        if (data.success) {
          showToast(
            `✓ Pinged ${data.successCount}/${data.totalCount} engines successfully!`,
            "success",
          );
          if (seoPingStatus)
            seoPingStatus.textContent = `Last ping: just now · ${data.successCount}/${data.totalCount} success`;
        } else {
          showToast("Ping failed. Check console for details.", "error");
          if (seoPingStatus)
            seoPingStatus.textContent = "Ping failed. Retry later.";
        }

        // Show per-engine results
        if (data.results && Array.isArray(data.results)) {
          data.results.forEach((r, i) => {
            const delay = i * 400;
            setTimeout(() => {
              const icon =
                r.status === "success"
                  ? "✓"
                  : r.status === "skipped"
                    ? "⊘"
                    : "✗";
              const type =
                r.status === "success"
                  ? "success"
                  : r.status === "skipped"
                    ? "info"
                    : "warning";
              showToast(`${icon} ${r.engine}: ${r.message}`, type);
            }, delay);
          });
        }
      } catch (err) {
        console.error("SEO Ping error:", err);
        showToast("Network error. Try again.", "error");
        if (seoPingStatus) seoPingStatus.textContent = "Network error.";
      } finally {
        seoPingBtn.disabled = false;
        if (seoPingIcon) {
          seoPingIcon.setAttribute("class", "w-4 h-4");
          seoPingIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>`;
        }
      }
    });
  }

  // ── Recent Articles: Live Filter ─────────────────────────────────────────────
  const recentSearchInput = document.getElementById("recentSearchInput");
  const recentRows = document.querySelectorAll(".recent-article-row");
  const recentNoMatch = document.getElementById("recentNoMatch");
  const recentList = document.getElementById("recentArticlesList");

  if (recentSearchInput) {
    recentSearchInput.addEventListener("input", (e) => {
      const term = e.target.value.toLowerCase().trim();
      let visibleCount = 0;
      recentRows.forEach((row) => {
        const slug = row.getAttribute("data-slug") || "";
        const name = row.getAttribute("data-name") || "";
        const matches = !term || slug.includes(term) || name.includes(term);
        row.style.display = matches ? "" : "none";
        if (matches) visibleCount++;
      });
      if (recentNoMatch && recentList) {
        if (visibleCount === 0 && term) {
          recentNoMatch.classList.remove("hidden");
          recentNoMatch.classList.add("flex");
        } else {
          recentNoMatch.classList.add("hidden");
          recentNoMatch.classList.remove("flex");
        }
      }
    });
  }

  // ── Recent Articles: Delete Handler ──────────────────────────────────────────
  window.confirmDeleteArticle = async function (event, path, sha) {
    // IMPORTANT: capture the button + row reference BEFORE the await.
    // After an `await`, the original click `event` can become stale/null
    // (the browser does not guarantee `event.currentTarget` survives an
    // async gap), which was causing "Cannot read properties of null
    // (reading 'closest')". Always grab what you need synchronously first.
    const btn = event.currentTarget;
    const row = btn.closest(".recent-article-row");

    const confirmed = await showConfirm(
      "Delete Article",
      `Are you sure you want to delete "${path}"? This action cannot be undone.`,
      "Delete",
      "bg-rose-600 hover:bg-rose-700",
    );
    if (!confirmed) return;
    const originalContent = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = `<svg class="animate-spin w-3.5 h-3.5" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`;

    try {
      const res = await fetch("/api/delete-post", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ path, sha }),
      });
      const data = await res.json();

      if (res.ok && data.success) {
        showToast("Article deleted successfully!", "success");
        if (row) {
          row.style.transition = "opacity 0.25s, transform 0.25s";
          row.style.opacity = "0";
          row.style.transform = "translateX(8px)";
          setTimeout(() => row.remove(), 250);
        }
      } else {
        showToast("Error: " + (data.error || "Failed to delete"), "error");
        btn.innerHTML = originalContent;
        btn.disabled = false;
      }
    } catch (err) {
      console.error("Delete error:", err);
      showToast("Network error while deleting.", "error");
      btn.innerHTML = originalContent;
      btn.disabled = false;
    }
  };

  // ── Recent Articles: Publish Date + Real View Count (Cloudflare Analytics) ───
  function formatPublishDate(iso) {
    if (!iso) return "Date unavailable";
    const d = new Date(iso);
    if (isNaN(d.getTime())) return "Date unavailable";
    return d.toLocaleDateString("en-IN", {
      day: "numeric",
      month: "short",
      year: "numeric",
    });
  }

  function formatViews(n) {
    if (n === null || n === undefined) return null; // analytics not configured
    if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, "") + "K views";
    return `${n} view${n === 1 ? "" : "s"}`;
  }

  (async function hydrateRecentArticleMeta() {
    const rows = document.querySelectorAll(".recent-article-row");
    if (rows.length === 0) return;

    try {
      const res = await fetch("/api/post-views");
      if (!res.ok) throw new Error("post-views fetch failed");
      const data = await res.json();
      if (!data || !Array.isArray(data.posts)) return;

      const byPath = new Map(data.posts.map((p) => [p.path, p]));

      rows.forEach((row) => {
        const path = row.getAttribute("data-path");
        const info = path ? byPath.get(path) : null;
        const dateEl = row.querySelector(".post-meta-date-text");
        const viewsEl = row.querySelector(".post-meta-views-text");
        const viewsWrap = row.querySelector(".post-meta-views");

        if (dateEl) {
          dateEl.textContent = info
            ? formatPublishDate(info.publishedAt)
            : "Date unavailable";
        }

        if (viewsWrap && viewsEl) {
          const viewsLabel = info ? formatViews(info.views) : null;
          if (viewsLabel === null) {
            viewsWrap.classList.add("hidden"); // analytics not configured yet
          } else {
            viewsEl.textContent = viewsLabel;
          }
        }
      });
    } catch (err) {
      console.error("hydrateRecentArticleMeta error:", err);
      document.querySelectorAll(".post-meta-date-text").forEach((el) => {
        el.textContent = "Date unavailable";
      });
      document
        .querySelectorAll(".post-meta-views")
        .forEach((el) => el.classList.add("hidden"));
    }
  })();

</script>
