---
// src/pages/index.astro
import DashboardLayout from "../layouts/DashboardLayout.astro";
import SeoInspectionModal from "../components/SeoInspectionModal.astro";
import { sitesConfig, getActiveSite } from "../config/sitesConfig";
import { getPostsCatalog, getRecentCommits } from "../lib/github";
import { env } from "cloudflare:workers";
import { getSession, getSessionToken } from "../lib/auth"; // Import these

const activeSite = getActiveSite();
const token = env?.GITHUB_PAT || import.meta.env.GITHUB_PAT;

// --- User Session and Role ---
const sessionToken = getSessionToken(Astro.request.headers.get("cookie"));
let isAdmin = false;
let sessionEmail: string | null = null;
if (sessionToken) {
  const session = await getSession(env?.SESSION as KVNamespace, sessionToken);
  if (session) {
    sessionEmail = session.email || null;
    if (session.role === "admin") {
      isAdmin = true;
    }
  }
}

// ─── 1. Published Posts (Smart: KV-first, 0 API calls on cache hit) ──────────
const RECENT_LIMIT = 6;
let totalPosts = 0;
let recentPosts: any[] = [];
const postTitleMap: Record<string, string> = {};

try {
  const catalog = await getPostsCatalog(
    activeSite.githubOwner,
    activeSite.githubRepo,
    activeSite.contentPath,
    token,
    activeSite.branch,
    env?.CACHE_KV,
  );
  totalPosts = catalog.totalCount;

  // Sort by publish date (most recent first)
  const sortedPosts = catalog.posts.sort((a, b) => {
    const timeA = a.publishedAt ? new Date(a.publishedAt).getTime() : 0;
    const timeB = b.publishedAt ? new Date(b.publishedAt).getTime() : 0;
    if (timeA === timeB) {
      return (b.slug || "").localeCompare(a.slug || "");
    }
    return timeB - timeA;
  });

  recentPosts = sortedPosts.slice(0, RECENT_LIMIT);

  // Build postTitleMap for SEO modal (from cached catalog — no extra API calls)
  for (const post of sortedPosts) {
    const postUrl = `${activeSite.url}/post/${post.slug}/`;
    postTitleMap[postUrl] = post.title || post.slug;
  }
} catch {}


// ─── 2. R2 Bucket Stats ───────────────────────────────────────────────────────
let totalImages = 0;
let totalStorageBytes = 0;
try {
  const bucket = env?.IMG_BUCKET;
  if (bucket) {
    const listed = await bucket.list({ limit: 1000 });
    totalImages = listed.objects.length;
    totalStorageBytes = listed.objects.reduce(
      (sum: number, obj: any) => sum + (obj.size || 0),
      0,
    );
  }
} catch {}

// ─── 3. KV Draft Status ──────────────────────────────────────────────────────
let hasDraft = false;
let draftTitle: string | null = null;
let draftUpdatedAt: string | null = null;
let resumeUrl = "/write";
try {
  // Use sessionEmail (from getSession) as primary source — more reliable than Astro.locals.user
  const userEmail = sessionEmail || Astro.locals.user?.email || 'anonymous';
  console.error('[DraftDebug] userEmail for draft lookup:', userEmail);
  const prefix = `draft:cms:write-article:${userEmail}:`;
  const draftList = env?.CACHE_KV ? await env.CACHE_KV.list({ prefix }) : { keys: [] };

  if (draftList && draftList.keys.length > 0) {
    let newestDraft: any = null;
    let newestKey = "";

    for (const keyObj of draftList.keys) {
      const draft = await env.CACHE_KV.get(keyObj.name, "json") as any;
      if (draft) {
        const ts = draft.timestamp || draft.updatedAt || "";
        const newestTs = newestDraft ? (newestDraft.timestamp || newestDraft.updatedAt || "") : "";
        if (!newestDraft || new Date(ts) > new Date(newestTs)) {
          newestDraft = draft;
          newestKey = keyObj.name;
        }
      }
    }

    if (newestDraft) {
      hasDraft = true;
      draftTitle = newestDraft.postTitle || newestDraft.title || null;
      draftUpdatedAt = newestDraft.timestamp || newestDraft.updatedAt || null;

      const suffix = newestKey.replace(prefix, "");
      if (suffix && suffix !== "new") {
        const displayFile = suffix.includes('/') ? suffix.split('/').pop() : suffix;
        resumeUrl = `/write?file=${encodeURIComponent(displayFile)}`;
      } else {
        resumeUrl = "/write";
      }
    }
  }
} catch (e) {
  console.error("Error loading draft status:", e);
}

// ─── 4. Recent GitHub Commits ─────────────────────────────────────────────────
let recentCommits: any[] = [];
try {
  recentCommits = await getRecentCommits(
    activeSite.githubOwner,
    activeSite.githubRepo,
    activeSite.branch,
    token,
    5,
  );
} catch {}

// ─── Helpers ──────────────────────────────────────────────────────────────────
function formatBytes(bytes: number): string {
  if (bytes === 0) return "0 B";
  const k = 1024;
  const sizes = ["B", "KB", "MB", "GB"];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return `${parseFloat((bytes / Math.pow(k, i)).toFixed(1))} ${sizes[i]}`;
}

function timeAgo(dateStr: string | null): string {
  if (!dateStr) return "Unknown";
  const date = new Date(dateStr);
  const now = new Date();
  const diff = Math.floor((now.getTime() - date.getTime()) / 1000);
  if (diff < 60) return `${diff}s ago`;
  if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
  if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
  if (diff < 604800) return `${Math.floor(diff / 86400)}d ago`;
  return date.toLocaleDateString("en-US", { month: "short", day: "numeric" });
}

const lastCommit = recentCommits[0] || null;
---

<DashboardLayout title="Dashboard">
  <!-- ── Draft Recovery Banner ─────────────────────────────────────────────── -->
  {
    hasDraft && (
      <div
        id="draftBanner"
        class="mb-6 bg-amber-50 border border-amber-200 rounded-xl p-4 flex items-center gap-4 shadow-sm"
      >
        <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-600 shrink-0">
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
            />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-amber-800">
            Unsaved Draft Found
          </p>
          <p class="text-xs text-amber-600 mt-0.5 truncate">
            {draftTitle ? `"${draftTitle}"` : "Untitled Draft"}
            {draftUpdatedAt ? ` · Last edited ${timeAgo(draftUpdatedAt)}` : ""}
          </p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <a
            href={resumeUrl}
            class="text-sm font-semibold text-amber-700 bg-amber-100 hover:bg-amber-200 px-4 py-2 rounded-lg transition-colors"
          >
            Resume Draft →
          </a>
          <button
            id="dismissDraftBanner"
            class="w-8 h-8 flex items-center justify-center text-amber-500 hover:text-amber-700 hover:bg-amber-100 rounded-lg transition-colors"
            title="Dismiss"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </button>
        </div>
      </div>
    )
  }

  <!-- ── 5 Stat Cards ──────────────────────────────────────────────────────── -->
  <div
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-5 mb-6"
  >
    <!-- Card 1: Total Posts -->
    <div
      class="bg-white p-5 rounded-xl border border-[#e2e8f0] shadow-sm hover:shadow-md transition-shadow flex items-center gap-4 lg:flex-col lg:items-stretch lg:gap-0 lg:h-full"
    >
      <div
        class="w-12 h-12 lg:w-11 lg:h-11 bg-blue-50 rounded-xl flex items-center justify-center text-[#1a73e8] shrink-0 lg:mb-4"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
          ></path>
        </svg>
      </div>
      <div class="lg:flex lg:flex-col lg:flex-1">
        <p
          class="text-[#64748b] text-xs font-semibold uppercase tracking-wider"
        >
          Total Published
        </p>
        <p
          class="text-2xl lg:text-3xl font-bold text-[#1e293b] mt-0.5 lg:mt-1.5"
        >
          {totalPosts}
        </p>
        <p class="text-xs text-[#94a3b8] mt-0.5 lg:mt-auto lg:pt-3">
          Articles on GitHub
        </p>
      </div>
    </div>

    <!-- Card 2: R2 Media -->
    <div
      class="bg-white p-5 rounded-xl border border-[#e2e8f0] shadow-sm hover:shadow-md transition-shadow flex items-center gap-4 lg:flex-col lg:items-stretch lg:gap-0 lg:h-full"
    >
      <div
        class="w-12 h-12 lg:w-11 lg:h-11 bg-purple-50 rounded-xl flex items-center justify-center text-purple-600 shrink-0 lg:mb-4"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
          ></path>
        </svg>
      </div>
      <div class="lg:flex lg:flex-col lg:flex-1">
        <p
          class="text-[#64748b] text-xs font-semibold uppercase tracking-wider"
        >
          R2 Media Library
        </p>
        <p
          class="text-2xl lg:text-3xl font-bold text-[#1e293b] mt-0.5 lg:mt-1.5"
        >
          {totalImages}
        </p>
        <p class="text-xs text-[#94a3b8] mt-0.5 lg:mt-auto lg:pt-3">
          {formatBytes(totalStorageBytes)} used
        </p>
      </div>
    </div>

    <!-- Card 3: Draft Status -->
    <div
      class={`bg-white p-5 rounded-xl border shadow-sm hover:shadow-md transition-shadow flex items-center gap-4 lg:flex-col lg:items-stretch lg:gap-0 lg:h-full ${hasDraft ? "border-amber-200" : "border-[#e2e8f0]"}`}
    >
      <div
        class={`w-12 h-12 lg:w-11 lg:h-11 rounded-xl flex items-center justify-center shrink-0 lg:mb-4 ${hasDraft ? "bg-amber-50 text-amber-600" : "bg-slate-50 text-slate-400"}`}
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
          ></path>
        </svg>
      </div>
      <div class="min-w-0 flex-1 lg:flex lg:flex-col">
        <p
          class="text-[#64748b] text-xs font-semibold uppercase tracking-wider"
        >
          Draft Status
        </p>
        {
          hasDraft ? (
            <>
              <p class="text-sm font-bold text-amber-600 mt-0.5 lg:mt-1.5 truncate">
                {draftTitle || "Untitled"}
              </p>
              <a
                href={resumeUrl}
                class="text-xs text-[#1a73e8] hover:underline mt-0.5 lg:mt-auto lg:pt-3 block"
              >
                Resume editing →
              </a>
            </>
          ) : (
            <>
              <p class="text-2xl lg:text-3xl font-bold text-[#1e293b] mt-0.5 lg:mt-1.5">
                None
              </p>
              <p class="text-xs text-[#94a3b8] mt-0.5 lg:mt-auto lg:pt-3">
                No saved drafts
              </p>
            </>
          )
        }
      </div>
    </div>

    <!-- Card 4: Last GitHub Push -->
    <div
      class="bg-white p-5 rounded-xl border border-[#e2e8f0] shadow-sm hover:shadow-md transition-shadow flex items-center gap-4 lg:flex-col lg:items-stretch lg:gap-0 lg:h-full"
    >
      <div
        class="w-12 h-12 lg:w-11 lg:h-11 bg-emerald-50 rounded-xl flex items-center justify-center text-emerald-600 shrink-0 lg:mb-4"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
        </svg>
      </div>
      <div class="min-w-0 flex-1 lg:flex lg:flex-col">
        <p
          class="text-[#64748b] text-xs font-semibold uppercase tracking-wider"
        >
          Last GitHub Push
        </p>
        {
          lastCommit ? (
            <>
              <p class="text-sm font-bold text-[#1e293b] mt-0.5 lg:mt-1.5">
                {timeAgo(lastCommit.date)}
              </p>
              <p class="text-xs text-[#94a3b8] mt-0.5 lg:mt-auto lg:pt-3 truncate">
                {lastCommit.shortSha} · {lastCommit.message.slice(0, 30)}
              </p>
            </>
          ) : (
            <>
              <p class="text-2xl lg:text-3xl font-bold text-[#1e293b] mt-0.5 lg:mt-1.5">
                —
              </p>
              <p class="text-xs text-[#94a3b8] mt-0.5 lg:mt-auto lg:pt-3">
                Unable to fetch
              </p>
            </>
          )
        }
      </div>
    </div>

    <!-- Card 5: SEO Summary -->
    <div
      class="bg-white p-5 rounded-xl border border-[#e2e8f0] shadow-sm hover:shadow-md transition-shadow flex items-start gap-4 lg:flex-col lg:items-stretch lg:gap-0 lg:h-full"
    >
      <div
        class="w-12 h-12 lg:w-11 lg:h-11 bg-indigo-50 rounded-xl flex items-center justify-center text-indigo-600 shrink-0 mt-0.5 lg:mt-0 lg:mb-4 animate-pulse-subtle"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
          ></path>
        </svg>
      </div>
      <div class="min-w-0 flex-1 lg:flex lg:flex-col text-left">
        <div class="flex items-center justify-between">
          <p
            class="text-[#64748b] text-xs font-semibold uppercase tracking-wider"
          >
            SEO Indexing
          </p>
          <button
            id="cardSyncGscBtn"
            class="p-1.5 rounded-lg text-slate-400 hover:text-[#1a73e8] hover:bg-slate-100/80 transition-colors cursor-pointer"
            title="Sync GSC Status"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
            </svg>
          </button>
        </div>
        <div
          class="mt-2.5 space-y-1 lg:space-y-1.5 text-[10px] lg:flex-1 lg:flex lg:flex-col lg:justify-center"
        >
          <!-- Indexed -->
          <div
            onclick="openSeoDetailsModal('indexed')"
            class="flex items-center justify-between bg-[#f0fdf4] hover:bg-[#dcfce7] px-2 py-0.5 rounded-md border border-[#bbf7d0] text-[#166534] transition-all hover:scale-[1.02] active:scale-[0.99] cursor-pointer"
          >
            <span class="flex items-center gap-1 font-semibold">
              <span class="w-1.5 h-1.5 rounded-full bg-[#16a34a]"></span>
              Indexed
            </span>
            <span class="font-bold" id="summary-count-indexed">0</span>
          </div>
          <!-- Pending -->
          <div
            onclick="openSeoDetailsModal('pending')"
            class="flex items-center justify-between bg-[#fffbeb] hover:bg-[#fef3c7] px-2 py-0.5 rounded-md border border-[#fde68a] text-[#854d0e] transition-all hover:scale-[1.02] active:scale-[0.99] cursor-pointer"
          >
            <span class="flex items-center gap-1 font-semibold">
              <span class="w-1.5 h-1.5 rounded-full bg-[#d97706]"></span>
              Pending
            </span>
            <span class="font-bold" id="summary-count-pending">0</span>
          </div>
          <!-- Errors -->
          <div
            onclick="openSeoDetailsModal('error')"
            class="flex items-center justify-between bg-[#fef2f2] hover:bg-[#fee2e2] px-2 py-0.5 rounded-md border border-[#fecaca] text-[#991b1b] transition-all hover:scale-[1.02] active:scale-[0.99] cursor-pointer"
          >
            <span class="flex items-center gap-1 font-semibold">
              <span class="w-1.5 h-1.5 rounded-full bg-[#dc2626]"></span>
              Errors
            </span>
            <span class="font-bold" id="summary-count-error">0</span>
          </div>
          <!-- Unknown -->
          <div
            onclick="openSeoDetailsModal('unknown')"
            class="flex items-center justify-between bg-[#f8fafc] hover:bg-[#f1f5f9] px-2 py-0.5 rounded-md border border-[#e2e8f0] text-[#475569] transition-all hover:scale-[1.02] active:scale-[0.99] cursor-pointer"
          >
            <span class="flex items-center gap-1 font-semibold">
              <span class="w-1.5 h-1.5 rounded-full bg-[#64748b]"></span>
              Unknown
            </span>
            <span class="font-bold" id="summary-count-unknown">0</span>
          </div>
        </div>
        <p
          id="summary-last-sync-wrapper"
          class="text-[10px] text-[#94a3b8] mt-2.5 lg:mt-auto lg:pt-2.5 truncate"
          title="Last Sync GSC"
        >
          Last Sync: <span id="summary-last-sync">Never</span>
        </p>
      </div>
    </div>
  </div>

  <!-- ── Main 2-col Grid ────────────────────────────────────────────────────── -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-5">
    <!-- Left: Recent Articles -->
    <div
      class="lg:col-span-2 bg-white rounded-xl border border-[#e2e8f0] shadow-sm overflow-hidden flex flex-col"
    >
      <div
        class="px-5 py-4 border-b border-[#e2e8f0] bg-[#f8fafc] flex justify-between items-center"
      >
        <div>
          <h2 class="text-base font-bold text-[#1e293b]">Recent Articles</h2>
          <p class="text-xs text-[#94a3b8] mt-0.5">
            Latest {Math.min(totalPosts, RECENT_LIMIT)} of {totalPosts} published
          </p>
        </div>
        <div class="flex items-center gap-2">
          <div class="relative hidden sm:block">
            <svg
              class="w-3.5 h-3.5 text-[#cbd5e1] absolute left-2.5 top-1/2 -translate-y-1/2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <input
              type="text"
              id="recentSearchInput"
              placeholder="Filter..."
              class="pl-8 pr-3 py-1.5 text-xs border border-[#e2e8f0] rounded-lg bg-white w-32 focus:w-44 focus:outline-none focus:border-[#1a73e8] transition-all"
            />
          </div>
          <a
            href="/posts"
            class="text-xs font-semibold text-[#1a73e8] hover:underline bg-blue-50 px-3 py-1.5 rounded-lg transition-colors hover:bg-blue-100 whitespace-nowrap"
          >
            View All →
          </a>
        </div>
      </div>

      <div id="recentArticlesList" class="divide-y divide-[#f1f5f9]">
        {
          recentPosts.length === 0 ? (
            <div class="flex flex-col items-center justify-center py-12 text-[#94a3b8]">
              <svg
                class="w-10 h-10 mb-3 text-[#cbd5e1]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                />
              </svg>
              <p class="text-sm font-medium">No articles found</p>
              <a
                href="/write"
                class="text-xs text-[#1a73e8] mt-1 hover:underline"
              >
                Write your first post →
              </a>
            </div>
          ) : (
            recentPosts.map((post, i) => (
              <div
                class="recent-article-row flex items-center gap-3 px-5 py-3.5 hover:bg-[#f8fafc] transition-colors group"
                data-slug={post.slug.toLowerCase()}
                data-name={post.name.toLowerCase()}
                data-path={post.path}
              >
                <div class="w-7 h-7 rounded bg-[#f1f5f9] group-hover:bg-blue-50 flex items-center justify-center text-[#94a3b8] group-hover:text-[#1a73e8] transition-colors shrink-0">
                  <svg
                    class="w-3.5 h-3.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
