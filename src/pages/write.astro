                            >
                            <input
                                type="text"
                                id="metaTags"
                                
                                class="w-full border border-[#cbd5e1] rounded-lg px-3 py-2 text-sm focus:border-[#1a73e8] focus:outline-none"
                            />
                        </div>
                    </div>
                    <!-- NEW: Author & Image Caption -->
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label
                                class="text-[11px] font-semibold uppercase tracking-wider text-[#64748b] mb-1 block"
