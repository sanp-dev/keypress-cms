    // Smart Multi-Tab Editor Commands Execution
    function execCmd(cmd, val = null) {
        const activeTabBtn = document.querySelector(".tab-btn.active");
        const activeTarget = activeTabBtn
            ? activeTabBtn.getAttribute("data-target")
            : "composeView";

        if (activeTarget === "composeView") {
            const compView = document.getElementById("composeView");

            // Restore selection lost when focus shifts to toolbar controls (buttons/dropdowns)
            const sel = window.getSelection();
            const needsRestore =
                document.activeElement !== compView &&
                lastComposeSelectionRange;

            compView.focus();

            if (sel && needsRestore) {
                try {
                    sel.removeAllRanges();
                    sel.addRange(lastComposeSelectionRange);
                } catch (e) {}
            }

            if (cmd === "foreColor" || cmd === "hiliteColor") {
                document.execCommand("styleWithCSS", false, true);
                if (cmd === "hiliteColor") {
                    document.execCommand("hiliteColor", false, val);
                    document.execCommand("backColor", false, val);
                } else {
                    document.execCommand(cmd, false, val);
                }
                document.execCommand("styleWithCSS", false, false);
            } else if (cmd === "removeFormat") {
                document.execCommand("styleWithCSS", false, true);
                document.execCommand("removeFormat", false, null);
                document.execCommand("foreColor", false, "#334155");
                document.execCommand("backColor", false, "transparent");
                document.execCommand("styleWithCSS", false, false);
            } else {
                document.execCommand(cmd, false, val);
            }
            syncFromEditor(EDITOR_SYNC_SOURCE.COMPOSE, true);
        } else {
            // Logic for Markdown and HTML views
            const textarea = document.getElementById(activeTarget);
            if (!textarea) return;

            if (
                (cmd === "undo" || cmd === "redo") &&
                handleTextareaHistory(activeTarget, cmd)
            ) {
                return;
            }

            const start = textarea.selectionStart;
            const end = textarea.selectionEnd;
            const text = textarea.value;
            const selectedText = text.substring(start, end);
            let before = "",
                after = "";

            const isMd = activeTarget === "markdownView";

            switch (cmd) {
                case "bold":
                    before = isMd ? "**" : "<strong>";
                    after = isMd ? "**" : "</strong>";
                    break;
                case "italic":
                    before = isMd ? "*" : "<em>";
                    after = isMd ? "*" : "</em>";
                    break;
                case "underline":
                    before = isMd ? "<u>" : "<u>";
                    after = isMd ? "</u>" : "</u>";
                    break;
                case "strikeThrough":
                    before = isMd ? "~~" : "<del>";
                    after = isMd ? "~~" : "</del>";
                    break;
                case "foreColor":
                    before = isMd
                        ? `<span style="color: ${val};">`
                        : `<span style="color: ${val};">`;
                    after = "</span>";
                    break;
                case "hiliteColor":
                    before = isMd
                        ? `<mark style="background-color: ${val}; color: inherit;">`
                        : `<mark style="background-color: ${val}; color: inherit;">`;
                    after = "</mark>";
                    break;
                case "formatBlock":
                    if (val === "H1") {
                        before = isMd ? "# " : "<h1>";
                        after = isMd ? "" : "</h1>";
                    }
                    if (val === "H2") {
                        before = isMd ? "## " : "<h2>";
                        after = isMd ? "" : "</h2>";
                    } else if (val === "H3") {
                        before = isMd ? "### " : "<h3>";
                        after = isMd ? "" : "</h3>";
                    } else if (val === "H4") {
                        before = isMd ? "#### " : "<h4>";
                        after = isMd ? "" : "</h4>";
                    } else if (val === "BLOCKQUOTE") {
                        before = isMd ? "> " : "<blockquote>";
                        after = isMd ? "" : "</blockquote>";
                    } else if (val === "PRE") {
                        before = isMd ? "```\n" : "<pre><code>";
                        after = isMd ? "\n```" : "</code></pre>";
                    } else if (val === "P") {
                        before = isMd ? "" : "<p>";
                        after = isMd ? "\n\n" : "</p>";
                    }
                    break;
                case "insertUnorderedList":
                    before = isMd ? "- " : "<ul>\n  <li>";
                    after = isMd ? "" : "</li>\n</ul>";
                    break;
                case "insertOrderedList":
                    before = isMd ? "1. " : "<ol>\n  <li>";
                    after = isMd ? "" : "</li>\n</ol>";
                    break;
            }

            if (before || after) {
                wrapSelectedText(textarea, before, after, "text");
                recordTabHistory(
                    activeTarget,
                    textarea.value,
                    getHistorySelection(textarea),
                );
                syncFromEditor(
                    isMd
                        ? EDITOR_SYNC_SOURCE.MARKDOWN
                        : EDITOR_SYNC_SOURCE.HTML,
                    true,
                );
                updateFormatSelectState();
            }
        }
    }

    // Link Modal Logic
    let currentEditingLink = null;
    let savedSelectionRange = null;
    let savedTextareaSelection = null;
    let lastComposeSelectionRange = null;

    function saveSelectionRange() {
        const activeSource = getVisibleEditorSource();
        if (activeSource === EDITOR_SYNC_SOURCE.COMPOSE) {
            const sel = window.getSelection();
            if (
                sel &&
                sel.rangeCount > 0 &&
                composeView.contains(sel.anchorNode)
            ) {
                savedSelectionRange = sel.getRangeAt(0).cloneRange();
                lastComposeSelectionRange = savedSelectionRange;
            } else {
                savedSelectionRange = lastComposeSelectionRange || null;
            }
            savedTextareaSelection = null;
        } else {
            const textarea = document.getElementById(
                activeSource === EDITOR_SYNC_SOURCE.MARKDOWN
                    ? "markdownView"
                    : "htmlView",
            );
            if (textarea) {
                savedTextareaSelection = {
                    start: textarea.selectionStart,
                    end: textarea.selectionEnd,
                };
            } else {
                savedTextareaSelection = null;
            }
            savedSelectionRange = null;
        }
    }

    function restoreSelectionRange() {
        if (!savedSelectionRange) return;
        const sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(savedSelectionRange);
    }

    function openLinkModal() {
        const activeTabBtn = document.querySelector(".tab-btn.active");
        const activeTarget = activeTabBtn
            ? activeTabBtn.getAttribute("data-target")
            : "composeView";

        if (activeTarget === "composeView") {
            saveSelectionRange();
            const sel = window.getSelection();
            let node = sel.anchorNode;
            if (node && node.nodeType === 3) node = node.parentNode;
            currentEditingLink = node ? node.closest("a") : null;

            if (currentEditingLink) {
                document.getElementById("linkText").value =
                    currentEditingLink.textContent;
                document.getElementById("linkUrl").value =
                    currentEditingLink.getAttribute("href");
                document.getElementById("linkRel").value =
                    currentEditingLink.rel || "";
                document.getElementById("linkTarget").value =
                    currentEditingLink.target || "_blank";
            } else {
                document.getElementById("linkText").value = sel
                    ? sel.toString()
                    : "";
                document.getElementById("linkUrl").value = "";
            }
        } else {
            // Fallback for markdown/html selection text
            savedSelectionRange = null;
            const textarea = document.getElementById(activeTarget);
            document.getElementById("linkText").value =
                textarea.value.substring(
                    textarea.selectionStart,
                    textarea.selectionEnd,
                );
            document.getElementById("linkUrl").value = "";
            currentEditingLink = null;
        }

        document.getElementById("linkModalOverlay").classList.remove("hidden");
        document.getElementById("linkModal").classList.remove("hidden");
        document.getElementById("linkModal").classList.add("flex");

        // Focus URL input after opening, but keep modal interaction aware
        setTimeout(() => document.getElementById("linkUrl").focus(), 100);
    }

    function closeLinkModal() {
        currentEditingLink = null;
        savedSelectionRange = null;
        document.getElementById("linkModalOverlay").classList.add("hidden");
        document.getElementById("linkModal").classList.add("hidden");
        document.getElementById("linkModal").classList.remove("flex");
    }

    function insertLinkFromModal() {
        const url = document.getElementById("linkUrl").value.trim();
        if (!url) return;
        const text = document.getElementById("linkText").value.trim() || url;
        const rel = document.getElementById("linkRel").value;
        const target = document.getElementById("linkTarget").value;

        const activeTabBtn = document.querySelector(".tab-btn.active");
        const activeTarget = activeTabBtn
            ? activeTabBtn.getAttribute("data-target")
            : "composeView";

        if (activeTarget === "composeView") {
            if (currentEditingLink) {
                currentEditingLink.href = url;
                currentEditingLink.textContent = text;
                if (rel) currentEditingLink.rel = rel;
                else currentEditingLink.removeAttribute("rel");
                currentEditingLink.target = target;
            } else {
                // Restore the original selection range before inserting
                const composeEl = document.getElementById("composeView");
                composeEl.focus();
                restoreSelectionRange();

                const relAttr = rel ? ` rel="${rel}"` : "";
                const html = `<a href="${url}" target="${target}"${relAttr}>${text}</a>`;
                document.execCommand("insertHTML", false, html);
            }
            syncFromEditor(EDITOR_SYNC_SOURCE.COMPOSE, true);
        } else {
            const textarea = document.getElementById(activeTarget);
            const isMd = activeTarget === "markdownView";
            const before = isMd
                ? `[`
                : `<a href="${url}" target="${target}"${rel ? ` rel="${rel}"` : ""}>`;
            const after = isMd ? `](${url})` : `</a>`;

            const start = textarea.selectionStart;
            const end = textarea.selectionEnd;
            textarea.value =
                textarea.value.substring(0, start) +
                before +
                text +
                after +
                textarea.value.substring(end);
            syncFromEditor(
                isMd ? EDITOR_SYNC_SOURCE.MARKDOWN : EDITOR_SYNC_SOURCE.HTML,
                true,
            );
        }

        closeLinkModal();
    }

    // Smart Unlink: remove link at cursor position while keeping the text
    function unlinkCurrentLink() {
        const activeTabBtn = document.querySelector(".tab-btn.active");
        const activeTarget = activeTabBtn
            ? activeTabBtn.getAttribute("data-target")
            : "composeView";

        if (activeTarget === "composeView") {
            // Compose view: find the closest <a> at selection and unwrap it
            const sel = window.getSelection();
            let node = sel.anchorNode;
            if (!node || !composeView.contains(node)) {
                notify(
                    "icon",
                    "No Link Found",
                    "Place cursor inside a link to remove it.",
                    true,
                );
                return;
            }
            if (node.nodeType === 3) node = node.parentElement;
            const linkEl = node.closest("a");
            if (!linkEl) {
                notify(
                    "icon",
                    "No Link Found",
                    "Place cursor inside a link to remove it.",
                    true,
                );
                return;
            }
            // Unwrap: replace the <a> element with its text content only
            const parent = linkEl.parentNode;
            const textNode = document.createTextNode(linkEl.textContent);
            parent.replaceChild(textNode, linkEl);
            // Place cursor at the text position
            const range = document.createRange();
            range.setStart(textNode, 0);
            range.setEnd(textNode, textNode.length);
            sel.removeAllRanges();
            sel.addRange(range);
            composeView.focus();
            syncFromEditor(EDITOR_SYNC_SOURCE.COMPOSE, true);
            notify(
                "icon",
                "Link Removed",
                "Link has been removed, text preserved.",
                false,
            );
        } else {
            // Markdown / HTML textarea views
            const textarea = document.getElementById(activeTarget);
            if (!textarea) return;
            const start = textarea.selectionStart;
            const end = textarea.selectionEnd;
            const text = textarea.value;
            const isMd = activeTarget === "markdownView";

            if (isMd) {
                // Find markdown link [text](url) at/near cursor
                const beforeCursor = text.slice(0, start);
                const afterCursor = text.slice(start);
                // Search backwards for '[' before cursor
                const lastOpenBracket = beforeCursor.lastIndexOf("[");
                if (lastOpenBracket === -1) {
                    notify(
                        "icon",
                        "No Link Found",
                        "Place cursor inside a markdown link [text](url).",
                        true,
                    );
                    return;
                }
                const linkMatch = text
                    .slice(lastOpenBracket)
                    .match(/^\[([^\]]*)\]\(([^)]*)\)/);
                if (!linkMatch) {
                    notify(
                        "icon",
                        "No Link Found",
                        "Place cursor inside a markdown link [text](url).",
                        true,
                    );
                    return;
                }
                const fullLink = linkMatch[0];
                const linkText = linkMatch[1];
                const linkEnd = lastOpenBracket + fullLink.length;
                // Only act if cursor is inside the link range
                if (start < lastOpenBracket || start > linkEnd) {
                    notify(
                        "icon",
                        "No Link Found",
                        "Place cursor inside a markdown link to remove it.",
                        true,
                    );
                    return;
                }
                textarea.value =
                    text.slice(0, lastOpenBracket) +
                    linkText +
                    text.slice(linkEnd);
                textarea.focus();
                textarea.setSelectionRange(
                    lastOpenBracket,
                    lastOpenBracket + linkText.length,
                );
                recordTabHistory(
                    activeTarget,
                    textarea.value,
                    getHistorySelection(textarea),
                );
                syncFromEditor(EDITOR_SYNC_SOURCE.MARKDOWN, true);
                notify(
                    "icon",
                    "Link Removed",
                    "Markdown link has been removed, text preserved.",
                    false,
                );
            } else {
                // HTML view: find nearest <a> tag at cursor
                const beforeCursor = text.slice(0, start);
                const lastOpenTag = beforeCursor.lastIndexOf("<a ");
                const lastCloseTag = beforeCursor.lastIndexOf("</a>");
                // Find the most recent relevant tag
                const linkStart = Math.max(
                    lastOpenTag,
                    lastCloseTag > -1
                        ? beforeCursor.indexOf("</a>", lastCloseTag)
                        : -1,
                );
                // Use a simpler approach: search backwards for <a
                let searchPos = start;
                let openPos = -1;
                while (searchPos >= 0) {
                    const idx = text.lastIndexOf("<a ", searchPos);
                    if (idx === -1) break;
                    // Check if there's a matching </a>
                    const closeIdx = text.indexOf("</a>", idx);
                    if (
                        closeIdx !== -1 &&
                        start >= idx &&
                        start <= closeIdx + 4
                    ) {
                        openPos = idx;
                        break;
                    }
                    searchPos = idx - 1;
                }
                if (openPos === -1) {
                    notify(
                        "icon",
                        "No Link Found",
                        "Place cursor inside an HTML link tag to remove it.",
                        true,
                    );
                    return;
                }
                const closeIdx = text.indexOf("</a>", openPos);
                if (closeIdx === -1) {
                    notify(
                        "icon",
                        "No Link Found",
                        "Place cursor inside an HTML link tag to remove it.",
                        true,
                    );
                    return;
                }
                // Extract the inner text from the anchor tag
                const anchorContent = text.slice(openPos, closeIdx);
                const innerMatch = anchorContent.match(/>([^<]*)<\/?/);
                const innerText = innerMatch
                    ? innerMatch[1]
                    : anchorContent.replace(/<[^>]*>/g, "");
                textarea.value =
                    text.slice(0, openPos) +
                    innerText +
                    text.slice(closeIdx + 4);
                textarea.focus();
                textarea.setSelectionRange(openPos, openPos + innerText.length);
                recordTabHistory(
                    activeTarget,
                    textarea.value,
                    getHistorySelection(textarea),
                );
                syncFromEditor(EDITOR_SYNC_SOURCE.HTML, true);
                notify(
                    "icon",
                    "Link Removed",
                    "HTML link has been removed, text preserved.",
                    false,
                );
            }
        }
    }

    // AI Auto Internal Linking logic
    async function autoLinkArticle() {
        const snapshot = flushActiveEditorState();
        const content =
            snapshot.html || editorState.html || composeView.innerHTML;
        if (!content || content.length < 50) {
            notify(
                "icon",
                "Content Required",
                "Please generate or write an article first before auto-linking.",
                true,
            );
            return;
        }

        // Console Tab पर switch करें ताकि logs दिखें
        const consoleTabBtn = document.querySelector(
            '.tab-btn[data-target="consoleView"]',
        );
        if (consoleTabBtn) consoleTabBtn.click();

        const btn = document.getElementById("btnAutoLink");
        const origText = btn.innerHTML;
        btn.innerHTML = `${svgSpinner} Linking...`;
        btn.disabled = true;
        showUploadSpinner(
            "AI is analyzing and inserting SEO Internal Links...",
        );

        addConsoleLog("SYSTEM", "━━━ Auto-Link Session Started ━━━");
        addConsoleLog("INFO", `Editor HTML size: ${content.length} characters`);
        addConsoleLog("INFO", "Sending request to /api/auto-link ...");

        const startTime = Date.now();

        try {
            const res = await fetch("/api/auto-link", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ html: content }),
            });

            const elapsed = ((Date.now() - startTime) / 1000).toFixed(1);
            addConsoleLog(
                "INFO",
                `Server responded in ${elapsed}s — HTTP ${res.status} ${res.statusText}`,
            );

            const data = await res.json();

            // ── Server logs console print ──
            if (Array.isArray(data.logs) && data.logs.length > 0) {
                addConsoleLog(
                    "SYSTEM",
                    `── Server-side Logs (${data.logs.length}) ──`,
                );
                data.logs.forEach((entry) => {
                    addConsoleLog(
                        entry.level === "SUCCESS"
                            ? "SUCCESS"
                            : entry.level === "ERROR"
                              ? "ERROR"
                              : entry.level === "WARN"
                                ? "ERROR"
                                : "INFO",
                        "[Server] " + entry.message,
                        entry.detail || null,
                    );
                });
            }

            if (!res.ok) {
                throw new Error(data.error || `HTTP ${res.status} error`);
            }

            if (!data.html) {
                throw new Error("Server returned success but HTML is empty.");
            }

            setEditorContent({ html: data.html, triggerSave: true });

            const modelUsed = data.model || "Unknown";
            const articleCount = data.articleCount ?? "?";

            addConsoleLog("SUCCESS", `✅ Auto-linking complete!`);
            addConsoleLog("SUCCESS", `🤖 AI Model used: ${modelUsed}`);
            addConsoleLog(
                "SUCCESS",
                `📚 Published articles used as candidates: ${articleCount}`,
            );
            addConsoleLog(
                "INFO",
                `Final HTML size: ${data.html.length} characters`,
            );
            addConsoleLog("SYSTEM", "━━━ Auto-Link Session Ended ━━━");

            notify(
                "icon",
                `Linked via ${modelUsed}`,
                `Internal links inserted using Google SEO Guidelines! (${articleCount} articles scanned)`,
                false,
            );
        } catch (e) {
            const elapsed = ((Date.now() - startTime) / 1000).toFixed(1);
            addConsoleLog("ERROR", `Auto-linking FAILED after ${elapsed}s`, e);
            addConsoleLog(
                "SYSTEM",
                "━━━ Auto-Link Session Ended with Errors ━━━",
            );
            notify(
                "icon",
                "Auto-Link Failed",
                "Error: " + e.message + " — Console Logs देखें",
                true,
            );
        } finally {
            btn.innerHTML = origText;
            btn.disabled = false;
            hideUploadSpinner();
        }
    }

