                        <textarea
                            id="metaDesc"
                            rows="2"
                            
                            class="w-full border border-[#cbd5e1] rounded-lg px-3 py-2 text-sm focus:border-[#1a73e8] focus:outline-none resize-none"
                            required></textarea>
                    </div>
                    <!-- NEW: AI Summary -->
                    <div>
                        <label
                            class="text-[11px] font-semibold uppercase tracking-wider text-[#64748b] mb-1 flex justify-between items-center"
                        >
                            <span>AI Summary</span>
                            <span
                                class="text-[10px] text-indigo-500 bg-indigo-50 px-2 py-0.5 rounded-full font-bold"
                                >New</span
                            >
                        </label>
                        <textarea
                            id="metaAiSummary"
                            rows="2"
                            
                            class="w-full border border-[#cbd5e1] rounded-lg px-3 py-2 text-sm focus:border-[#1a73e8] focus:outline-none resize-none"
                        ></textarea>
                    </div>
                    <!-- Category & Tags -->
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label
                                class="text-[11px] font-semibold uppercase tracking-wider text-[#64748b] mb-1 block"
