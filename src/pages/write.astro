                                class="w-full border border-[#cbd5e1] rounded-lg px-3 py-2 text-sm bg-slate-50 text-[#64748b] cursor-not-allowed"
                            />
                        </div>
                        <div>
                            <label
                                class="text-[11px] font-semibold uppercase tracking-wider text-[#64748b] mb-1 block"
                                >Hero Image Caption</label
                            >
                            <input
                                type="text"
                                id="metaImageCaption"
                                
                                class="w-full border border-[#cbd5e1] rounded-lg px-3 py-2 text-sm focus:border-[#1a73e8] focus:outline-none"
                            />
                        </div>
                    </div>
                    <!-- Hero Image URL -->
                    <div>
                        <label
                            class="text-[11px] font-semibold uppercase tracking-wider text-[#64748b] mb-1 block"
