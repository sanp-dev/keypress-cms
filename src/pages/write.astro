<script is:inline>
    // ── Blogger Mobile Redesign JavaScript ──
    document.addEventListener(
        "DOMContentLoaded",
        (function () {
            const mobileQuery = window.matchMedia("(max-width: 767px)");
            function isMobile() {
                return mobileQuery.matches;
            }

            // Hide dashboard header on mobile write page
            if (isMobile()) {
                const dh = document.getElementById("dashboardHeader");
                if (dh) dh.style.display = "none";
                // Also remove padding from main
                const mainEl = document.querySelector("main");
                if (mainEl) {
                    mainEl.style.padding = "0";
                    mainEl.style.paddingBottom = "0";
                    mainEl.style.overflow = "hidden";
                    mainEl.style.display = "flex";
                    mainEl.style.flexDirection = "column";
                }
            }

            window.openContentSourcePopup = function () {
                if (!isMobile()) return;
                const popup = document.getElementById(
                    "mobileContentSourcePopup",
                );
                const section = document.getElementById("sectionContentSource");
                const body = popup ? popup.querySelector(".popup-body") : null;
                if (section && body) {
                    body.appendChild(section);
                    section.style.display = "";
                }
                if (popup) popup.classList.add("active");
            };

            window.closeContentSourcePopup = function () {
                const popup = document.getElementById(
                    "mobileContentSourcePopup",
                );
                const section = document.getElementById("sectionContentSource");
                const sidebar = document.getElementById("rightSidebarPanel");
                if (section && sidebar) {
                    sidebar.insertBefore(section, sidebar.firstChild);
                }
                if (popup) popup.classList.remove("active");
            };

            window.openSettingsPanel = function () {
                if (!isMobile()) return;
                const panel = document.getElementById("mobileSettingsPanel");
                const backdrop = document.getElementById(
                    "mobileOverlayBackdrop",
                );
                const panelBody = panel
                    ? panel.querySelector(".panel-body")
                    : null;

                if (!panel || !backdrop || !panelBody) return;

                // Move sidebar sections into panel
                [
                    "sectionImageManager",
                    "sectionSeo",
                    "sectionPublishActions",
                ].forEach((id) => {
                    const el = document.getElementById(id);
                    if (el) {
                        // Wrap in accordion section
                        let wrapper = document.getElementById(
                            "mobileWrap_" + id,
                        );
                        if (!wrapper) {
                            wrapper = document.createElement("div");
                            wrapper.id = "mobileWrap_" + id;
                            wrapper.className =
                                "mobile-settings-section expanded";

                            const titles = {
                                sectionImageManager:
                                    '<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg> IMAGE MANAGER',
                                sectionSeo:
                                    '<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg> SEO AND METADATA',
                                sectionPublishActions:
                                    '<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg> PUBLISH ACTIONS',
                            };

                            wrapper.innerHTML = `
                            <div class="mobile-settings-section-header" onclick="this.parentElement.classList.toggle('expanded')">
                                <h4 class="flex items-center gap-2">${titles[id] || id}</h4>
                                <svg class="chevron" viewBox="0 0 24 24" fill="currentColor" style="width:20px;height:20px;"><path d="M7 10l5 5 5-5z"/></svg>
                            </div>
                            <div class="mobile-settings-section-body"></div>
                        `;
                            panelBody.appendChild(wrapper);
                        }

                        const sectionBody = wrapper.querySelector(
                            ".mobile-settings-section-body",
                        );
                        if (sectionBody) {
                            sectionBody.appendChild(el);
                        }
                        el.style.display = "";
                        // Remove card styling on mobile
                        el.style.border = "none";
                        el.style.borderRadius = "0";
                        el.style.boxShadow = "none";
                        el.style.padding = "0";
                    }
                });

                // Show panel
                panel.style.display = "flex";
                backdrop.classList.add("active");
                requestAnimationFrame(() => {
                    panel.classList.add("active");
                });
            };

            window.closeSettingsPanel = function () {
                const panel = document.getElementById("mobileSettingsPanel");
                const backdrop = document.getElementById(
                    "mobileOverlayBackdrop",
                );
                if (!panel || !backdrop) return;

                panel.classList.remove("active");
                backdrop.classList.remove("active");

                // Move sections back to sidebar after transition
                setTimeout(() => {
                    const sidebar =
                        document.getElementById("rightSidebarPanel");
                    [
                        "sectionImageManager",
                        "sectionSeo",
                        "sectionPublishActions",
                    ].forEach((id) => {
                        const el = document.getElementById(id);
                        if (el && sidebar) {
                            // Restore card styling
                            el.style.border = "";
                            el.style.borderRadius = "";
                            el.style.boxShadow = "";
                            el.style.padding = "";
                            sidebar.appendChild(el);
                        }
                    });
                    panel.style.display = "none";
                }, 300);
            };

            window.togglePencilDropdown = function () {
                const menu = document.getElementById("pencilDropdownMenu");
                if (menu) menu.classList.toggle("hidden");
            };

            window.toggleMobileConsole = function () {
                const consoleTab = document.querySelector('.tab-btn[data-target="consoleView"]');
                const composeTab = document.querySelector('.tab-btn[data-target="composeView"]');
                const consoleView = document.getElementById('consoleView');
                const btn = document.getElementById('mobileConsoleBtn');
                
                if (consoleView && !consoleView.classList.contains('hidden')) {
                    // Switch back to compose view
                    if (composeTab) composeTab.click();
                    if (btn) btn.classList.remove('bg-amber-50', 'text-amber-600', 'border-amber-200');
                } else {
                    // Switch to console view
                    if (consoleTab) consoleTab.click();
                    if (btn) btn.classList.add('bg-amber-50', 'text-amber-600', 'border-amber-200');
                }
            };

            // Close dropdown when clicking outside
            document.addEventListener("click", function (e) {
                const dropdown = document.getElementById(
                    "mobilePencilDropdown",
                );
                const menu = document.getElementById("pencilDropdownMenu");
                if (dropdown && menu && !dropdown.contains(e.target)) {
                    menu.classList.add("hidden");
                }
            });

            // Pencil dropdown option click → switch editor view
            document.querySelectorAll(".pencil-option").forEach((btn) => {
                btn.addEventListener("click", function () {
                    const target = this.dataset.target;
                    const tabBtn = document.querySelector(
                        `.tab-btn[data-target="${target}"]`,
                    );
                    if (tabBtn) tabBtn.click();

                    // Update the icon shown in the dropdown button dynamically
                    const btnIcon = this.querySelector("svg");
                    const currentIconContainer =
                        document.getElementById("pencilIconCurrent");
                    if (btnIcon && currentIconContainer) {
                        currentIconContainer.innerHTML = btnIcon.outerHTML;
                    }

                    // Reset mobile console button highlight
                    const consoleBtn = document.getElementById('mobileConsoleBtn');
                    if (consoleBtn) consoleBtn.classList.remove('bg-amber-50', 'text-amber-600', 'border-amber-200');

                    document
                        .getElementById("pencilDropdownMenu")
                        ?.classList.add("hidden");
                });
            });

            window.showMobilePublishConfirm = function () {
                document
                    .getElementById("mobilePublishConfirm")
                    ?.classList.add("active");
            };

            window.hideMobilePublishConfirm = function () {
                document
                    .getElementById("mobilePublishConfirm")
                    ?.classList.remove("active");
            };

            window.confirmMobilePublish = function () {
                hideMobilePublishConfirm();
                const publishBtn = document.getElementById("publishBtn");
                if (publishBtn) publishBtn.click();
            };

            // Button event bindings
            document
                .getElementById("mobileAiBtn")
                ?.addEventListener("click", window.openContentSourcePopup);

            document
                .getElementById("mobileSaveBtn")
                ?.addEventListener("click", function () {
                    const saveDraftBtn =
                        document.getElementById("btnSaveDraft") ||
                        document.getElementById("btnSaveDraftHeader");
                    if (saveDraftBtn) saveDraftBtn.click();
                });

            document
                .getElementById("mobilePublishBtn")
                ?.addEventListener("click", window.showMobilePublishConfirm);

            document
                .getElementById("pencilDropdownBtn")
                ?.addEventListener("click", function (e) {
                    e.stopPropagation();
                    window.togglePencilDropdown();
                });

            document
                .getElementById("mobileSettingsGearBtn")
                ?.addEventListener("click", window.openSettingsPanel);
            document
                .getElementById("closeContentSourcePopup")
                ?.addEventListener("click", window.closeContentSourcePopup);
            document
                .getElementById("closeSettingsPanel")
                ?.addEventListener("click", window.closeSettingsPanel);
            document
                .getElementById("mobileOverlayBackdrop")
                ?.addEventListener("click", window.closeSettingsPanel);
            document
                .getElementById("mobilePublishCancel")
                ?.addEventListener("click", window.hideMobilePublishConfirm);
            document
                .getElementById("mobilePublishOk")
                ?.addEventListener("click", window.confirmMobilePublish);
        })(),
    );

    // ── Auto-resize title textarea ──
    function autoResizeTitle(el) {
        el.style.height = "auto";
        el.style.height = el.scrollHeight + "px";
    }
    // Run once on load (for draft-restored titles)
    window.addEventListener("DOMContentLoaded", function () {
        const t = document.getElementById("postTitle");
        if (t) autoResizeTitle(t);
