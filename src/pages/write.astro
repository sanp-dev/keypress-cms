                        >
                        <input
                            type="text"
                            id="imgAltText"
                            
                            class="w-full border border-[#cbd5e1] rounded-lg px-3 py-2 text-sm focus:border-[#1a73e8] focus:outline-none mb-3"
                        />

                        <label
                            class="text-[11px] font-semibold uppercase tracking-wider text-[#64748b] mb-1 block"
                            >Title Text</label
                        >
                        <input
                            type="text"
                            id="imgTitleText"
                            
                            class="w-full border border-[#cbd5e1] rounded-lg px-3 py-2 text-sm focus:border-[#1a73e8] focus:outline-none mb-3"
                        />

                        <label
                            class="text-[11px] font-semibold uppercase tracking-wider text-[#64748b] mb-1 block"
                            >Caption (optional)</label
                        >
                        <input
                            type="text"
                            id="imgCaption"
                            
                            class="w-full border border-[#cbd5e1] rounded-lg px-3 py-2 text-sm focus:border-[#1a73e8] focus:outline-none"
                        />
                    </div>

                    <div class="relative z-[90]">
                        <label
                            class="text-[11px] font-semibold uppercase tracking-wider text-[#64748b] mb-2 block"
                            >Insert Image From</label
                        >
                        <select
                            id="imgSourceSelect"
                            onmousedown="saveSelectionRange()"
                            onchange="if(this.value){ openImageModal(this.value,'body'); this.value=''; syncDropdownSkin('imgSourceSelect'); }"
                            class="relative z-[90] w-full border border-[#cbd5e1] rounded-lg px-3 py-2.5 text-sm font-semibold text-[#1e293b] focus:border-[#1a73e8] focus:outline-none bg-[#f8fafc] cursor-pointer mb-3"
                        >
                            <option value="" disabled selected
                                >Select Image Source...</option
                            >
                            <option value="unsplash">UNSPLASH</option>
                            <option value="pexels">PEXELS</option>
                            <option value="pixabay">PIXABAY</option>
                            <option value="cfflux">CF FLUX AI</option>
                        </select>

                        <div>
                            <input
                                type="file"
                                id="uploadFileInput"
                                accept="image/jpeg,image/png,image/webp,image/gif"
                                class="hidden"
                                onchange="handleLocalUpload()"
                            />
                            <button
                                type="button"
                                onclick="document.getElementById('uploadFileInput').click()"
                                class="w-full border border-dashed border-[#cbd5e1] rounded-lg py-2 text-xs font-medium text-[#64748b] hover:border-[#1a73e8] hover:text-[#1a73e8] transition-colors flex items-center justify-center gap-2"
                            >
                                <svg
                                    class="w-4 h-4"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
                                    ></path></svg
                                >
                                Upload from Device
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div
                id="sectionSeo"
                class="bg-white p-5 rounded-xl border border-[#e2e8f0] shadow-sm"
