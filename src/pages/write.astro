    // 3. FETCH & GENERATE (Content Source -> /api/fetch-source)
    async function fetchAndGenerate() {
        const payload = { source: currentSource };
        if (currentSource === "default_rss") {
            const cat = document.getElementById("rssCategory").value;
            if (!cat) {
                notify("icon", "Required", "Please select a category", true);
                return;
            }
            payload.cat = cat;
            payload.index = document.getElementById("rssIndex").value || 1;
            payload.newsCountry = document.getElementById("rssCountry").value;
        } else if (currentSource === "custom_rss") {
            payload.input = document
                .getElementById("customRssUrl")
                .value.trim();
            if (!payload.input) return;
        } else if (currentSource === "url") {
            payload.input = document.getElementById("articleUrl").value.trim();
            if (!payload.input) return;
        } else if (currentSource === "topic") {
            payload.input = document.getElementById("customTopic").value.trim();
            if (!payload.input) return;
        } else if (currentSource === "only_quiz") {
            payload.input = document
                .getElementById("onlyQuizTopic")
                .value.trim();
            if (!payload.input) return;
            payload.quizCount =
                document.getElementById("onlyQuizCount").value || 15;
        }

        if (currentSource !== "only_quiz") {
            payload.includeQuiz =
                document.getElementById("includeQuiz").checked;
            payload.quizTopic = document
                .getElementById("quizTopic")
                .value.trim();
            payload.quizCount =
                document.getElementById("quizCount").value || 10;

            payload.includeTable =
                document.getElementById("includeTable").checked;
            payload.tableTopic = document
                .getElementById("tableTopic")
                .value.trim();
        }

        const btn = document.getElementById("fetchSourceBtn");
        const statusEl = document.getElementById("fetchStatus");
        const originalText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = `<span class="flex items-center gap-2">${svgSpinner} Fetching and Generating...</span>`;
        btn.classList.add("opacity-75", "cursor-not-allowed");
        statusEl.innerHTML = "";

        addConsoleLog(
            "SYSTEM",
            `Initiating fetch for source: ${currentSource}`,
        );
        try {
            const res = await fetch("/api/fetch-source", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload),
            });
            const data = await res.json();

            if (data.logs && data.logs.length) {
                data.logs.forEach((log) => {
                    let logType = "INFO";
                    if (log.status === "SUCCESS") logType = "SUCCESS";
                    if (log.status === "FAILED") logType = "ERROR";
                    addConsoleLog(logType, `[${log.model}] ${log.message}`);
                });
            }

            if (!res.ok)
                throw new Error(data.error || "Fetch failed on the server.");
            document.getElementById("postTitle").value = data.title || "";
            autoResizeTitle(document.getElementById("postTitle"));
            document.getElementById("metaDesc").value =
                data.meta_description || "";
            document.getElementById("metaSlug").value = data.seo_slug || "";
            document.getElementById("metaCat").value = data.label || "";
            document.getElementById("metaTags").value = data.seo_tags || "";
            document.getElementById("metaAiSummary").value =
                data.ai_summary || "";

            document.getElementById("aiImgPrompt").value =
                data.image_prompt || "";
            document.getElementById("imgAltText").value = data.image_alt || "";
            document.getElementById("imgTitleText").value =
                data.image_title || data.image_alt || "";

            const enrichedContent = injectRichComponentStyles(
                data.content || "",
            );
            setEditorContent({ markdown: enrichedContent, triggerSave: true });
            document.querySelector('[data-target="composeView"]').click();
            if (data.original_article_url) {
                const link = document.getElementById("originalArticleLink");
                link.innerHTML = `Source: <a href="${data.original_article_url}" target="_blank" class="text-[#1a73e8] underline">${data.original_article_url}</a>`;
                link.classList.remove("hidden");
            }

            // Update counters after fetch
            updateTitleCounter();
            updateDescCounter();

            statusEl.innerHTML =
                '<span class="text-emerald-600 font-semibold flex items-center gap-1 mt-2"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Article generated successfully!</span>';
            addConsoleLog("SUCCESS", "Article mapped to UI completely.");
            notify(
                "icon",
                "AI Generation Success!",
                "Article generated from: " + currentSource,
            );
        } catch (error) {
            statusEl.innerHTML = `<span class="text-rose-600 font-semibold flex items-center gap-1 mt-2"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg> Fetch Failed</span>`;
            addConsoleLog(
                "ERROR",
                "Critical Failure during Fetch/Generate",
                error,
            );
            notify("icon", "Error Generating", error.message, true);
        } finally {
            btn.innerHTML = originalText;
            btn.classList.remove("opacity-75", "cursor-not-allowed");
            btn.disabled = false;
        }
    }

