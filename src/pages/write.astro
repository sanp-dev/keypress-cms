            if (!res.ok) throw new Error(data.error);
            insertImageIntoArticle(data.url, altText, data.width || 0, data.height || 0);
        } catch (e) {
            addConsoleLog("ERROR", "Failed to proxy/save stock image", e);
            notify("icon", "Error", e.message, true);
        } finally {
            hideUploadSpinner();
        }
