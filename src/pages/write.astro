    function escapeHtmlForHighlight(s) {
        return s
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");
    }

    const MD_INLINE_RE =
        /(?<bold>\*\*[^*\n]+\*\*|__[^_\n]+__)|(?<italic>\*[^*\n]+\*|_[^_\n]+_)|(?<code>`[^`\n]+`)|(?<image>!\[[^\]\n]*\]\([^)\n]*\))|(?<link>\[[^\]\n]*\]\([^)\n]*\))/g;

    function highlightMdInline(text) {
        let out = "",
            last = 0,
            m;
        MD_INLINE_RE.lastIndex = 0;
        while ((m = MD_INLINE_RE.exec(text))) {
            out += escapeHtmlForHighlight(text.slice(last, m.index));
            const g = m.groups;
            if (g.bold)
                out +=
                    '<span class="tok-md-bold">' +
                    escapeHtmlForHighlight(g.bold) +
                    "</span>";
            else if (g.italic)
                out +=
                    '<span class="tok-md-italic">' +
                    escapeHtmlForHighlight(g.italic) +
                    "</span>";
            else if (g.code)
                out +=
                    '<span class="tok-md-code">' +
                    escapeHtmlForHighlight(g.code) +
                    "</span>";
            else if (g.image)
                out +=
                    '<span class="tok-md-image">' +
                    escapeHtmlForHighlight(g.image) +
                    "</span>";
            else if (g.link)
                out +=
                    '<span class="tok-md-link">' +
                    escapeHtmlForHighlight(g.link) +
                    "</span>";
            last = MD_INLINE_RE.lastIndex;
        }
        out += escapeHtmlForHighlight(text.slice(last));
        return out;
    }

    function highlightMarkdown(raw) {
        const lines = raw.split("\n");
        let inFence = false;
        const out = lines.map((line) => {
            if (/^\s*```/.test(line)) {
                inFence = !inFence;
                return (
                    '<span class="tok-md-fence">' +
                    escapeHtmlForHighlight(line) +
                    "</span>"
                );
            }
            if (inFence)
                return (
                    '<span class="tok-md-codeblock">' +
                    escapeHtmlForHighlight(line) +
                    "</span>"
                );

            if (/^#{1,6}(\s.*)?$/.test(line))
                return (
                    '<span class="tok-md-heading">' +
                    escapeHtmlForHighlight(line) +
                    "</span>"
                );

            const quoteMatch = line.match(/^(\s*>+\s?)(.*)$/);
            if (quoteMatch)
                return (
                    '<span class="tok-md-quote">' +
                    escapeHtmlForHighlight(quoteMatch[1]) +
                    "</span>" +
                    highlightMdInline(quoteMatch[2])
                );

            const listMatch = line.match(/^(\s*)([-*+]|\d+\.)(\s+)(.*)$/);
            if (listMatch)
                return (
                    escapeHtmlForHighlight(listMatch[1]) +
                    '<span class="tok-md-list">' +
                    escapeHtmlForHighlight(listMatch[2]) +
                    "</span>" +
                    escapeHtmlForHighlight(listMatch[3]) +
                    highlightMdInline(listMatch[4])
                );

            return highlightMdInline(line);
        });
        return out.join("\n");
    }

    const HTML_TOKEN_RE =
        /(?<comment><!--[\s\S]*?-->)|(?<doctype><!DOCTYPE[^>]*>)|(?<tagopen><\/?[a-zA-Z][\w:-]*)|(?<attrname>[a-zA-Z_:][\w:-]*)(?=\s*=\s*["'])|(?<attrvalue>=\s*"[^"]*"|=\s*'[^']*')|(?<entity>&[a-zA-Z#0-9]+;)/gi;

    function highlightHTML(raw) {
        let out = "",
            last = 0,
            m;
        HTML_TOKEN_RE.lastIndex = 0;
        while ((m = HTML_TOKEN_RE.exec(raw))) {
            out += escapeHtmlForHighlight(raw.slice(last, m.index));
            const g = m.groups;
            if (g.comment)
                out +=
                    '<span class="tok-html-comment">' +
                    escapeHtmlForHighlight(g.comment) +
                    "</span>";
            else if (g.doctype)
                out +=
                    '<span class="tok-html-doctype">' +
                    escapeHtmlForHighlight(g.doctype) +
                    "</span>";
            else if (g.tagopen)
                out +=
                    '<span class="tok-html-tag">' +
                    escapeHtmlForHighlight(g.tagopen) +
                    "</span>";
            else if (g.attrname)
                out +=
                    '<span class="tok-html-attr">' +
                    escapeHtmlForHighlight(g.attrname) +
                    "</span>";
            else if (g.attrvalue)
                out +=
                    '<span class="tok-html-value">' +
                    escapeHtmlForHighlight(g.attrvalue) +
                    "</span>";
            else if (g.entity)
                out +=
                    '<span class="tok-html-entity">' +
                    escapeHtmlForHighlight(g.entity) +
                    "</span>";
            last = HTML_TOKEN_RE.lastIndex;
        }
        out += escapeHtmlForHighlight(raw.slice(last));
        return out;
    }

    function attachSyntaxOverlay(textarea, overlayId, highlightFn) {
        const overlay = document.getElementById(overlayId);
        const code = overlay.querySelector("code");
        let lastValue = null;
        function tick() {
            if (textarea.value !== lastValue) {
                lastValue = textarea.value;
                code.innerHTML = highlightFn(lastValue);
            }
            overlay.scrollTop = textarea.scrollTop;
            overlay.scrollLeft = textarea.scrollLeft;
            overlay.style.display = textarea.classList.contains("hidden")
                ? "none"
                : "block";
            requestAnimationFrame(tick);
        }
        tick();
    }

