<script>
(function(){
  function initSmartAdviceQuiz(){
    document.querySelectorAll(".tsa-quiz-wrap").forEach(function(wrap) {
      if (wrap._tsaInit) return;
      wrap._tsaInit = true;

      const options = wrap.querySelectorAll(".tsa-option");
      const progressBar = wrap.querySelector(".tsa-progress-bar");
      const percentage = wrap.querySelector(".tsa-percentage");
      const attemptedCount = wrap.querySelector("#tsa-attemptedCount");
      const correctCount = wrap.querySelector("#tsa-correctCount");
      const wrongCount = wrap.querySelector("#tsa-wrongCount");
      const message = wrap.querySelector("#tsa-message");
      const resetButton = wrap.querySelector(".tsa-reset-btn");

      if (options.length === 0) return;

      const totalQuestions = new Set(Array.from(options).map(opt => opt.getAttribute("data-question"))).size;
      let attempted = 0;
      let correct = 0;

      options.forEach(opt => {
        let newOpt = opt.cloneNode(true);
        opt.parentNode.replaceChild(newOpt, opt);

        newOpt.addEventListener("click", function() {
          const qId = this.getAttribute("data-question");
          const isCorrect = this.getAttribute("data-correct") === "true";
          const siblingOpts = wrap.querySelectorAll(".tsa-option[data-question=\"" + qId + "\"]");

          const alreadyAnswered = Array.from(siblingOpts).some(o => o.classList.contains("tsa-answered"));
          if (alreadyAnswered) return;

          attempted++;
          siblingOpts.forEach(o => o.classList.add("tsa-answered"));

          if (isCorrect) {
            correct++;
            this.classList.add("tsa-correct");
          } else {
            this.classList.add("tsa-wrong");
            siblingOpts.forEach(o => {
              if (o.getAttribute("data-correct") === "true") {
                o.classList.add("tsa-correct");
              }
            });
          }

          const exp = wrap.querySelector(".tsa-exp[data-question=\"" + qId + "\"]");
          if (exp) exp.style.display = "block";

          if (attemptedCount) attemptedCount.textContent = attempted;
          if (correctCount) correctCount.textContent = correct;
          if (wrongCount) wrongCount.textContent = attempted - correct;

          if (progressBar && percentage) {
            const pct = (attempted / totalQuestions) * 100;
            progressBar.style.width = pct + "%";
            percentage.textContent = Math.round(pct) + "%";
          }

          if (attempted === totalQuestions && message) {
            if (correct === totalQuestions) {
              message.textContent = "CONGRATULATIONS! YOU GOT ALL CORRECT!";
            } else if (correct >= totalQuestions / 2) {
              message.textContent = "GREAT JOB! YOU'RE DOING WELL!";
            } else {
              message.textContent = "KEEP PRACTICING. YOU CAN IMPROVE!";
            }
          }
        });
      });

      if (resetButton) {
        let newReset = resetButton.cloneNode(true);
        resetButton.parentNode.replaceChild(newReset, resetButton);

        newReset.addEventListener("click", function() {
          wrap.querySelectorAll(".tsa-option").forEach(o => {
            o.classList.remove("tsa-correct", "tsa-wrong", "tsa-answered");
          });
          wrap.querySelectorAll(".tsa-exp").forEach(e => {
            e.style.display = "none";
          });

          attempted = 0;
          correct = 0;

          if (attemptedCount) attemptedCount.textContent = "0";
          if (correctCount) correctCount.textContent = "0";
          if (wrongCount) wrongCount.textContent = "0";
          if (progressBar) progressBar.style.width = "0%";
          if (percentage) percentage.textContent = "0%";
          if (message) message.textContent = "PRACTICE REGULARLY!";
        });
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSmartAdviceQuiz);
  } else {
    initSmartAdviceQuiz();
  }
})();{
    document.addEventListener("DOMContentLoaded", initSmartAdviceQuiz);
  } else {
    initSmartAdviceQuiz();
  }
})();
<\/script>`;

    // ─── insertRichBlock: Toolbar Table/Video insertion ───────────────────────
    window.insertRichBlock = function (blockContent, cssMarker, cssBlock) {
        const activeTabBtn = document.querySelector(".tab-btn.active");
        const activeTarget = activeTabBtn
            ? activeTabBtn.getAttribute("data-target")
            : "composeView";

        function ensureCSS(content) {
            if (!cssMarker || !cssBlock) return content;
            if (content.includes(cssMarker)) return content;
            return cssBlock + "\n\n" + content;
        }

        if (activeTarget === "composeView") {
            composeView.focus();
            const sel = window.getSelection();
            if (sel && sel.rangeCount) {
                const range = sel.getRangeAt(0);
                range.deleteContents();
                const frag = document
                    .createRange()
                    .createContextualFragment(blockContent);
                range.insertNode(frag);
                range.collapse(false);
                sel.removeAllRanges();
                sel.addRange(range);
            } else {
                composeView.innerHTML += blockContent;
            }
            syncFromEditor(EDITOR_SYNC_SOURCE.COMPOSE, true);
            const currentMd = markdownView.value || "";
            if (cssMarker && cssBlock && !currentMd.includes(cssMarker)) {
                setEditorContent({
                    markdown: cssBlock + "\n\n" + currentMd,
                    triggerSave: true,
                });
            }
        } else if (activeTarget === "markdownView") {
            const ta = markdownView;
            const start = ta.selectionStart ?? ta.value.length;
            const val = ta.value;
            const insert = "\n\n" + blockContent.trim() + "\n\n";
            ta.value = ensureCSS(
                val.slice(0, start) + insert + val.slice(start),
            );
            ta.selectionStart = ta.selectionEnd = start + insert.length;
            syncFromEditor(EDITOR_SYNC_SOURCE.MARKDOWN, true);
        } else {
            const ta = htmlView;
            const start = ta.selectionStart ?? ta.value.length;
            const val = ta.value;
            const insert = "\n\n" + blockContent.trim() + "\n\n";
            ta.value = ensureCSS(
                val.slice(0, start) + insert + val.slice(start),
            );
            ta.selectionStart = ta.selectionEnd = start + insert.length;
            syncFromEditor(EDITOR_SYNC_SOURCE.HTML, true);
        }
    };

    // ─── toggleTableCSS: Manual toggle of Table CSS Stylesheet ──────────────────
    window.toggleTableCSS = function () {
        const activeTabBtn = document.querySelector(".tab-btn.active");
        const activeTarget = activeTabBtn
            ? activeTabBtn.getAttribute("data-target")
            : "composeView";

        const cssMarker = "<!-- rs-table-styles -->";
        const cssBlock = window._TABLE_CSS;

        if (activeTarget === "composeView") {
            const currentHtml = composeView.innerHTML || "";
            // In Compose HTML view, check for a style block containing rs-table-wrap
            const styleEl = composeView.querySelector("style");
            if (styleEl && styleEl.textContent.includes(".rs-table-wrap")) {
                styleEl.remove();
                addConsoleLog("INFO", "Table CSS removed from Compose view.");
            } else {
                composeView.innerHTML = cssBlock + "\n\n" + currentHtml;
                addConsoleLog("SUCCESS", "Table CSS injected into Compose view.");
            }
            syncFromEditor(EDITOR_SYNC_SOURCE.COMPOSE, true);
        } else if (activeTarget === "markdownView") {
            const ta = markdownView;
            const currentMd = ta.value || "";
            if (currentMd.includes(cssMarker)) {
                ta.value = currentMd.replace(cssBlock + "\n\n", "").replace(cssBlock, "");
                addConsoleLog("INFO", "Table CSS removed from Markdown view.");
            } else {
                ta.value = cssBlock + "\n\n" + currentMd;
                addConsoleLog("SUCCESS", "Table CSS injected into Markdown view.");
            }
            syncFromEditor(EDITOR_SYNC_SOURCE.MARKDOWN, true);
        } else {
            const ta = htmlView;
            const currentHtml = ta.value || "";
            if (currentHtml.includes(cssMarker)) {
                ta.value = currentHtml.replace(cssBlock + "\n\n", "").replace(cssBlock, "");
                addConsoleLog("INFO", "Table CSS removed from HTML view.");
            } else {
                ta.value = cssBlock + "\n\n" + currentHtml;
                addConsoleLog("SUCCESS", "Table CSS injected into HTML view.");
            }
            syncFromEditor(EDITOR_SYNC_SOURCE.HTML, true);
        }
    };

    // ─── Client-side Rich Component Style Injector ────────────────────────────
    function hasMCQ(content) {
        return (
            /##\s+Test Your Knowledge/i.test(content) ||
            /##\s+MCQ|##\s+Quiz|##\s+Multiple.?Choice/i.test(content) ||
            /tsa-quiz-wrap/i.test(content)
        );
    }
    function hasTable(content) {
        return /\|.+\|.+\|/.test(content) || /<table[\s>]/i.test(content);
    }
    function hasVideo(content) {
        return (
            /tsa-video-wrap/i.test(content) ||
            /data-src="https?:\/\//i.test(content)
        );
    }

    function convertMCQMarkdownToHTML(markdown) {
        const sectionMatch = markdown.match(
            /([\s\S]*?)(##\s+(?:Test Your Knowledge.*?|MCQs?|Quiz.*?|Multiple.?Choice.*?)\n)([\s\S]*)/i,
        );
        if (!sectionMatch) return markdown;

        const beforeSection = sectionMatch[1];
        const sectionHeading = sectionMatch[2].trim();
        const quizBody = sectionMatch[3];

        const questionBlocks = quizBody.split(
            /\n(?=###\s+Q?\d+\.?|(?:\*\*)?\d+[\.\)]\s)/,
        );
        const questionHTMLs = [];

        questionBlocks.forEach(function (block, qIdx) {
            if (!block.trim()) return;

            const lines = block.trim().split("\n");
            let questionText = lines[0]
                .replace(/^###\s+/, "")
                .replace(/^\*\*\d+[\.\)]\*\*\s*/, "")
                .replace(/^\d+[\.\)]\s*/, "")
                .replace(/\*\*/g, "")
                .trim();

            if (!questionText) return;

            const options = [];
            let explanation = "";

            for (let i = 1; i < lines.length; i++) {
                const line = lines[i].trim();
                if (!line) continue;

                if (/^Explanation[:\s]/i.test(line)) {
                    explanation = line
                        .replace(/^Explanation[:\s]*/i, "")
                        .trim();
                    while (
                        i + 1 < lines.length &&
                        !lines[i + 1].trim().match(/^[A-D][\)\.]|\*\*[A-D]/)
                    ) {
                        i++;
                        if (lines[i].trim())
                            explanation += " " + lines[i].trim();
                        else break;
                    }
                    continue;
                }

                const optMatch = line.match(
                    /^-?\s*\*?\*?([A-Da-d])[\.\)]\*?\*?\s*(.*)/,
                );
                if (optMatch) {
                    const letter = optMatch[1].toUpperCase();
                    const isCorrect =
                        /\*\*[A-Da-d][\.\)]/.test(line) ||
                        /\*\*.*\*\*/.test(line);
                    const text = optMatch[2].replace(/\*\*/g, "").trim();
                    if (text) options.push({ letter, text, isCorrect });
                }
            }

            if (options.length < 2) return;

            const qId = `tsa-q-${qIdx + 1}`;

            const optsHTML = options
                .map(function (opt) {
                    return `<div class="tsa-option" data-correct="${opt.isCorrect}" data-question="${qId}" role="button" tabindex="0">
        ${opt.letter}) ${opt.text}
      </div>`;
                })
                .join("\n");

            const expHTML = explanation
                ? `<div class="tsa-exp" data-question="${qId}"><b>EXPLANATION:</b> ${explanation}</div>`
                : "";

            questionHTMLs.push(`
<div class="tsa-question" id="${qId}">
    <b>Q. ${qIdx + 1}:</b> ${questionText}
</div>
${optsHTML}
${expHTML}
<hr class="tsa-divider" />`);
        });

        if (questionHTMLs.length === 0) return markdown;

        const quizHTML = `\n\n<div class="tsa-quiz-wrap">
<h2 class="tsa-quiz-header">${sectionHeading.replace(/^#+\s*/, "").trim()}</h2>

<div class="tsa-progress-container">
    <div class="tsa-percentage">0%</div>
    <div class="tsa-progress-bar" id="tsa-progressBar"></div>
</div>
<hr class="tsa-divider" />

${questionHTMLs.join("\n")}

<button class="tsa-reset-btn" id="tsa-resetButton">RESET</button>

<div class="tsa-report-card">
    <h3>Report Card</h3>
    <div class="tsa-stats-grid">
        <div class="tsa-stat-item">
            <span class="tsa-stat-icon"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="2" width="14" height="20" rx="2.5" fill="#dbeafe" stroke="#60a5fa" stroke-width="1.2"/><path d="M7 7h6M7 11h6M7 15h4" stroke="#60a5fa" stroke-width="1.2" stroke-linecap="round"/><rect x="7" y="1" width="6" height="3" rx="1" fill="#93bbfd" stroke="#60a5fa" stroke-width="0.8"/></svg></span>
            <span class="tsa-stat-value" id="tsa-attemptedCount">0</span>
            <span class="tsa-stat-label">Attempted</span>
        </div>
        <div class="tsa-stat-item">
            <span class="tsa-stat-icon"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9.5" fill="#dcfce7" stroke="#4ade80" stroke-width="1.2"/><path d="M8 12.5l2.5 2.5L16 9.5" stroke="#22c55e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="tsa-stat-value tsa-val-correct" id="tsa-correctCount">0</span>
            <span class="tsa-stat-label">Correct</span>
        </div>
        <div class="tsa-stat-item">
            <span class="tsa-stat-icon"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9.5" fill="#fee2e2" stroke="#f87171" stroke-width="1.2"/><path d="M9 9l6 6M15 9l-6 6" stroke="#ef4444" stroke-width="1.8" stroke-linecap="round"/></svg></span>
            <span class="tsa-stat-value tsa-val-wrong" id="tsa-wrongCount">0</span>
            <span class="tsa-stat-label">Wrong</span>
        </div>
    </div>
    <span id="tsa-message">PRACTICE REGULARLY!</span>
</div>
</div>\n\n`;

        return beforeSection + quizHTML;
    }

    function wrapMarkdownTables(content) {
        return content.replace(
            /((?:^|\n)(\|[^\n]+\|\n)((?:\|[-: ]+\|[-: |]*\n))((?:\|[^\n]+\|\n?)+))/gm,
            function (match) {
                return (
                    '\n\n<div class="tsa-table-wrap">\n\n' +
                    match.trim() +
                    "\n\n</div>\n\n"
                );
            },
        );
    }

    function injectRichComponentStyles(content) {
        let enriched = content;
        if (hasMCQ(enriched)) enriched = convertMCQMarkdownToHTML(enriched);
        if (hasTable(enriched)) enriched = wrapMarkdownTables(enriched);
        let styleSuffix = "";
        if (hasMCQ(enriched) && !enriched.includes("<!-- tsa-mcq-styles -->"))
            styleSuffix += "\n\n" + window._MCQ_CSS;
        if (
            hasTable(enriched) &&
            !enriched.includes("<!-- tsa-table-styles -->")
        )
            styleSuffix += "\n\n" + window._TABLE_CSS;
        if (
            hasVideo(enriched) &&
            !enriched.includes("<!-- tsa-video-styles -->")
        )
            styleSuffix += "\n\n" + window._VIDEO_CSS;
        return enriched + styleSuffix;
    }

    // Utility: Real Console Logger
    function addConsoleLog(type, message, details = null) {
        if (!consoleLogContainer) return;
        const time = new Date().toLocaleTimeString();
        let colorStr = "text-slate-400";
        if (type === "ERROR") colorStr = "text-rose-500 font-bold";
        if (type === "SUCCESS") colorStr = "text-emerald-400 font-bold";
        if (type === "SYSTEM") colorStr = "text-blue-400";
        if (type === "INFO") colorStr = "text-sky-400";

        let detailHtml = "";
        if (details) {
            let detailStr =
                details instanceof Error
                    ? details.stack || details.message
                    : typeof details === "object"
                      ? JSON.stringify(details, null, 2)
                      : details;
            detailHtml = `<div class="mt-1 pl-2 border-l-2 border-slate-700 text-[11px] text-slate-500 whitespace-pre-wrap break-all">${escapeAttr(detailStr)}</div>`;
        }

        consoleLogContainer.innerHTML += `
            <div class="mb-2">
                <span class="text-slate-600">[${time}]</span>
                <span class="${colorStr}">[${type}] ${escapeAttr(message)}</span>
                ${detailHtml}
            </div>`;
        if (consoleView) {
            consoleView.scrollTop = consoleView.scrollHeight;
        }
    }

    // Utility: Escape HTML Attributes/Text
    function escapeAttr(s) {
        return (s || "")
            .toString()
            .replace(/&/g, "&")
            .replace(/</g, "<")
            .replace(/>/g, ">")
            .replace(/'/g, "&#39;")
            .replace(/"/g, '"');
    }

    function markdownToHtml(markdown) {
        if (!markdown) return "";

        // Fallback for markdown-to-HTML conversion if `marked` library is not loaded
        if (!window.marked) {
            let html = markdown;
            // Basic Markdown to HTML conversion (headings, bold, italic, lists)
            html = html.replace(/^###### (.*$)/gim, "<h6>$1</h6>");
            html = html.replace(/^##### (.*$)/gim, "<h5>$1</h5>");
            html = html.replace(/^#### (.*$)/gim, "<h4>$1</h4>");
            html = html.replace(/^### (.*$)/gim, "<h3>$1</h3>");
            html = html.replace(/^## (.*$)/gim, "<h2>$1</h2>");
            html = html.replace(/^# (.*$)/gim, "<h1>$1</h1>");
            html = html.replace(/\*\*(.*?)\*\*/gim, "<strong>$1</strong>");
            html = html.replace(/__(.*?)__/gim, "<strong>$1</strong>");
            html = html.replace(/\*(.*?)\*/gim, "<em>$1</em>");
            html = html.replace(/_(.*?)_/gim, "<em>$1</em>");
            html = html.replace(/^- (.*$)/gim, "<li>$1</li>");
            html = html.replace(/^\d+\. (.*$)/gim, "<li>$1</li>");
            html = html.replace(/(<li>.*<\/li>)/gim, "<ul>$1</ul>"); // Simple list wrapper, might need more advanced parsing for nested lists.
            html = html.replace(/\n/g, "<br>"); // Convert newlines to <br> for basic formatting
            return html;
        }

        // Configure marked to pass raw HTML blocks through untouched
        // This is critical for mixed HTML+markdown content (e.g. <p class="csl">, <picture>, <details>)
        if (typeof marked.setOptions === "function") {
            marked.setOptions({ breaks: true });
        }
        return marked.parse(markdown);
    }

    const BLOCK_LEVEL_TAGS = new Set([
        "address",
        "article",
        "aside",
        "blockquote",
        "br",
        "dd",
        "div",
        "dl",
        "dt",
        "fieldset",
        "figcaption",
        "figure",
        "footer",
        "form",
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6",
        "header",
        "hr",
        "li",
        "main",
        "nav",
        "ol",
        "p",
        "pre",
        "section",
        "table",
        "tbody",
        "td",
        "tfoot",
        "th",
        "thead",
        "tr",
        "ul",
    ]);

    function isBlockLevelNode(node) {
        return !!(
            node &&
            node.nodeType === Node.ELEMENT_NODE &&
            BLOCK_LEVEL_TAGS.has(node.tagName.toLowerCase())
        );
    }

    function cleanupEditorDomWhitespace(root) {
        if (!root) return;

        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
        const textNodes = [];
        while (walker.nextNode()) textNodes.push(walker.currentNode);

        textNodes.forEach((node) => {
            const raw = node.textContent || "";
            if (!raw) {
                node.remove();
                return;
            }

            const parentTag = node.parentElement?.tagName?.toLowerCase();
            if (
                parentTag === "pre" ||
                parentTag === "code" ||
                parentTag === "textarea"
            )
                return;

            if (!raw.trim()) {
                const prev = node.previousSibling;
                const next = node.nextSibling;
                if (
                    !prev ||
                    !next ||
                    isBlockLevelNode(prev) ||
                    isBlockLevelNode(next) ||
                    isBlockLevelNode(node.parentElement)
                ) {
                    node.remove();
                } else {
                    node.textContent = " ";
                }
                return;
            }

            node.textContent = raw
                .replace(/\u00a0/g, " ")
                .replace(/[ \t\r\n]+/g, " ");
        });
    }

    function beautifyHTML(html) {
        const normalizedHtml = normalizeEditorHtml(html);
        if (!normalizedHtml) return "";

        const container = document.createElement("div");
        container.innerHTML = normalizedHtml;

        const inlineTags = new Set([
            "a",
            "abbr",
            "b",
            "code",
            "del",
            "em",
            "i",
            "img",
            "label",
            "mark",
            "small",
            "span",
            "strong",
            "sub",
            "sup",
            "u",
        ]);
        const selfClosingTags = new Set(["br", "hr", "img", "input", "source"]);

        const formatTextNode = (node) => {
            const parentTag = node.parentElement?.tagName?.toLowerCase();
            if (
                parentTag === "pre" ||
                parentTag === "code" ||
                parentTag === "script" ||
                parentTag === "style" ||
                parentTag === "textarea"
            ) {
                return node.textContent || "";
            }
            const text = (node.textContent || "").replace(/\u00a0/g, " ");
            return text.trim() ? text.replace(/[ \t\r\n]+/g, " ") : "";
        };

        const hasBlockDescendant = (element) => {
            return Array.from(element.children).some(
                (child) => !inlineTags.has(child.tagName.toLowerCase()),
            );
        };

        const formatNode = (node, level = 0) => {
            // Preserve HTML comment nodes
            if (node.nodeType === Node.COMMENT_NODE) {
                const indent = "  ".repeat(level);
                return `${indent}<!--${node.textContent}-->`;
            }

            if (node.nodeType === Node.TEXT_NODE) {
                return formatTextNode(node);
            }

            if (node.nodeType !== Node.ELEMENT_NODE) return "";

            const tag = node.tagName.toLowerCase();
            const indent = "  ".repeat(level);
            const attrs = Array.from(node.attributes)
                .map((attr) => ` ${attr.name}="${escapeAttr(attr.value)}"`)
                .join("");

            if (selfClosingTags.has(tag)) {
                return `${indent}<${tag}${attrs}>`;
            }

            const childNodes = Array.from(node.childNodes)
                .map((child) => formatNode(child, level + 1))
                .filter(Boolean);

            const onlyInlineChildren = !hasBlockDescendant(node);
            if (onlyInlineChildren) {
                const inlineContent = childNodes.join("").trim();
                return `${indent}<${tag}${attrs}>${inlineContent}</${tag}>`;
            }

            const nestedContent = childNodes.join("\n");
            return `${indent}<${tag}${attrs}>\n${nestedContent}\n${indent}</${tag}>`;
        };

        return Array.from(container.childNodes)
            .map((node) => formatNode(node, 0))
            .filter(Boolean)
            .join("\n")
            .trim();
    }

    function normalizeEditorHtml(html) {
        if (!html) return "";

        // ── Preserve HTML comments before DOM parsing ──────────────────────
        // container.innerHTML strips comment nodes, so we temporarily replace
        // them with placeholder <tsa-comment> elements, then restore after.
        const commentPlaceholders = [];
        let safeHtml = html.replace(/<!--([\s\S]*?)-->/g, (match, content) => {
            const idx = commentPlaceholders.length;
            commentPlaceholders.push(match);
            return `<tsa-comment data-idx="${idx}"></tsa-comment>`;
        });

        const container = document.createElement("div");
        container.innerHTML = safeHtml;

        // Remove script tags except those that are part of our rich components, schema markup, or manual code
        const scripts = container.querySelectorAll("script");
        scripts.forEach((script) => {
            const code = script.textContent || "";
            const type = script.getAttribute("type") || "";
            const isRichScript =
                code.includes("initQuiz") ||
                code.includes("initSmartAdviceQuiz") ||
                code.includes("initVideos") ||
                type === "application/ld+json" ||
                script.hasAttribute("src") ||
                code.trim().length > 0;
            if (!isRichScript) {
                script.remove();
            }
        });

        cleanupEditorDomWhitespace(container);

        // Restore HTML comments from placeholders
        let result = container.innerHTML.trim();
        result = result.replace(
            /<tsa-comment data-idx="(\d+)"><\/tsa-comment>/g,
            (match, idx) => commentPlaceholders[parseInt(idx)] || "",
        );
        return result;
    }

    function htmlToMarkdown(html) {
        if (!html) return "";
        const container = document.createElement("div");
        container.innerHTML = normalizeEditorHtml(html);

        const escapeMd = (text) =>
            (text || "").replace(/\u00a0/g, " ").replace(/[ \t]+\n/g, "\n");
        const wrapInlineMarkdown = (content, marker) => {
            const raw = content || "";
            const leading = raw.match(/^\s+/)?.[0] || "";
            const trailing = raw.match(/\s+$/)?.[0] || "";
            const core = raw.trim();

            if (!core) return raw;
            return `${leading}${marker}${core}${marker}${trailing}`;
        };

        // ── Smart HTML-Passthrough Detection ──────────────────────────────
        // Tags that should ALWAYS be preserved as raw HTML in markdown
        const ALWAYS_PASSTHROUGH_TAGS = new Set([
            "details",
            "summary",
            "style",
            "section",
            "aside",
            "nav",
            "footer",
            "header",
            "table",
            "thead",
            "tbody",
            "tfoot",
            "tr",
            "td",
            "th",
            "video",
            "audio",
            "iframe",
            "canvas",
            "svg",
            "math",
            "script",
        ]);

        // Check if an element has meaningful attributes (class, id, style, data-*, etc.)
        // that would be lost during markdown conversion
        function hasPreservableAttributes(node) {
            if (!node.attributes || node.attributes.length === 0) return false;
            // For <a> tags, href is expected and handled by markdown [text](url)
            if (node.tagName.toLowerCase() === "a") {
                // Only passthrough if it has attributes beyond href
                return Array.from(node.attributes).some(
                    (attr) => attr.name !== "href",
                );
            }
            // For <img> tags, src/alt/title are handled by markdown ![alt](src)
            if (node.tagName.toLowerCase() === "img") {
                return Array.from(node.attributes).some(
                    (attr) => !["src", "alt", "title"].includes(attr.name),
                );
            }
            return true;
        }

        // Determine if a node should be emitted as raw HTML passthrough
        function shouldPassthrough(node) {
            const tag = node.tagName.toLowerCase();
            if (ALWAYS_PASSTHROUGH_TAGS.has(tag)) return true;
            // <p>, <div>, <span> etc. with attributes (class, style, id, data-*)
            if (hasPreservableAttributes(node)) {
                // Inline formatting tags (strong, em, b, i) with no special attributes
                // should still convert to markdown bold/italic
                const inlineFormatTags = new Set([
                    "strong",
                    "b",
                    "em",
                    "i",
                    "del",
                    "s",
                ]);
                if (inlineFormatTags.has(tag)) return false;
                return true;
            }
            return false;
        }

        const walk = (node) => {
            // ── Preserve HTML comment nodes ──────────────────────────────
            if (node.nodeType === Node.COMMENT_NODE) {
                return `\n\n<!--${node.textContent}-->\n\n`;
            }

            if (node.nodeType === Node.TEXT_NODE) {
                const raw = node.textContent || "";
                if (!raw.trim()) {
                    const prev = node.previousSibling;
                    const next = node.nextSibling;
                    if (
                        !prev ||
                        !next ||
                        isBlockLevelNode(prev) ||
                        isBlockLevelNode(next) ||
                        isBlockLevelNode(node.parentElement)
                    ) {
                        return "";
                    }
                    return " ";
                }

                return escapeMd(raw).replace(/[ \t\r\n]+/g, " ");
            }
            if (node.nodeType !== Node.ELEMENT_NODE) return "";

            const tag = node.tagName.toLowerCase();

            // ── Restore comment placeholders from normalizeEditorHtml ─────
            if (tag === "tsa-comment") {
                // tsa-comment placeholders are already restored to real comments
                // by normalizeEditorHtml, but handle any leftover gracefully
                return "";
            }

            // Check if it is a rich component container or style/script
            const isRichContainer =
                node.classList.contains("tsa-quiz-wrap") ||
                node.classList.contains("tsa-table-wrap") ||
                node.classList.contains("tsa-video-wrap");
            const isRichStyle =
                tag === "style" &&
                (node.textContent.includes("tsa-quiz-wrap") ||
                    node.textContent.includes("tsa-table-wrap") ||
                    node.textContent.includes("tsa-video-wrap"));
            const isRichScript =
                tag === "script" &&
                (node.textContent.includes("initQuiz") ||
                    node.textContent.includes("initSmartAdviceQuiz") ||
                    node.textContent.includes("initVideos"));

            if (isRichContainer || isRichStyle || isRichScript) {
                if (node.classList.contains("tsa-quiz-wrap")) {
                    // Clone the node so we don't modify the live editor DOM
                    const cleanNode = node.cloneNode(true);

                    // 1. Remove all answered, correct, wrong classes from options
                    cleanNode.querySelectorAll(".tsa-option").forEach((opt) => {
                        opt.classList.remove(
                            "tsa-correct",
                            "tsa-wrong",
                            "tsa-answered",
                        );
                    });

                    // 2. Hide all explanation boxes
                    cleanNode.querySelectorAll(".tsa-exp").forEach((exp) => {
                        exp.style.display = "none";
                    });

                    // 3. Reset progress bar and percentage
                    const pBar = cleanNode.querySelector("#tsa-progressBar");
                    if (pBar) pBar.style.width = "0%";
                    const pPct = cleanNode.querySelector(".tsa-percentage");
                    if (pPct) pPct.textContent = "0%";

                    // 4. Reset attempted, correct, wrong counters
                    const attempted = cleanNode.querySelector(
                        "#tsa-attemptedCount",
                    );
                    if (attempted) attempted.textContent = "0";
                    const correct =
                        cleanNode.querySelector("#tsa-correctCount");
                    if (correct) correct.textContent = "0";
                    const wrong = cleanNode.querySelector("#tsa-wrongCount");
                    if (wrong) wrong.textContent = "0";

                    // 5. Reset report card message
                    const msg = cleanNode.querySelector("#tsa-message");
                    if (msg) msg.textContent = "PRACTICE REGULARLY!";

                    return `\n\n${cleanNode.outerHTML}\n\n`;
                }
                return `\n\n${node.outerHTML}\n\n`;
            }

            // ── Smart HTML Passthrough ────────────────────────────────────
            // Preserve elements that have attributes (class, style, id, data-*)
            // or belong to ALWAYS_PASSTHROUGH_TAGS as raw HTML
            if (shouldPassthrough(node)) {
                return `\n\n${node.outerHTML}\n\n`;
            }

            const children = Array.from(node.childNodes).map(walk).join("");
            const block = (content) => `\n\n${content.trim()}\n\n`;

            switch (tag) {
                case "h1":
                    return block(`# ${children}`);
                case "h2":
                    return block(`## ${children}`);
                case "h3":
                    return block(`### ${children}`);
                case "h4":
                    return block(`#### ${children}`);
                case "h5":
                    return block(`##### ${children}`);
                case "h6":
                    return block(`###### ${children}`);
                case "strong":
                case "b":
                    return wrapInlineMarkdown(children, "**");
                case "em":
                case "i":
                    return wrapInlineMarkdown(children, "*");
                case "del":
                case "s":
                    return wrapInlineMarkdown(children, "~~");
                case "u":
                    return `<u>${children}</u>`;
                case "a": {
                    const href = node.getAttribute("href") || "";
                    return href ? `[${children || href}](${href})` : children;
                }
                case "img": {
                    const src = node.getAttribute("src") || "";
                    const alt = node.getAttribute("alt") || "image";
                    const title = node.getAttribute("title");
                    return src
                        ? `\n\n![${alt}](${src}${title ? ` "${title}"` : ""})\n\n`
                        : "";
                }
                case "picture": {
                    return `\n\n${node.outerHTML}\n\n`;
                }
                case "source": {
                    // <source> inside <picture> is handled by picture's outerHTML.
                    // Standalone <source> should not appear, return empty safely.
                    return "";
                }
                case "blockquote":
                    return block(
                        children
                            .trim()
                            .split("\n")
                            .map((line) => `> ${line}`)
                            .join("\n"),
                    );
                case "li":
                    return `${children.trim()}\n`;
                case "ul":
                    return block(
                        Array.from(node.children)
                            .map((li) => `- ${walk(li).trim()}`)
                            .join("\n"),
                    );
                case "ol":
                    return block(
                        Array.from(node.children)
                            .map((li, i) => `${i + 1}. ${walk(li).trim()}`)
                            .join("\n"),
                    );
                case "br":
                    return "\n";
                case "p":
                case "div":
                case "figure":
                    return block(children);
                case "figcaption":
                    return children ? `*${children.trim()}*` : "";
                default:
                    return children;
            }
        };

        return Array.from(container.childNodes)
            .map(walk)
            .join("")
            .replace(/\n{3,}/g, "\n\n")
            .trim();
    }

    function getVisibleEditorSource() {
        const activeTab = document.querySelector(".tab-btn.active");
        const activeTarget = activeTab
            ? activeTab.getAttribute("data-target")
            : "composeView";

        if (activeTarget === "markdownView") return EDITOR_SYNC_SOURCE.MARKDOWN;
        if (activeTarget === "htmlView") return EDITOR_SYNC_SOURCE.HTML;
        return EDITOR_SYNC_SOURCE.COMPOSE;
    }

    function getEditorSnapshot(source = getVisibleEditorSource()) {
        if (source === EDITOR_SYNC_SOURCE.MARKDOWN) {
            return {
                source,
                markdown: markdownView.value || "",
                html: markdownToHtml(markdownView.value || ""),
            };
        }

        if (source === EDITOR_SYNC_SOURCE.HTML) {
            const rawHtml = htmlView.value || "";
            const normalizedHtml = normalizeEditorHtml(rawHtml);
            return {
                source,
                html: normalizedHtml,
                markdown: htmlToMarkdown(normalizedHtml),
            };
        }

        const composeHtml = normalizeEditorHtml(composeView.innerHTML || "");
        return {
            source: EDITOR_SYNC_SOURCE.COMPOSE,
            html: composeHtml,
            markdown: htmlToMarkdown(composeHtml),
        };
    }

    function handleFormatSelectChange(value) {
        if (!value) return;
        execCmd("formatBlock", value);
    }

    function wrapSelectedText(textarea, before, after, fallbackText = "text") {
        const start = textarea.selectionStart ?? 0;
        const end = textarea.selectionEnd ?? 0;
        const text = textarea.value || "";
        const selectedText = text.substring(start, end);
        const content = selectedText || fallbackText;

        textarea.value =
            text.substring(0, start) +
            before +
            content +
            after +
            text.substring(end);
        textarea.focus();
        textarea.selectionStart = start + before.length;
        textarea.selectionEnd = start + before.length + content.length;

        return {
            start,
            end,
            selectedText,
        };
    }

    function getComposeSelectionBlockTag() {
        const selection = window.getSelection();
        if (
            !selection ||
            !selection.rangeCount ||
            !composeView.contains(selection.anchorNode)
        ) {
            return normalizeEditorHtml(composeView.innerHTML || "") ? "P" : "P";
        }

        let node = selection.anchorNode;
        if (node?.nodeType === Node.TEXT_NODE) node = node.parentElement;

        const blockElement = node?.closest?.(
            "h1, h2, h3, h4, p, blockquote, pre",
        );
        if (!blockElement) {
            return normalizeEditorHtml(composeView.innerHTML || "") ? "P" : "P";
        }

        const tag = blockElement.tagName.toUpperCase();
        return tag === "PRE" ? "PRE" : tag;
    }

    function getMarkdownSelectionBlockTag() {
        const value = markdownView.value || "";
        if (!value.trim()) return "P";

        const cursor = markdownView.selectionStart ?? 0;
        const lines = value.split("\n");
        let offset = 0;
        let lineIndex = 0;

        for (let i = 0; i < lines.length; i++) {
            const lineLength = lines[i].length + 1;
            if (cursor < offset + lineLength || i === lines.length - 1) {
                lineIndex = i;
                break;
            }
            offset += lineLength;
        }

        const currentLine = lines[lineIndex] || "";
        const beforeLines = lines.slice(0, lineIndex + 1);
        const fenceCount = beforeLines.filter((line) =>
            /^```/.test(line.trim()),
        ).length;
        if (fenceCount % 2 === 1) return "PRE";
        if (/^#\s+/.test(currentLine) && !/^##/.test(currentLine)) return "H1";
        if (/^####\s+/.test(currentLine)) return "H4";
        if (/^###\s+/.test(currentLine)) return "H3";
        if (/^##\s+/.test(currentLine)) return "H2";
        if (/^>\s+/.test(currentLine)) return "BLOCKQUOTE";
        return "P";
    }

    function getHtmlSelectionBlockTag() {
        const value = htmlView.value || "";
        if (!value.trim()) return "P";

        const cursor = htmlView.selectionStart ?? 0;
        const beforeCursor = value.slice(0, cursor);
        const matches = [
            ...beforeCursor.matchAll(/<\/?([a-z0-9]+)(?:\s[^>]*)?>/gi),
        ];
        const stack = [];
        const trackedTags = new Set([
            "h1",
            "h2",
            "h3",
            "h4",
            "p",
            "blockquote",
            "pre",
        ]);

        matches.forEach((match) => {
            const fullTag = match[0];
            const tagName = match[1].toLowerCase();
            if (!trackedTags.has(tagName)) return;
            const isClosing = fullTag.startsWith("</");
            if (isClosing) {
                const index = stack.lastIndexOf(tagName);
                if (index !== -1) stack.splice(index, 1);
            } else if (!fullTag.endsWith("/>")) {
                stack.push(tagName);
            }
        });

        const activeTag = stack[stack.length - 1];
        if (!activeTag) return "P";
        return activeTag === "pre" ? "PRE" : activeTag.toUpperCase();
    }

    function updateFormatSelectState() {
        if (!formatSelect) return;

        const activeSource = getVisibleEditorSource();
        let nextValue = "P";

        if (activeSource === EDITOR_SYNC_SOURCE.COMPOSE) {
            nextValue = getComposeSelectionBlockTag();
        } else if (activeSource === EDITOR_SYNC_SOURCE.MARKDOWN) {
            nextValue = getMarkdownSelectionBlockTag();
        } else if (activeSource === EDITOR_SYNC_SOURCE.HTML) {
            nextValue = getHtmlSelectionBlockTag();
        }

        if (
            ![...formatSelect.options].some(
                (option) => option.value === nextValue,
            )
        ) {
            nextValue = "P";
        }

        formatSelect.value = nextValue;
        syncDropdownSkin("formatSelect");
    }

    function getTabHistoryKey(source) {
        if (source === EDITOR_SYNC_SOURCE.MARKDOWN) return "markdownView";
        if (source === EDITOR_SYNC_SOURCE.HTML) return "htmlView";
        return null;
    }

    function getHistorySelection(textarea) {
        return {
            start: textarea.selectionStart ?? 0,
            end: textarea.selectionEnd ?? 0,
        };
    }

    function applyHistoryEntry(textarea, entry) {
        if (!textarea || !entry) return;
        textarea.value = entry.value;
        const max = textarea.value.length;
        const start = Math.min(entry.selectionStart ?? 0, max);
        const end = Math.min(entry.selectionEnd ?? start, max);
        textarea.focus();
        textarea.setSelectionRange(start, end);
    }

    function recordTabHistory(
        viewId,
        value,
        selection = getHistorySelection(document.getElementById(viewId)),
    ) {
        const history = tabHistories[viewId];
        if (!history) return;

        if (
            history.stack.length &&
            history.stack[history.index]?.value === value
        ) {
            history.stack[history.index] = {
                value,
                selectionStart: selection.start,
                selectionEnd: selection.end,
            };
            history.lastValue = value;
            return;
        }

        if (history.index < history.stack.length - 1) {
            history.stack = history.stack.slice(0, history.index + 1);
        }

        history.stack.push({
            value,
            selectionStart: selection.start,
            selectionEnd: selection.end,
        });

        if (history.stack.length > TAB_HISTORY_LIMIT) {
            history.stack.shift();
        }

        history.index = history.stack.length - 1;
        history.lastValue = value;
    }

    function syncTabHistoryValue(viewId, value) {
        const history = tabHistories[viewId];
        if (!history) return;
        history.lastValue = value;
        if (!history.stack.length) {
            history.stack.push({ value, selectionStart: 0, selectionEnd: 0 });
            history.index = 0;
            return;
        }
        history.stack[history.index] = {
            ...history.stack[history.index],
            value,
        };
    }

    function handleTextareaHistory(viewId, direction) {
        const history = tabHistories[viewId];
        const textarea = document.getElementById(viewId);
        if (!history || !textarea || !history.stack.length) return false;

        const targetIndex =
            direction === "undo" ? history.index - 1 : history.index + 1;
        if (targetIndex < 0 || targetIndex >= history.stack.length)
            return false;

        history.index = targetIndex;
        const entry = history.stack[history.index];
        applyHistoryEntry(textarea, entry);
        history.lastValue = entry.value;

        syncFromEditor(
            viewId === "markdownView"
                ? EDITOR_SYNC_SOURCE.MARKDOWN
                : EDITOR_SYNC_SOURCE.HTML,
            true,
        );
        return true;
    }

    function captureTextareaHistory(viewId) {
        const textarea = document.getElementById(viewId);
        if (!textarea) return;

        const history = tabHistories[viewId];
        if (!history) return;

        if (history.lastValue !== textarea.value) {
            recordTabHistory(
                viewId,
                textarea.value,
                getHistorySelection(textarea),
            );
        } else if (history.stack.length) {
            history.stack[history.index] = {
                ...history.stack[history.index],
                selectionStart:
                    textarea.selectionStart ??
                    history.stack[history.index].selectionStart,
                selectionEnd:
                    textarea.selectionEnd ??
                    history.stack[history.index].selectionEnd,
            };
        }
    }

    function initEditorRichComponents() {
        // Initialize MCQ Quizzes in Compose View
        document
            .querySelectorAll("#composeView .tsa-quiz-wrap")
            .forEach(function (wrap) {
                if (wrap._tsaInit) return;
                wrap._tsaInit = true;

                const options = wrap.querySelectorAll(".tsa-option");
                const progressBar = wrap.querySelector(".tsa-progress-bar");
                const percentage = wrap.querySelector(".tsa-percentage");
                const attemptedCount = wrap.querySelector(
                    "#tsa-attemptedCount",
                );
                const correctCount = wrap.querySelector("#tsa-correctCount");
                const wrongCount = wrap.querySelector("#tsa-wrongCount");
                const message = wrap.querySelector("#tsa-message");
                const resetButton = wrap.querySelector(".tsa-reset-btn");

                if (options.length === 0) return;

                const totalQuestions = new Set(
                    Array.from(options).map((opt) =>
                        opt.getAttribute("data-question"),
                    ),
                ).size;
                let attempted = 0;
                let correct = 0;

                options.forEach((opt) => {
                    let newOpt = opt.cloneNode(true);
                    opt.parentNode.replaceChild(newOpt, opt);

                    newOpt.addEventListener("click", function () {
                        const qId = this.getAttribute("data-question");
                        const isCorrect =
                            this.getAttribute("data-correct") === "true";
                        const siblingOpts = wrap.querySelectorAll(
                            `.tsa-option[data-question="${qId}"]`,
                        );

                        const alreadyAnswered = Array.from(siblingOpts).some(
                            (o) => o.classList.contains("tsa-answered"),
                        );
                        if (alreadyAnswered) return;

                        attempted++;
                        siblingOpts.forEach((o) =>
                            o.classList.add("tsa-answered"),
                        );

                        if (isCorrect) {
                            correct++;
                            this.classList.add("tsa-correct");
                        } else {
                            this.classList.add("tsa-wrong");
                            siblingOpts.forEach((o) => {
                                if (o.getAttribute("data-correct") === "true") {
                                    o.classList.add("tsa-correct");
                                }
                            });
                        }

                        const exp = wrap.querySelector(
                            `.tsa-exp[data-question="${qId}"]`,
                        );
                        if (exp) exp.style.display = "block";

                        if (attemptedCount)
                            attemptedCount.textContent = attempted;
                        if (correctCount) correctCount.textContent = correct;
                        if (wrongCount)
                            wrongCount.textContent = attempted - correct;

                        if (progressBar && percentage) {
                            const pct = (attempted / totalQuestions) * 100;
                            progressBar.style.width = pct + "%";
                            percentage.textContent = Math.round(pct) + "%";
                        }

                        if (attempted === totalQuestions && message) {
                            if (correct === totalQuestions) {
                                message.textContent =
                                    "CONGRATULATIONS! YOU GOT ALL CORRECT!";
                            } else if (correct >= totalQuestions / 2) {
                                message.textContent =
                                    "GREAT JOB! YOU'RE DOING WELL!";
                            } else {
                                message.textContent =
                                    "KEEP PRACTICING. YOU CAN IMPROVE!";
                            }
                        }
                    });
                });

                if (resetButton) {
                    let newReset = resetButton.cloneNode(true);
                    resetButton.parentNode.replaceChild(newReset, resetButton);

                    newReset.addEventListener("click", function () {
                        wrap.querySelectorAll(".tsa-option").forEach((o) => {
                            o.classList.remove(
                                "tsa-correct",
                                "tsa-wrong",
                                "tsa-answered",
                            );
                        });
                        wrap.querySelectorAll(".tsa-exp").forEach((e) => {
                            e.style.display = "none";
                        });

                        attempted = 0;
                        correct = 0;

                        if (attemptedCount) attemptedCount.textContent = "0";
                        if (correctCount) correctCount.textContent = "0";
                        if (wrongCount) wrongCount.textContent = "0";
                        if (progressBar) progressBar.style.width = "0%";
                        if (percentage) percentage.textContent = "0%";
                        if (message)
                            message.textContent = "PRACTICE REGULARLY!";
                    });
                }
            });

        // Initialize Videos in Compose View
        document
            .querySelectorAll(
                "#composeView .tsa-video-wrap:not([data-vd-init])",
            )
            .forEach(function (w) {
                w.setAttribute("data-vd-init", "1");
                const thumb = w.querySelector(".tsa-video-thumb");
                if (!thumb) return;
                thumb.addEventListener("click", function () {
                    const src = w.dataset.src;
                    if (!src) return;
                    const iw = w.querySelector(".tsa-video-iframe-wrap");
                    if (!iw) return;
                    const iframe = document.createElement("iframe");
                    iframe.src = src;
                    iframe.allow =
                        "accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture;web-share";
                    iframe.allowFullscreen = true;
                    iframe.loading = "lazy";
                    iw.innerHTML = "";
                    iw.appendChild(iframe);
                    w.classList.add("tsa-active");
                });
            });
    }

    function updateEditorViews({
        source,
        markdown,
        html,
        preserveFocus = true,
        triggerSave = false,
        updateSourceView = true,
    }) {
        if (editorState.isSyncing) return;
        editorState.isSyncing = true;

        const activeElement = document.activeElement;
        const selections = {
            markdownStart: markdownView.selectionStart,
            markdownEnd: markdownView.selectionEnd,
            htmlStart: htmlView.selectionStart,
            htmlEnd: htmlView.selectionEnd,
        };

        let nextHtml = html != null ? normalizeEditorHtml(html) : "";
        let nextMarkdown = markdown != null ? markdown : "";

        if (source === EDITOR_SYNC_SOURCE.MARKDOWN) {
            nextHtml = markdownToHtml(nextMarkdown);
        } else if (
            source === EDITOR_SYNC_SOURCE.HTML ||
            source === EDITOR_SYNC_SOURCE.COMPOSE
        ) {
            nextMarkdown = htmlToMarkdown(nextHtml);
        }

        editorState.html = nextHtml;
        editorState.markdown = nextMarkdown;
        editorState.activeSource = source;

        if (
            source !== EDITOR_SYNC_SOURCE.COMPOSE &&
            composeView.innerHTML !== nextHtml
        ) {
            composeView.innerHTML = nextHtml;
        }
        if (
            (updateSourceView || source !== EDITOR_SYNC_SOURCE.MARKDOWN) &&
            markdownView.value !== nextMarkdown
        ) {
            markdownView.value = nextMarkdown;
        }
        const prettyHtml = beautifyHTML(nextHtml);
        if (
            (updateSourceView || source !== EDITOR_SYNC_SOURCE.HTML) &&
            htmlView.value !== prettyHtml
        ) {
            htmlView.value = prettyHtml;
        }

        syncTabHistoryValue("markdownView", markdownView.value);
        syncTabHistoryValue("htmlView", htmlView.value);

        if (preserveFocus && activeElement === markdownView) {
            markdownView.setSelectionRange(
                Math.min(selections.markdownStart, markdownView.value.length),
                Math.min(selections.markdownEnd, markdownView.value.length),
            );
        } else if (preserveFocus && activeElement === htmlView) {
            htmlView.setSelectionRange(
                Math.min(selections.htmlStart, htmlView.value.length),
                Math.min(selections.htmlEnd, htmlView.value.length),
            );
        }

        editorState.isSyncing = false;
        updateFormatSelectState();
        initEditorRichComponents();
        if (triggerSave) debouncedAutoSave();
    }

    function syncFromEditor(source, immediate = false) {
        if (editorState.isSyncing) return;
        clearTimeout(editorState.syncTimer);
        const run = () => {
            const snapshot = getEditorSnapshot(source);
            updateEditorViews({
                source: snapshot.source,
                html: snapshot.html,
                markdown: snapshot.markdown,
                updateSourceView: immediate,
                triggerSave: true,
            });
        };
        if (immediate) run();
        else editorState.syncTimer = setTimeout(run, 180);
    }

    function setEditorContent({
        markdown = null,
        html = null,
        source = EDITOR_SYNC_SOURCE.SYSTEM,
        triggerSave = true,
    }) {
        const resolvedSource =
            markdown != null
                ? EDITOR_SYNC_SOURCE.MARKDOWN
                : html != null
                  ? EDITOR_SYNC_SOURCE.HTML
                  : source;
        updateEditorViews({
            source: resolvedSource,
            markdown,
            html,
            preserveFocus: false,
            triggerSave,
        });
    }

    function flushActiveEditorState() {
        const visibleSource = getVisibleEditorSource();
        const historyKey = getTabHistoryKey(visibleSource);
        if (historyKey) captureTextareaHistory(historyKey);

        const source = visibleSource;
        const snapshot = getEditorSnapshot(source);
        updateEditorViews({
            source: snapshot.source,
            html: snapshot.html,
            markdown: snapshot.markdown,
            preserveFocus: true,
            triggerSave: false,
        });
        return snapshot;
    }

    // Custom Confirm Modal Logic
    function showConfirm(
        title,
        message,
        btnText = "Confirm",
        confirmColor = "bg-blue-600 hover:bg-blue-700",
    ) {
        return new Promise((resolve) => {
            const overlay = document.getElementById("customConfirmOverlay");
            const titleEl = document.getElementById("customConfirmTitle");
            const msgEl = document.getElementById("customConfirmMsg");
            const btnOk = document.getElementById("customConfirmOk");
            const btnCancel = document.getElementById("customConfirmCancel");

            titleEl.textContent = title;
            msgEl.textContent = message;

            btnOk.className = `px-5 py-2.5 text-sm font-semibold text-white rounded-lg transition-colors shadow-sm ${confirmColor}`;
            btnOk.textContent = btnText;

            overlay.classList.remove("hidden");
            overlay.classList.add("flex");
            void overlay.offsetWidth;
            overlay.classList.remove("opacity-0");
            overlay.firstElementChild.classList.remove("scale-95");

            const cleanup = (result) => {
                overlay.classList.add("opacity-0");
                overlay.firstElementChild.classList.add("scale-95");
                setTimeout(() => {
                    overlay.classList.add("hidden");
                    overlay.classList.remove("flex");
                }, 300);
                btnOk.removeEventListener("click", onOk);
                btnCancel.removeEventListener("click", onCancel);
                resolve(result);
            };

            const onOk = () => cleanup(true);
            const onCancel = () => cleanup(false);

            btnOk.addEventListener("click", onOk);
            btnCancel.addEventListener("click", onCancel);
        });
    }

