    function getLastTextNode(el) {
        if (!el) return null;
        if (el.nodeType === Node.TEXT_NODE && el.textContent.trim()) return el;
        for (let i = el.childNodes.length - 1; i >= 0; i--) {
            const found = getLastTextNode(el.childNodes[i]);
            if (found) return found;
        }
        return null;
    }

    function insertImageIntoArticle(url, alt, origWidth, origHeight) {
        const finalAlt = (
            alt ||
            document.getElementById("imgAltText").value ||
            "image"
        ).trim();
        const titleText =
            document.getElementById("imgTitleText").value.trim() || finalAlt;
        const caption = document.getElementById("imgCaption").value.trim();

        // ── Extract base URL and filename from the raw R2 URL ──
        let baseUrl = "";
        let filename = "";
        const isCdn = url.includes("YOUR-DOMAIN.com") || url.includes("yourdomain.com");
        if (isCdn) {
            baseUrl = new URL(url).origin;
            // Strip any existing cdn-cgi transform path to get raw filename
            const cdnPattern = /\/cdn-cgi\/image\/[^\/]+\/(.+)/;
            const cdnMatch = url.match(cdnPattern);
            filename = cdnMatch ? cdnMatch[1] : url.split("/").pop().split("?")[0];
        }

        // ── Cover Image mode ────────────────────────────────────────────────
        if (imgModalMode === "cover") {
            let coverUrl = url;
            if (isCdn && origWidth && origHeight) {
                coverUrl = `${baseUrl}/cdn-cgi/image/format=auto,width=${origWidth},height=${origHeight},fit=crop,quality=90/${filename}`;
            } else if (isCdn) {
                coverUrl = `${baseUrl}/cdn-cgi/image/format=auto,width=1280,height=720,fit=crop,quality=90/${filename}`;
            }
            const metaImg = document.getElementById("metaImage");
            if (metaImg) metaImg.value = coverUrl;

            const metaCaption = document.getElementById("metaImageCaption");
            if (metaCaption && caption) metaCaption.value = caption;

            closeImageModal();
            addConsoleLog(
                "INFO",
                `Cover image set (frontmatter only, not inserted in body): ${finalAlt}`,
            );
            notify(
                "icon",
                "Cover Image Set",
                "Yeh image Cover Image URL field mein set ho gayi hai. Article body alag rahega.",
            );
            return;
        }

        // ── Body mode (default) ─────────────────────────────────────────────
        const activeSource = getVisibleEditorSource();
        let imgHtml = "";

        if (isCdn && origWidth > 0 && origHeight > 0) {
            // ── Auto-calculate responsive sizes based on aspect ratio ──
            const ratio = origWidth / origHeight;
            const isPortrait = origHeight > origWidth; // portrait or square

            // Mobile source: width=651, height proportional
            const mobileW = 651;
            const mobileH = Math.round(mobileW / ratio);

            // Desktop source: 736 for portrait, 780 for landscape
            const desktopW = isPortrait ? 736 : 780;
            const desktopH = Math.round(desktopW / ratio);

            // Fallback: original dimensions with CDN transform
            const fallbackW = origWidth;
            const fallbackH = origHeight;

            const mobileSrc = `${baseUrl}/cdn-cgi/image/format=auto,width=${mobileW},height=${mobileH},fit=crop,quality=90/${filename}`;
            const desktopSrc = `${baseUrl}/cdn-cgi/image/format=auto,width=${desktopW},height=${desktopH},fit=crop,quality=90/${filename}`;
            const fallbackSrc = `${baseUrl}/cdn-cgi/image/format=auto,width=${fallbackW},height=${fallbackH},fit=crop,quality=90/${filename}`;

            imgHtml = `<picture>
  <source media="(max-width: 480px)" srcset="${mobileSrc}" type="image/webp">
  <source media="(min-width: 481px)" srcset="${desktopSrc}" type="image/webp">
  <img class="imd" src="${fallbackSrc}" alt="${escapeAttr(finalAlt)}" title="${escapeAttr(titleText)}" width="${fallbackW}" height="${fallbackH}" style="width:100%; height:auto; aspect-ratio:${fallbackW}/${fallbackH}; display:block;" loading="lazy">
</picture>`;
        } else if (isCdn) {
            // CDN image but no dimensions available — simple CDN transform
            const fallbackSrc = `${baseUrl}/cdn-cgi/image/format=auto,width=1280,quality=90/${filename}`;
            imgHtml = `<img class="imd" src="${fallbackSrc}" alt="${escapeAttr(finalAlt)}" title="${escapeAttr(titleText)}" style="width:100%; height:auto; display:block;" loading="lazy">`;
        } else {
            // External / non-CDN image — plain img tag
            imgHtml = `<img src="${url}" alt="${escapeAttr(finalAlt)}" title="${escapeAttr(titleText)}" class="max-w-full h-auto rounded-lg shadow-md" loading="lazy" decoding="async">`;
        }

        let finalOutput = "";
        if (caption) {
            finalOutput = `<figure class="my-4 flex flex-col items-center">\n${imgHtml}\n<figcaption class="text-sm text-center text-gray-500 mt-2">${escapeAttr(caption)}</figcaption>\n</figure>`;
        } else {
            finalOutput = imgHtml;
        }

        if (activeSource === EDITOR_SYNC_SOURCE.COMPOSE) {
            const composeEl = document.getElementById("composeView");
            composeEl.focus();

            const rangeToUse = savedSelectionRange || lastComposeSelectionRange;

            if (rangeToUse) {
                const sel = window.getSelection();
                sel.removeAllRanges();
                sel.addRange(rangeToUse);
            } else {
                const sel = window.getSelection();
                const range = document.createRange();
                range.selectNodeContents(composeEl);
                range.collapse(false);
                sel.removeAllRanges();
                sel.addRange(range);
            }

            savedSelectionRange = null;
            document.execCommand("insertHTML", false, finalOutput);
            syncFromEditor(EDITOR_SYNC_SOURCE.COMPOSE, true);
        } else {
            const isMd = activeSource === EDITOR_SYNC_SOURCE.MARKDOWN;
            const textarea = isMd
                ? document.getElementById("markdownView")
                : document.getElementById("htmlView");

            const textToInsert = `\n\n${finalOutput}\n\n`;

            const pos = savedTextareaSelection
                ? savedTextareaSelection.start
                : (textarea.selectionStart ?? 0);
            textarea.value =
                textarea.value.slice(0, pos) +
                textToInsert +
                textarea.value.slice(pos);
            textarea.focus();
            const newCursorPos = pos + textToInsert.length;
            textarea.selectionStart = newCursorPos;
            textarea.selectionEnd = newCursorPos;
            savedTextareaSelection = null;
            syncFromEditor(
                isMd ? EDITOR_SYNC_SOURCE.MARKDOWN : EDITOR_SYNC_SOURCE.HTML,
                true,
            );
        }

        closeImageModal();
        addConsoleLog(
            "INFO",
            `Body image inserted at cursor (loading=lazy): ${finalAlt}`,
        );
    }

    // 5. DRAFT MANAGEMENT (LOCAL STORAGE + KV)
    const metadataEl = document.getElementById("writePageMetadata");
    const userEmail = metadataEl
        ? metadataEl.dataset.userEmail || "anonymous"
        : "anonymous";
    const filePath = metadataEl ? metadataEl.dataset.filePath || "" : "";

    const getLocalDraftKey = () => {
        return filePath
            ? `draft:cms:write-article:${userEmail}:${filePath}`
            : `draft:cms:write-article:${userEmail}:new`;
    };

    let autoSaveTimer = null;
    let localStorageSaveTimer = null;
    let isDraftModified = false;
    let editSha = null;
    let editOriginalPath = null;

    // SEO Character Counter Logic
    function updateTitleCounter() {
        const titleInput = document.getElementById("postTitle");
        const titleCounter = document.getElementById("titleCounter");
        if (!titleInput || !titleCounter) return;
        const len = titleInput.value.length;
        titleCounter.textContent = len;
        // Google recommends 50-60 chars for title
        if (len === 0) {
            titleCounter.className = "text-[#94a3b8]";
        } else if (len >= 50 && len <= 60) {
            titleCounter.className = "text-emerald-500 font-bold";
        } else if (len > 60) {
            titleCounter.className = "text-rose-500 font-bold";
        } else {
            titleCounter.className = "text-amber-500";
        }
    }

    function updateDescCounter() {
        const descInput = document.getElementById("metaDesc");
        const descCounter = document.getElementById("descCounter");
        if (!descInput || !descCounter) return;
        const len = descInput.value.length;
        descCounter.textContent = `${len} / 160`;
        // Google recommends 150-160 chars for description
        if (len === 0) {
            descCounter.className = "text-[10px] font-medium text-[#94a3b8]";
        } else if (len >= 140 && len <= 160) {
            descCounter.className = "text-[10px] font-bold text-emerald-500";
        } else if (len > 160) {
            descCounter.className = "text-[10px] font-bold text-rose-500";
        } else {
            descCounter.className = "text-[10px] font-medium text-amber-500";
        }
    }

    // Bind counters
    document
        .getElementById("postTitle")
        .addEventListener("input", updateTitleCounter);
    document
        .getElementById("metaDesc")
        .addEventListener("input", updateDescCounter);

    function getDraftData() {
        return {
            postTitle: document.getElementById("postTitle").value,
            composeView: document.getElementById("composeView").innerHTML,
            markdownView: document.getElementById("markdownView").value,
            metaSlug: document.getElementById("metaSlug").value,
            metaDesc: document.getElementById("metaDesc").value,
            metaCat: document.getElementById("metaCat").value,
            metaTags: document.getElementById("metaTags").value,
            metaImage: document.getElementById("metaImage").value,
            imgAltText: document.getElementById("imgAltText").value,
            imgTitleText: document.getElementById("imgTitleText").value,
            aiImgPrompt: document.getElementById("aiImgPrompt").value,
            // New Fields Below
            metaAiSummary:
                document.getElementById("metaAiSummary")?.value || "",
            metaAuthor: document.getElementById("metaAuthor")?.value || "",
            metaImageCaption:
                document.getElementById("metaImageCaption")?.value || "",
            timestamp: new Date().toISOString(),
            _editSha: editSha,
            _editOriginalPath: editOriginalPath,
        };
    }

    function applyDraftData(draft) {
        if (!draft) return;
        editSha = draft._editSha || null;
        editOriginalPath = draft._editOriginalPath || null;
        document.getElementById("postTitle").value = draft.postTitle || "";
        autoResizeTitle(document.getElementById("postTitle"));
        setEditorContent({
            markdown: draft.markdownView || null,
            html: draft.markdownView ? null : draft.composeView || "",
            triggerSave: false,
        });
        document.getElementById("metaSlug").value = draft.metaSlug || "";
        document.getElementById("metaDesc").value = draft.metaDesc || "";
        document.getElementById("metaCat").value = draft.metaCat || "";
        document.getElementById("metaTags").value = draft.metaTags || "";
        document.getElementById("metaImage").value = draft.metaImage || "";
        document.getElementById("imgAltText").value = draft.imgAltText || "";
        document.getElementById("imgTitleText").value =
            draft.imgTitleText || "";
        document.getElementById("aiImgPrompt").value = draft.aiImgPrompt || "";
        // Restore New Fields
        if (document.getElementById("metaAiSummary"))
            document.getElementById("metaAiSummary").value =
                draft.metaAiSummary || "";
        if (document.getElementById("metaAuthor"))
            document.getElementById("metaAuthor").value =
                draft.metaAuthor || "Sandhata Prajapati";
        if (document.getElementById("metaImageCaption"))
            document.getElementById("metaImageCaption").value =
                draft.metaImageCaption || "";

        // Trigger counters
        updateTitleCounter();
        updateDescCounter();
    }

    function saveToLocalStorage(draft) {
        try {
            localStorage.setItem(getLocalDraftKey(), JSON.stringify(draft));
        } catch (e) {
            console.warn("LocalStorage save failed:", e.message);
        }
    }

    function updateSaveIndicator(state) {
        const text = document.getElementById("saveIndicatorText");
        const dot = document.getElementById("saveIndicatorDot");
        if (state === "saving") {
            text.textContent = "Saving...";
            dot.classList.remove("bg-slate-300", "bg-emerald-500");
            dot.classList.add("bg-blue-500", "animate-pulse");
        } else if (state === "saved") {
            text.textContent = "Saved to KV and localStorage";
            dot.classList.remove(
                "bg-slate-300",
                "bg-blue-500",
                "animate-pulse",
            );
            dot.classList.add("bg-emerald-500");
            isDraftModified = false;
        } else if (state === "error") {
            text.textContent = "Save failed (LS backup active)";
            dot.classList.remove(
                "bg-emerald-500",
                "bg-blue-500",
                "animate-pulse",
            );
            dot.classList.add("bg-slate-300");
        } else {
            text.textContent = "Unsaved changes";
            dot.classList.remove("bg-emerald-500", "animate-pulse");
            dot.classList.add("bg-slate-300");
            isDraftModified = true;
        }
    }

    async function saveDraftToKV(draft) {
        try {
            updateSaveIndicator("saving");
            const res = await fetch("/api/draft", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ draft }),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error);
            saveToLocalStorage(draft);
            updateSaveIndicator("saved");
        } catch (e) {
            addConsoleLog("ERROR", "KV Draft Auto-save failed", e);
            saveToLocalStorage(draft);
            updateSaveIndicator("error");
        }
    }

    function debouncedLocalStorageSave() {
        clearTimeout(localStorageSaveTimer);
        localStorageSaveTimer = setTimeout(() => {
            const draft = getDraftData();
            saveToLocalStorage(draft);
        }, 2000); // 2-second debounce for localStorage
    }

    function debouncedAutoSave() {
        debouncedLocalStorageSave();

        clearTimeout(autoSaveTimer);
        updateSaveIndicator("unsaved");
        autoSaveTimer = setTimeout(() => {
            const draft = getDraftData();
            saveDraftToKV(draft);
        }, 15000); // 15-second debounce for KV
    }

    async function loadDraftFromKV() {
        try {
            addConsoleLog("SYSTEM", "Attempting to load draft from KV...");
            const url = filePath
                ? `/api/draft?file=${encodeURIComponent(filePath)}`
                : "/api/draft";
            const res = await fetch(url, { method: "GET" });
            const data = await res.json();
            if (res.ok && data.draft) {
                applyDraftData(data.draft);
                notify(
                    "icon",
                    "Draft Loaded",
                    "Loaded from KV (server backup)",
                );
                addConsoleLog("SUCCESS", "Draft restored from KV");
                return true;
            }
        } catch (e) {
            addConsoleLog(
                "ERROR",
                "KV load failed, falling back to localStorage",
                e,
            );
        }
        return false;
    }

    function loadDraftFromLocalStorage() {
        try {
            const saved = localStorage.getItem(getLocalDraftKey());
            if (saved) {
                const draft = JSON.parse(saved);
                applyDraftData(draft);
                notify(
                    "icon",
                    "Draft Loaded",
                    "Loaded from browser storage (localStorage)",
                );
                addConsoleLog("INFO", "Draft restored from localStorage");
                return true;
            }
        } catch (e) {
            console.warn("LocalStorage load failed:", e.message);
        }
        return false;
    }

    async function initDraftLoad() {
        const loaded = await loadDraftFromKV();
        if (!loaded) {
            loadDraftFromLocalStorage();
        }
        updateTitleCounter();
        updateDescCounter();
    }

    const autoSaveFields = [
        "postTitle",
        "metaSlug",
        "metaDesc",
        "metaCat",
        "metaTags",
        "metaImage",
        "imgAltText",
        "imgTitleText",
        "aiImgPrompt",
        "metaAiSummary",
        "metaAuthor",
        "metaImageCaption", // Added new fields here
    ];
    autoSaveFields.forEach((id) => {
        const el = document.getElementById(id);
        if (el) {
            el.addEventListener("input", debouncedAutoSave);
            el.addEventListener("change", debouncedAutoSave);
        }
    });

    // Save Draft Buttons Binding
    const handleManualSave = async (btnId) => {
        const btn = document.getElementById(btnId);
        const originalText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = `<span class="flex items-center gap-2">${svgSpinner} Saving...</span>`;

        // Clear active timers to prevent subsequent auto-saves
        clearTimeout(autoSaveTimer);
        clearTimeout(localStorageSaveTimer);

        flushActiveEditorState();
        const draft = getDraftData();
        await saveDraftToKV(draft);
        notify("icon", "Draft Saved", "Your work is backed up securely.");
        setTimeout(() => {
            btn.innerHTML = originalText;
            btn.disabled = false;
        }, 1500);
    };

    document
        .getElementById("btnSaveDraft")
        .addEventListener("click", () => handleManualSave("btnSaveDraft"));
    document
        .getElementById("btnSaveDraftHeader")
        .addEventListener("click", () =>
            handleManualSave("btnSaveDraftHeader"),
        );

    // Clear All button with custom confirmation
    async function confirmClearAll() {
        const confirmed = await showConfirm(
            "Clear All Fields",
            "Are you sure you want to clear all fields? This will also delete your saved draft permanently.",
            "Clear All",
            "bg-rose-600 hover:bg-rose-700",
        );
        if (!confirmed) return;
        editSha = null;
        editOriginalPath = null;
        setEditorContent({ markdown: "", triggerSave: false });
        autoSaveFields.forEach((id) => {
            const el = document.getElementById(id);
            if (el) {
                if (el.type === "checkbox") el.checked = false;
                else el.value = "";
                if (id === "metaAuthor") el.value = "Sandhata Prajapati"; // Reset to default
            }
        });
        updateTitleCounter();
        updateDescCounter();
        localStorage.removeItem(getLocalDraftKey());

        try {
            const url = filePath
                ? `/api/draft?file=${encodeURIComponent(filePath)}`
                : "/api/draft";
            await fetch(url, { method: "DELETE" });
            addConsoleLog("SUCCESS", "Draft forcefully deleted from KV.");
        } catch (e) {
            addConsoleLog("ERROR", "Failed to delete KV Draft", e);
        }

        if (document.getElementById("imgModalGrid")) {
            document.getElementById("imgModalGrid").innerHTML = "";
        }

        updateSaveIndicator("unsaved");
        notify("icon", "Cleared", "All fields and drafts have been cleared");
    }

    document
        .getElementById("btnClearAll")
        .addEventListener("click", confirmClearAll);

    initDraftLoad();

    // 5. PUBLISH TO GITHUB LOGIC (STRICT VALIDATION)
    const handlePublish = async (btnId) => {
        const publishBtn = document.getElementById(btnId);
        const originalBtnText = publishBtn.innerHTML;

        flushActiveEditorState();
        const title = document.getElementById("postTitle").value.trim();
        const rawContent =
            editorState.markdown ||
            document.getElementById("markdownView").value ||
            document.getElementById("composeView").innerText;

        let slug = document.getElementById("metaSlug").value.trim();
        if (!slug && title) {
            slug = title
                .toLowerCase()
                .replace(/[^a-z0-9]+/g, "-")
                .replace(/(^-|-$)/g, "");
        }

        // Gather all metadata
        const description =
            document.getElementById("metaDesc")?.value.trim() || "";
        const category = document.getElementById("metaCat")?.value.trim() || "";
        const tagsInput =
            document.getElementById("metaTags")?.value.trim() || "";
        const image = document.getElementById("metaImage")?.value.trim() || "";
        const imageCaption =
            document.getElementById("metaImageCaption")?.value.trim() || "";
        const author =
            document.getElementById("metaAuthor")?.value.trim() ||
            "Sandhata Prajapati";
        const aiSummary =
            document.getElementById("metaAiSummary")?.value.trim() || "";
        const pubDate = new Date().toISOString();

        // STRICT VALIDATION: Ensure required components are present
        if (
            !title ||
            !rawContent ||
            !slug ||
            !description ||
            !category ||
            !image ||
            !author
        ) {
            notify(
                "icon",
                "Missing Required Fields",
                "Title, Slug, Content, Description, Category, Image, and Author are mandatory for publishing!",
                true,
            );
            return;
        }

        const isMobileDevice = window.matchMedia("(max-width: 767px)").matches;
        let confirmed = true;
        if (!isMobileDevice) {
            confirmed = await showConfirm(
                "Publish Article",
                "Are you sure you want to commit and publish this article directly to your live GitHub repository?",
                "Publish to GitHub",
                "bg-emerald-600 hover:bg-emerald-700",
            );
        }
        if (!confirmed) return;

        publishBtn.innerHTML = `<span class="flex items-center gap-2">${svgSpinner} Publishing...</span>`;
        publishBtn.classList.add("opacity-75", "cursor-not-allowed");
        publishBtn.disabled = true;
        addConsoleLog(
            "SYSTEM",
            "Building strict markdown structure & initiating GitHub Commit protocol...",
        );

        // Format tags as a valid YAML array string
        const formattedTags = tagsInput
            ? `[${tagsInput
                  .split(",")
                  .map((t) => `"${t.trim()}"`)
                  .filter((t) => t !== '""')
                  .join(", ")}]`
            : `[]`;

        // Escape double quotes in text fields to prevent breaking the YAML frontmatter
        const safeTitle = title.replace(/"/g, '\\"');
        const safeDesc = description.replace(/"/g, '\\"');
        const safeCat = category.replace(/"/g, '\\"');
        const safeCaption = imageCaption.replace(/"/g, '\\"');
        const safeAuthor = author.replace(/"/g, '\\"');
        const safeAiSummary = aiSummary.replace(/"/g, '\\"');

        // CONSTRUCT FINAL MARKDOWN EXACTLY AS PER TEMPLATE
        let finalMarkdown = `---
title: "${safeTitle}"
description: "${safeDesc}"
pubDate: ${pubDate}
category: "${safeCat}"
image: "${image}"
image_caption: "${safeCaption}"
author: "${safeAuthor}"
tags: ${formattedTags}
ai_summary: "${safeAiSummary}"
---

`;
        finalMarkdown += rawContent.replace(/^\s*#\s+.+\n+/, "");

        // EXTRACT USED IMAGES
        const usedImages = [];
        const imgMatches =
            finalMarkdown.match(
                /https?:\/\/[^\s"'<>]+\.(?:webp|jpg|jpeg|png|gif)/gi,
            ) || [];
        imgMatches.forEach((u) => {
            if (!usedImages.includes(u)) usedImages.push(u);
        });

        // ---------------------------------------------------------

        try {
            const res = await fetch("/api/publish", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    title,
                    slug,
                    content: finalMarkdown,
                    description,
                    category,
                    tags: formattedTags,
                    image,
                    usedImages,
                    sha: editSha || null,
                    originalPath: editOriginalPath || null,
                }),
            });
            const result = await res.json();

            if (!res.ok) {
                throw new Error(result.error || "Publishing failed.");
            }

            addConsoleLog(
                "SUCCESS",
                "Commit accepted! File structured and created on GitHub.",
            );
            notify(
                "icon",
                "Published Successfully!",
                "Your valid article structure is now live.",
                false,
            );

            editSha = null;
            editOriginalPath = null;
            localStorage.removeItem(getLocalDraftKey());
            const deleteUrl = filePath
                ? `/api/draft?file=${encodeURIComponent(filePath)}`
                : "/api/draft";
            fetch(deleteUrl, { method: "DELETE" }).catch((e) =>
                console.warn("Draft cleanup failed:", e),
            );

            setTimeout(() => {
                window.location.href = "/posts";
            }, 2500);
        } catch (error) {
            addConsoleLog("ERROR", "GitHub Push Rejected", error);
            notify("icon", "Publishing Error", error.message, true);
        } finally {
            publishBtn.innerHTML = originalBtnText;
            publishBtn.classList.remove("opacity-75", "cursor-not-allowed");
            publishBtn.disabled = false;
        }
    };

    document
        .getElementById("publishBtn")
        .addEventListener("click", () => handlePublish("publishBtn"));
    document
        .getElementById("publishBtnHeader")
        .addEventListener("click", () => handlePublish("publishBtnHeader"));

    // ── Premium Modern Dropdown Enhancer ────────────────────────────────
    const PD_REGISTRY = {};

    function pdBuildPanel(selectEl) {
        const panel = document.createElement("div");
        panel.className = "pd-panel";
        Array.from(selectEl.options).forEach((opt, idx) => {
            const row = document.createElement("div");
            row.className =
                "pd-option" +
                (opt.disabled ? " pd-disabled" : "") +
                (opt.selected ? " pd-selected" : "");
            row.setAttribute("data-pd-index", idx);
            row.innerHTML = `
                <span class="pd-option-text">${escapeAttr(opt.textContent)}</span>
                <svg class="pd-option-check" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
            `;
            if (!opt.disabled) {
                row.addEventListener("click", () =>
                    pdSelectIndex(selectEl, idx),
                );
            }
            panel.appendChild(row);
        });
        return panel;
    }

    function pdLabelFor(selectEl) {
        const opt = selectEl.options[selectEl.selectedIndex];
        return opt ? opt.textContent : "";
    }

    function pdRefreshTrigger(selectEl) {
        const reg = PD_REGISTRY[selectEl.id];
        if (!reg) return;
        const opt = selectEl.options[selectEl.selectedIndex];
        const isPlaceholder = !!(opt && opt.disabled);
        reg.labelEl.textContent = pdLabelFor(selectEl);
        reg.labelEl.classList.toggle("pd-placeholder", isPlaceholder);
        reg.panel.querySelectorAll(".pd-option").forEach((row) => {
            row.classList.toggle(
                "pd-selected",
                Number(row.getAttribute("data-pd-index")) ===
                    selectEl.selectedIndex,
            );
        });
    }

    function pdRebuildPanel(selectEl) {
        const reg = PD_REGISTRY[selectEl.id];
        if (!reg) return;
        const newPanel = pdBuildPanel(selectEl);
        if (reg.fixedMode) newPanel.classList.add("pd-panel-fixed");
        reg.panel.replaceWith(newPanel);
        reg.panel = newPanel;
        pdRefreshTrigger(selectEl);
    }

    function pdCloseAll(exceptId) {
        Object.keys(PD_REGISTRY).forEach((id) => {
            if (id === exceptId) return;
            PD_REGISTRY[id].wrap.classList.remove("pd-open");
            PD_REGISTRY[id].trigger.classList.remove("pd-open");
            PD_REGISTRY[id].panel.classList.remove("pd-panel-visible");
        });
    }

    function pdHasClippingAncestor(el) {
        let node = el.parentElement;
        while (node && node !== document.body) {
            const cs = getComputedStyle(node);
            if (
                cs.overflowX !== "visible" ||
                cs.overflowY !== "visible" ||
                cs.overflow !== "visible"
            ) {
                return node;
            }
            node = node.parentElement;
        }
        return null;
    }

    function pdPositionPanel(reg) {
        reg.panel.classList.remove("pd-panel-up");

        if (reg.fixedMode) {
            const rect = reg.trigger.getBoundingClientRect();
            const panelWidth = Math.max(rect.width, 180);
            reg.panel.style.width = panelWidth + "px";
            const panelHeight = reg.panel.offsetHeight || 280;
            const spaceBelow = window.innerHeight - rect.bottom;
            let topPos;
            if (spaceBelow < panelHeight && rect.top > panelHeight) {
                reg.panel.classList.add("pd-panel-up");
                topPos = rect.top - panelHeight - 6;
            } else {
                topPos = rect.bottom + 6;
            }
            let leftPos = rect.left;
            const maxLeft = window.innerWidth - panelWidth - 8;
            if (leftPos > maxLeft) leftPos = Math.max(8, maxLeft);
            reg.panel.style.top = topPos + "px";
            reg.panel.style.left = leftPos + "px";
            return;
        }

        const rect = reg.trigger.getBoundingClientRect();
        const spaceBelow = window.innerHeight - rect.bottom;
        const panelHeight = reg.panel.offsetHeight || 280;
        if (spaceBelow < panelHeight && rect.top > panelHeight) {
            reg.panel.classList.add("pd-panel-up");
        }
    }

    function pdToggle(selectEl) {
        const reg = PD_REGISTRY[selectEl.id];
        if (!reg) return;
        const isOpen = reg.wrap.classList.contains("pd-open");
        pdCloseAll(selectEl.id);
        if (isOpen) {
            reg.wrap.classList.remove("pd-open");
            reg.trigger.classList.remove("pd-open");
            reg.panel.classList.remove("pd-panel-visible");
        } else {
            reg.wrap.classList.add("pd-open");
            reg.trigger.classList.add("pd-open");
            if (reg.fixedMode) {
                pdPositionPanel(reg);
                // Ek frame baad visible class lagao taaki opening transition chale
                requestAnimationFrame(() =>
                    reg.panel.classList.add("pd-panel-visible"),
                );
            } else {
                pdPositionPanel(reg);
            }
        }
    }

    function pdSelectIndex(selectEl, idx) {
        const reg = PD_REGISTRY[selectEl.id];
        selectEl.selectedIndex = idx;
        if (reg) {
            reg.wrap.classList.remove("pd-open");
            reg.trigger.classList.remove("pd-open");
            reg.panel.classList.remove("pd-panel-visible");
        }
        pdRefreshTrigger(selectEl);
        selectEl.dispatchEvent(new Event("change", { bubbles: true }));
    }

    function syncDropdownSkin(selectId) {
        const selectEl = document.getElementById(selectId);
        if (selectEl) pdRefreshTrigger(selectEl);
    }

    function enhanceDropdown(selectId) {
        const selectEl = document.getElementById(selectId);
        if (!selectEl || PD_REGISTRY[selectId]) return;

        const wrap = document.createElement("div");
        wrap.className = "pd-wrap";

        const trigger = document.createElement("button");
        trigger.type = "button";
        trigger.className = selectEl.className + " pd-trigger";
        trigger.setAttribute("aria-haspopup", "listbox");

        const labelEl = document.createElement("span");
        labelEl.className = "pd-trigger-label";

        const chevron = document.createElement("svg");
        chevron.setAttribute("class", "pd-chevron");
        chevron.setAttribute("fill", "none");
        chevron.setAttribute("stroke", "currentColor");
        chevron.setAttribute("viewBox", "0 0 24 24");
        chevron.innerHTML =
            '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>';

        trigger.appendChild(labelEl);
        trigger.appendChild(chevron);

        const clippingAncestor = pdHasClippingAncestor(selectEl);
        const fixedMode = !!clippingAncestor;

        selectEl.classList.add("pd-real-select");
        selectEl.parentNode.insertBefore(wrap, selectEl);
        wrap.appendChild(selectEl);
        wrap.appendChild(trigger);

        const panel = pdBuildPanel(selectEl);
        if (fixedMode) {
            panel.classList.add("pd-panel-fixed");
            document.body.appendChild(panel);
        } else {
            wrap.appendChild(panel);
        }

        PD_REGISTRY[selectId] = {
            wrap,
            trigger,
            panel,
            labelEl,
            fixedMode,
            clippingAncestor,
        };

        trigger.addEventListener("click", (e) => {
            e.preventDefault();
            pdToggle(selectEl);
        });

        trigger.addEventListener("keydown", (e) => {
            if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                pdToggle(selectEl);
            } else if (e.key === "Escape") {
                PD_REGISTRY[selectId].wrap.classList.remove("pd-open");
                trigger.classList.remove("pd-open");
                PD_REGISTRY[selectId].panel.classList.remove(
                    "pd-panel-visible",
                );
            }
        });

        if (fixedMode) {
            const reposition = () => {
                if (wrap.classList.contains("pd-open"))
                    pdPositionPanel(PD_REGISTRY[selectId]);
            };
            if (clippingAncestor)
                clippingAncestor.addEventListener("scroll", reposition);
            window.addEventListener("scroll", reposition, true);
        }

        const mo = new MutationObserver(() => {
            wrap.classList.toggle(
                "hidden",
                selectEl.classList.contains("hidden"),
            );
        });
        mo.observe(selectEl, { attributes: true, attributeFilter: ["class"] });
        wrap.classList.toggle("hidden", selectEl.classList.contains("hidden"));

        pdRefreshTrigger(selectEl);
    }

    document.addEventListener("click", (e) => {
        const insideAnyDropdown = Object.keys(PD_REGISTRY).some((id) => {
            const reg = PD_REGISTRY[id];
            return reg.wrap.contains(e.target) || reg.panel.contains(e.target);
        });
        if (!insideAnyDropdown) pdCloseAll(null);
    });

    window.addEventListener("resize", () => pdCloseAll(null));

    [
        "sourceSelect",
        "rssCountry",
        "rssCategory",
        "rssIndex",
        "imgSourceSelect",
        "imgModalProviderSelect",
        "formatSelect",
    ].forEach(enhanceDropdown);
</script>

