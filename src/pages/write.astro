    function renderImageCard(img) {
        const div = document.createElement("div");
        div.className =
            "group relative rounded-lg overflow-hidden bg-[#f1f5f9] border-2 border-transparent hover:border-[#1a73e8] transition-all duration-200 cursor-pointer";
        div.style.aspectRatio = "4/3";

