                            class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-wider text-[#64748b] cursor-pointer"
                        >
                            <input
                                type="checkbox"
                                id="includeQuiz"
                                onchange="document.getElementById('quizOptions').classList.toggle('hidden', !this.checked)"
                                class="rounded border-[#cbd5e1] text-[#1a73e8] focus:ring-blue-500"
                            />
                            <svg
                                class="w-4 h-4 text-blue-500"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
                                ></path></svg
                            >
                            Include MCQs / Quiz
                        </label>
                        <div
                            id="quizOptions"
                            class="hidden mt-3 grid grid-cols-2 gap-2"
                        >
                            <input
                                type="text"
                                id="quizTopic"
                                placeholder="Quiz topic (optional)"
                                class="border border-[#cbd5e1] rounded-lg px-2 py-2 text-xs focus:outline-none focus:border-blue-500"
                            />
                            <input
                                type="number"
                                id="quizCount"
                                value="10"
                                min="1"
                                max="50"
                                class="border border-[#cbd5e1] rounded-lg px-2 py-2 text-xs focus:outline-none focus:border-blue-500"
                            />
                        </div>
                    </div>

                    <div
                        id="globalTableBlock"
                        class="bg-[#f8fafc] border border-[#e2e8f0] rounded-lg p-3 mt-2"
                    >
                        <label
                            class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-wider text-[#64748b] cursor-pointer"
                        >
                            <input
                                type="checkbox"
                                id="includeTable"
                                onchange="document.getElementById('tableOptions').classList.toggle('hidden', !this.checked)"
                                class="rounded border-[#cbd5e1] text-[#1a73e8] focus:ring-blue-500"
                            />
                            <svg
                                class="w-4 h-4 text-emerald-500"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                                ></path></svg
                            >
                            Include Table
                        </label>
                        <div id="tableOptions" class="hidden mt-3">
                            <input
                                type="text"
                                id="tableTopic"
                                placeholder="Table topic / details (optional)"
                                class="w-full border border-[#cbd5e1] rounded-lg px-2 py-2 text-xs focus:outline-none focus:border-blue-500"
                            />
                        </div>
                    </div>

                    <button
                        id="fetchSourceBtn"
