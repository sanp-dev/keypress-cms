                            ></label
                        >
                        <input
                            type="text"
                            id="metaSlug"
                            
                            class="w-full border border-[#cbd5e1] rounded-lg px-3 py-2 text-sm focus:border-[#1a73e8] focus:outline-none font-mono text-[#1a73e8]"
                            required
                        />
                    </div>
                    <!-- Meta Description -->
