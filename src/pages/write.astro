---
// src/pages/write.astro
import DashboardLayout from "../layouts/DashboardLayout.astro";
import { getAuthorProfile } from "../config/authors";
import VideoModal from "../components/VideoModal.astro";
import TableModal from "../components/TableModal.astro";
const currentAuthor = getAuthorProfile(Astro.locals.user?.email);

const userEmail = Astro.locals.user?.email || "anonymous";
const reqUrl = new URL(Astro.request.url);
const fileParam = reqUrl.searchParams.get("file") || "";
const filePath = (fileParam && !fileParam.includes('/'))
  ? `src/content/blog/${fileParam}`
  : fileParam;
---

<script is:inline>
    // Force hide dashboard header early
    if (window.matchMedia("(max-width: 767px)").matches) {
        document.documentElement.classList.add("mobile-write-page");
    }
</script>

<DashboardLayout title="Write Article">
    <div
        id="writePageMetadata"
        data-user-email={userEmail}
        data-file-path={filePath}
        class="hidden"
    >
    </div>
    <div
        id="smartPopup"
        class="fixed bottom-5 right-5 transform translate-y-20 opacity-0 bg-slate-900 text-white px-6 py-4 rounded-xl shadow-2xl border border-emerald-500/30 flex items-center gap-4 transition-all duration-500 z-[60] pointer-events-none max-w-sm"
    >
        <div
            id="popupIconWrap"
            class="w-10 h-10 rounded-full bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold shrink-0 animate-bounce"
        >
            <span id="popupIcon">
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
                    ></path></svg
                >
            </span>
        </div>
        <div class="min-w-0">
            <h4 id="popupTitle" class="font-bold text-sm text-emerald-400">
                AI Generation Success!
            </h4>
            <p
                id="popupModelName"
                class="text-xs text-slate-300 mt-0.5 break-words"
            >
                Model: Loading...
            </p>
        </div>
    </div>

    <div
        id="customConfirmOverlay"
        class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm hidden z-[100] items-center justify-center opacity-0 transition-opacity duration-300"
    >
        <div
            class="bg-white rounded-2xl shadow-2xl w-[90vw] max-w-md transform scale-95 transition-transform duration-300 flex flex-col overflow-hidden"
        >
            <div class="p-6">
                <div
                    class="w-12 h-12 rounded-full bg-amber-100 flex items-center justify-center mb-4 text-amber-600"
                >
                    <span id="customConfirmIcon">
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                            ></path></svg
                        >
                    </span>
                </div>
                <h3
                    id="customConfirmTitle"
                    class="text-xl font-bold text-[#1e293b] mb-2"
                >
                    Confirm Action
                </h3>
                <p
                    id="customConfirmMsg"
                    class="text-sm text-[#475569] leading-relaxed"
                >
                </p>
            </div>
            <div
                class="bg-slate-50 px-6 py-4 flex justify-end gap-3 border-t border-slate-100"
            >
                <button
                    id="customConfirmCancel"
                    class="px-5 py-2.5 text-sm font-semibold text-[#475569] hover:bg-[#e2e8f0] rounded-lg transition-colors"
                    >Cancel</button
                >
                <button
                    id="customConfirmOk"
                    class="px-5 py-2.5 text-sm font-semibold text-white rounded-lg transition-colors shadow-sm"
                    >Confirm</button
                >
            </div>
        </div>
    </div>

    <div
        id="uploadSpinnerOverlay"
        class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden z-[110] items-center justify-center"
    >
        <div class="bg-white rounded-2xl px-8 py-7 text-center shadow-2xl">
            <div
                class="w-10 h-10 border-4 border-[#e2e8f0] border-t-[#1a73e8] rounded-full animate-spin mx-auto mb-3"
            >
            </div>
            <p
                id="uploadSpinnerMsg"
                class="text-sm font-semibold text-[#1e293b]"
            >
                Uploading...
            </p>
        </div>
    </div>

    <div
        id="linkModalOverlay"
        class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden z-[90] transition-opacity duration-300"
        onclick="closeLinkModal()"
    >
    </div>
    <div
        id="linkModal"
        class="fixed inset-0 m-auto hidden z-[100] bg-white rounded-2xl shadow-2xl w-[90vw] max-w-sm flex-col p-6 h-fit"
    >
        <h3
            class="text-lg font-bold text-[#1e293b] mb-4 flex items-center gap-2"
        >
            <svg
                class="w-5 h-5 text-blue-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
                ></path></svg
            >
            Insert Link
        </h3>
        <input
            type="url"
            id="linkUrl"
            placeholder="https://example.com"
            class="w-full border border-[#cbd5e1] rounded-lg px-3 py-2 text-sm mb-3 focus:outline-none focus:border-[#1a73e8]"
        />
        <input
            type="text"
            id="linkText"
            placeholder="Link Text"
            class="w-full border border-[#cbd5e1] rounded-lg px-3 py-2 text-sm mb-3 focus:outline-none focus:border-[#1a73e8]"
        />
        <select
            id="linkRel"
            class="w-full border border-[#cbd5e1] rounded-lg px-3 py-2 text-sm mb-3 focus:outline-none focus:border-[#1a73e8]"
        >
            <option value="">Dofollow</option>
            <option value="nofollow">Nofollow</option>
        </select>
        <select
            id="linkTarget"
            class="w-full border border-[#cbd5e1] rounded-lg px-3 py-2 text-sm mb-4 focus:outline-none focus:border-[#1a73e8]"
        >
            <option value="_blank">New Tab (_blank)</option>
            <option value="_self">Same Tab (_self)</option>
        </select>
        <div class="flex justify-end gap-2">
            <button
                type="button"
                class="px-4 py-2 text-sm font-semibold text-[#475569] hover:bg-[#e2e8f0] rounded-lg transition-colors"
                onclick="closeLinkModal()">Cancel</button
            >
            <button
                type="button"
                class="px-4 py-2 text-sm font-semibold text-white bg-[#1a73e8] hover:bg-[#1557b0] rounded-lg transition-colors"
                onclick="insertLinkFromModal()">Insert</button
            >
        </div>
    </div>

    <div
        id="imgModalOverlay"
        class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden z-[100] transition-opacity duration-300"
        onclick="closeImageModal()"
    >
    </div>
    <div
        id="imgModal"
        class="fixed inset-0 m-auto hidden z-[110] bg-white rounded-2xl shadow-2xl w-[95vw] max-w-3xl max-h-[88vh] flex-col"
    >
        <div
            class="relative z-[120] flex items-center justify-between px-5 py-3.5 border-b border-[#e2e8f0] bg-[#f8fafc] shrink-0"
        >
            <select
                id="imgModalProviderSelect"
                onchange="switchModalProvider(this.value)"
                class="relative z-[120] font-bold text-[#1e293b] text-sm uppercase tracking-wide bg-transparent border-none outline-none cursor-pointer pr-2"
            >
                <option value="unsplash">UNSPLASH</option>
                <option value="pexels">PEXELS</option>
                <option value="pixabay">PIXABAY</option>
                <option value="cfflux">CF FLUX AI</option>
                <option value="upload">UPLOAD</option>
            </select>
            <button
                type="button"
                onclick="closeImageModal()"
                class="text-[#94a3b8] hover:text-[#dc2626] text-2xl leading-none transition-colors"
                aria-label="Close">&times;</button
            >
        </div>
        <div
            id="imgModalBody"
            onscroll="handleModalScroll()"
            class="flex-1 overflow-y-auto p-4 sm:p-5"
        >
            <div id="imgModalSearchRow" class="flex gap-2 mb-4">
                <input
                    id="imgModalInput"
                    type="text"
                    placeholder="Search keyword or AI prompt..."
                    class="flex-1 min-w-0 border border-[#cbd5e1] rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-[#1a73e8] focus:ring-2 focus:ring-[#1a73e8]/10"
                />
                <button
                    type="button"
                    id="imgModalActionBtn"
                    onclick="runModalAction(true)"
                    class="shrink-0 bg-[#1a73e8] hover:bg-[#1557b0] text-white px-5 py-2.5 rounded-lg text-sm font-semibold transition-colors flex items-center gap-2"
                >
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                        ></path></svg
                    >
                    Search
                </button>
            </div>
            <input
                type="file"
                id="uploadFileInputModal"
                accept="image/jpeg,image/png,image/webp,image/gif"
                class="hidden"
                onchange="handleModalLocalUpload()"
            />
            <div
                id="imgModalGrid"
                class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3"
            >
            </div>
            <div
                id="imgModalLoadingMore"
                class="hidden text-center text-xs text-[#64748b] py-4"
            >
                Loading more images...
            </div>
        </div>
    </div>
    <VideoModal />
    <TableModal />

    <!-- ═══ MOBILE EDITOR HEADER (Blogger-style) ═══ -->
    <div
        id="mobileEditorHeader"
        class="md:hidden flex items-center justify-between px-3 h-14 bg-white border-b border-[#dadce0]"
    >
        <div class="flex items-center gap-3">
            <a
                href="/"
                class="w-10 h-10 flex items-center justify-center hover:bg-gray-100 transition-colors"
                aria-label="Back to Dashboard"
            >
                <svg
                    class="w-5 h-5 text-[#5f6368]"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg
                >
            </a>
            <img src="/logo.png" alt="Logo" class="h-8 w-auto object-contain" />
        </div>
        <div class="flex items-center gap-2">
            <button
                id="mobileConsoleBtn"
                type="button"
                onclick="toggleMobileConsole()"
                class="w-9 h-9 flex items-center justify-center text-[#5f6368] hover:bg-slate-100 rounded-[2px] transition-colors border border-transparent"
                title="Console Logs"
            >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
            </button>
            {
                currentAuthor.avatarUrl ? (
                    <img
                        src={currentAuthor.avatarUrl}
                        alt={currentAuthor.name}
                        class="w-9 h-9 rounded-full object-cover shadow-sm"
                    />
                ) : (
                    <div class="w-9 h-9 bg-[#1a73e8] rounded-full text-white flex items-center justify-center font-bold text-sm shadow-sm">
                        {userEmail?.charAt(0).toUpperCase() ?? "U"}
                    </div>
                )
            }
        </div>
    </div>

    <div
        class="hidden md:flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4"
    >
        <div>
            <h2 class="text-2xl font-bold text-[#1e293b]">Create New Post</h2>
            <p class="text-sm text-[#64748b]">
                Write, optimize, and publish directly to your Astro site.
            </p>
        </div>
        <div class="flex items-center gap-3 w-full sm:w-auto">
            <button
                id="btnSaveDraftHeader"
                class="px-4 py-2 text-[#475569] bg-white border border-[#cbd5e1] hover:bg-[#f8fafc] rounded-lg text-sm font-medium transition-colors w-full sm:w-auto flex items-center justify-center gap-2"
            >
                <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"
                    ></path></svg
                >
                Save Draft
            </button>
            <button
                id="publishBtnHeader"
                class="px-6 py-2 bg-[#1a73e8] hover:bg-[#1557b0] text-white rounded-lg text-sm font-medium shadow-sm transition-colors w-full sm:w-auto flex items-center justify-center gap-2"
            >
                <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"
                    ></path></svg
                >
                Publish
            </button>
        </div>
    </div>

    <div id="mainGrid" class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Desktop: editor column sticks to viewport; only text inside scrolls. -->
        <!-- If your DashboardLayout has a fixed header, change top-4 to match its height (e.g. lg:top-[65px]) -->
        <div id="editorColumn" class="lg:col-span-2 space-y-6">
            <div class="title-input-wrap group">
                <textarea
                    id="postTitle"
                    rows="1"
                    placeholder="Enter article title here..."
                    class="title-textarea"
                    oninput="autoResizeTitle(this)"></textarea>
                <!-- Mobile Title Actions (visible only on mobile) -->
                <div
                    id="mobileTitleActions"
                    class="hidden items-center gap-1.5 shrink-0 self-center"
                >
                    <!-- Grouped AI and Save Buttons with Border -->
                    <div
                        class="flex items-center border border-[#dadce0] rounded-[2px] bg-white h-10 overflow-hidden shrink-0"
                    >
                        <!-- AI Icon Button -->
                        <button
                            id="mobileAiBtn"
                            type="button"
                            class="w-10 h-10 flex items-center justify-center hover:bg-slate-50 transition-colors"
                            title="AI Source Popup"
                        >
                            <svg
                                class="w-5 h-5"
                                viewBox="0 0 24 24"
                                fill="none"
                            >
                                <defs>
                                    <linearGradient
                                        id="aiGrad"
                                        x1="-0.44"
                                        y1="13.12"
                                        x2="23.53"
                                        y2="7.61"
                                        gradientUnits="userSpaceOnUse"
                                    >
                                        <stop stop-color="#3186FF"></stop>
                                        <stop offset="0.45" stop-color="#346BF1"
                                        ></stop>
                                        <stop offset="0.95" stop-color="#4FA0FF"
                                        ></stop>
                                    </linearGradient>
                                </defs>
                                <path
                                    d="M8 17C8.28333 17 8.51667 16.9083 8.7 16.725C8.9 16.525 9 16.2833 9 16C9 15.7167 8.9 15.4833 8.7 15.3C8.51667 15.1 8.28333 15 8 15C7.71667 15 7.475 15.1 7.275 15.3C7.09167 15.4833 7 15.7167 7 16C7 16.2833 7.09167 16.525 7.275 16.725C7.475 16.9083 7.71667 17 8 17ZM8 13C8.28333 13 8.51667 12.9083 8.7 12.725C8.9 12.525 9 12.2833 9 12C9 11.7167 8.9 11.4833 8.7 11.3C8.51667 11.1 8.28333 11 8 11C7.71667 11 7.475 11.1 7.275 11.3C7.09167 11.4833 7 11.7167 7 12C7 12.2833 7.09167 12.525 7.275 12.725C7.475 12.9083 7.71667 13 8 13ZM8 9C8.28333 9 8.51667 8.90833 8.7 8.725C8.9 8.525 9 8.28333 9 8C9 7.71667 8.9 7.48333 8.7 7.3C8.51667 7.1 8.28333 7 8 7C7.71667 7 7.475 7.1 7.275 7.3C7.09167 7.48333 7 7.71667 7 8C7 8.28333 7.09167 8.525 7.275 8.725C7.475 8.90833 7.71667 9 8 9ZM11 17H17V15H11V17ZM11 13H15V11H11V13ZM5 21C4.45 21 3.975 20.8083 3.575 20.425C3.19167 20.0208 3 19.55 3 19V5C3 4.45 3.19167 3.98333 3.575 3.6C3.975 3.2 4.45 3 5 3H13C13 3.3 13 3.61667 13 3.95C13 4.28333 13 4.63333 13 5H5V19H19V11C19.3667 11 19.7167 11 20.05 11C20.3833 11 20.7 11 21 11V19C21 19.55 20.8 20.025 20.4 20.425C20.0167 20.8083 19.55 21 19 21H5ZM17.5 12C17.5 10.4667 16.9667 9.16667 15.9 8.1C14.8333 7.03333 13.5333 6.5 12 6.5C13.5333 6.5 14.8333 5.96667 15.9 4.9C16.9667 3.83333 17.5 2.53333 17.5 0.999999C17.5 2.53333 18.0333 3.83333 19.1 4.9C20.1667 5.96667 21.4667 6.5 23 6.5C21.4667 6.5 20.1667 7.03333 19.1 8.1C18.0333 9.16667 17.5 10.4667 17.5 12Z"
                                    fill="url(#aiGrad)"></path>
                            </svg>
                        </button>
                        <!-- Vertical Divider -->
                        <div class="w-[1px] h-6 bg-[#dadce0] shrink-0"></div>
                        <!-- Save Icon Button -->
                        <button
                            id="mobileSaveBtn"
                            type="button"
                            class="w-10 h-10 flex items-center justify-center text-[#5f6368] hover:bg-slate-100 transition-colors"
                            title="Save Draft"
                        >
                            <svg class="w-5 h-5" viewBox="0 0 512 512">
                                <rect
                                    x="73.143"
                                    fill="#F2F2F4"
                                    width="310.857"
                                    height="237.714"></rect>
                                <rect
                                    x="256"
                                    fill="#DFDFE1"
                                    width="128"
                                    height="237.714"></rect>
                                <g>
                                    <rect
                                        x="182.857"
                                        fill="#88888F"
                                        width="73.143"
                                        height="164.571"></rect>
                                    <polygon
                                        fill="#88888F"
                                        points="402.286,0 384,0 384,219.429 109.714,219.429 109.714,0 0,0 0,512 512,512 512,109.714"
                                    ></polygon>
                                </g>
                                <polygon
                                    fill="#56545A"
                                    points="402.286,0 384,0 384,219.429 256,219.429 256,512 512,512 512,109.714"
                                ></polygon>
                            </svg>
                        </button>
                    </div>
                    <!-- Publish (Send) Button in GitHub Color -->
                    <button
                        id="mobilePublishBtn"
                        type="button"
                        class="w-10 h-10 flex items-center justify-center bg-[#2ea44f] hover:bg-[#2c974b] text-white transition-colors"
                        title="Publish to GitHub"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"
                            ></path>
                        </svg>
                    </button>
                </div>
                <div class="title-meta">
                    <span class="title-counter-label"
                        ><span id="titleCounter">0</span><span
                            class="title-counter-sep">/</span
                        >60</span
                    >
                </div>
            </div>

            <div
                id="originalArticleLink"
                class="hidden bg-[#f8fafc] border border-[#e2e8f0] rounded-lg px-4 py-2 text-xs text-[#64748b]"
            >
            </div>

            <div
                id="editorContainer"
                class="bg-white rounded-xl border border-[#e2e8f0] shadow-sm overflow-hidden flex flex-col h-[650px] lg:h-[calc(100vh-80px)] relative lg:sticky lg:top-0 lg:self-start"
            >
                <div
                    class="hidden md:flex border-b border-[#e2e8f0] bg-[#f8fafc] overflow-x-auto scrollbar-hide shrink-0"
                    id="editorTabs"
                >
                    <button
                        data-target="composeView"
                        class="tab-btn px-4 py-3 text-sm font-medium border-b-2 border-[#1a73e8] text-[#1a73e8] bg-white transition-colors active whitespace-nowrap"
                        >Compose</button
                    >
                    <button
                        data-target="markdownView"
                        class="tab-btn px-4 py-3 text-sm font-medium border-b-2 border-transparent text-[#64748b] hover:text-[#1e293b] hover:bg-slate-50 transition-colors whitespace-nowrap"
                        >Markdown</button
                    >
                    <button
                        data-target="htmlView"
                        class="tab-btn px-4 py-3 text-sm font-medium border-b-2 border-transparent text-[#64748b] hover:text-[#1e293b] hover:bg-slate-50 transition-colors whitespace-nowrap"
                        >HTML Editor</button
                    >
                    <button
                        data-target="consoleView"
                        class="tab-btn px-4 py-3 text-sm font-medium border-b-2 border-transparent text-amber-600 hover:text-amber-700 transition-colors flex items-center gap-1.5 whitespace-nowrap ml-auto"
                    >
                        <span
                            class="w-2 h-2 rounded-full bg-amber-500 animate-ping"
                        ></span>
                        Console Logs
                    </button>
                </div>

                <div
                    id="editorToolbarWrap"
                    class="relative shrink-0 border-b border-[#e2e8f0] bg-[#f8fafc] flex items-center px-1"
                >
                    <div
                        id="mobilePencilDropdown"
                        class="hidden relative shrink-0 z-50"
                    >
                        <button
                            id="pencilDropdownBtn"
                            type="button"
                            class="px-2.5 h-9 flex items-center justify-center gap-1.5 text-[#5f6368] hover:bg-slate-100 rounded-[2px] transition-colors border border-transparent"
                            title="Switch Editor View"
                        >
                            <span
                                id="pencilIconCurrent"
                                class="flex items-center justify-center"
                            >
                                <svg
                                    class="w-4 h-4 text-[#5f6368]"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
