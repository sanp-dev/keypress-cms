                        <option value="default_rss" selected
                            >Google News RSS</option
                        >
                        <option value="custom_rss">Custom RSS</option>
                        <option value="url">Article URL</option>
                        <option value="topic">Custom Topic</option>
                        <option value="only_quiz">Only Quiz</option>
                    </select>

                    <div id="pane-default_rss" class="src-pane space-y-2">
