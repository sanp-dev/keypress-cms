    <script is:inline>
        // ═══════════════════════════════════════════════════════════════════════
        // Client-side JavaScript for Messaging Page
        // ═══════════════════════════════════════════════════════════════════════

        let logCount = 0;
        let pendingPushSlug = null;
        let pendingPushBtn = null;
        let pendingCancelSlug = null;
        let pendingCancelBtn = null;

        // ─── Tab Switching ──────────────────────────────────────────────────
        function switchMsgTab(tabName) {
            // Update tab buttons
            document.querySelectorAll(".msg-tab-btn").forEach((btn) => {
                btn.classList.toggle("active", btn.dataset.tab === tabName);
            });
            // Update tab content
            document.querySelectorAll(".msg-tab-content").forEach((content) => {
                content.classList.remove("active");
            });
            const target = document.getElementById(
                tabName === "posts" ? "msgTabPosts" : "msgTabConsole",
            );
            if (target) target.classList.add("active");

            // Reset badge when switching to console
            if (tabName === "console") {
                const badge = document.getElementById("consoleBadge");
                if (badge) {
                    badge.textContent = "0";
                    badge.classList.add("empty");
                }
            }
        }

        // ─── Console Logging ────────────────────────────────────────────────
        function addConsoleLog(type, message) {
            const body = document.getElementById("consoleBody");
            const empty = document.getElementById("consoleEmpty");
            if (!body) return;
            if (empty) empty.style.display = "none";

            // Clean inline SVGs matching current text color using currentColor
            const svgs = {
                info: `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" style="display: inline-block; vertical-align: middle; flex-shrink: 0; width: 14px; height: 14px;"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
                success: `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" style="display: inline-block; vertical-align: middle; flex-shrink: 0; width: 14px; height: 14px;"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
                error: `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" style="display: inline-block; vertical-align: middle; flex-shrink: 0; width: 14px; height: 14px;"><path stroke-linecap="round" stroke-linejoin="round" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
                cleanup: `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" style="display: inline-block; vertical-align: middle; flex-shrink: 0; width: 14px; height: 14px;"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>`,
            };

            const now = new Date();
            const ts = now.toLocaleTimeString("en-IN", { hour12: false });

            const entry = document.createElement("div");
            entry.className = "log-entry";
            entry.style.display = "flex";
            entry.style.alignItems = "center";
            entry.style.gap = "0.5rem";

            entry.innerHTML = `<span class="log-ts">[${ts}]</span> <span class="log-${type}" style="display: inline-flex; align-items: center; gap: 0.375rem;">${svgs[type] || ""} <span>${escapeHtml(message)}</span></span>`;
            body.appendChild(entry);
            body.scrollTop = body.scrollHeight;

            // Update badge if console tab is not active
            const consoleTab = document.getElementById("msgTabConsole");
            if (!consoleTab || !consoleTab.classList.contains("active")) {
                logCount++;
                const badge = document.getElementById("consoleBadge");
                if (badge) {
                    badge.textContent = logCount > 99 ? "99+" : logCount;
                    badge.classList.remove("empty");
                }
            }
        }

        function clearMsgConsole() {
            const body = document.getElementById("consoleBody");
            if (body) {
                body.innerHTML = `<div class="console-empty" id="consoleEmpty">
                    <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" stroke="#475569"/>
                    </svg>
                    <p class="text-sm text-[#475569]">Console cleared.</p>
                </div>`;
            }
            logCount = 0;
            const badge = document.getElementById("consoleBadge");
            if (badge) {
                badge.textContent = "0";
                badge.classList.add("empty");
            }
        }

        function escapeHtml(text) {
            const div = document.createElement("div");
            div.textContent = text;
            return div.innerHTML;
        }

        // ─── Custom Confirmation Modal ──────────────────────────────────────
        function closeConfirmModal() {
            const modal = document.getElementById("confirmModal");
            if (modal) modal.classList.add("hidden");
            pendingPushSlug = null;
            pendingPushBtn = null;
        }

        function openConfirmModal(slug, btnEl) {
            const postTitle = btnEl.closest("tr")?.dataset?.title || slug;
            document.getElementById("confirmPostTitle").textContent =
                `"${postTitle}"`;

            pendingPushSlug = slug;
            pendingPushBtn = btnEl;

            const modal = document.getElementById("confirmModal");
            if (modal) modal.classList.remove("hidden");
        }

        function openCancelConfirmModal(slug, btnEl) {
            const postTitle = btnEl.closest("tr")?.dataset?.title || slug;
            document.getElementById("cancelConfirmPostTitle").textContent =
                `"${postTitle}"`;

            pendingCancelSlug = slug;
            pendingCancelBtn = btnEl;

            const modal = document.getElementById("cancelConfirmModal");
            if (modal) modal.classList.remove("hidden");
        }

        function closeCancelConfirmModal() {
            const modal = document.getElementById("cancelConfirmModal");
            if (modal) modal.classList.add("hidden");
            pendingCancelSlug = null;
            pendingCancelBtn = null;
        }

        function toggleScheduleInput(modalType) {
            const checkbox = document.getElementById(
                `${modalType}ScheduleCheckbox`,
            );
            const container = document.getElementById(
                `${modalType}ScheduleTimeContainer`,
            );
            if (checkbox && container) {
                if (checkbox.checked) {
                    container.classList.remove("hidden");
                    // Set default schedule time to current time + 1 hour, formatted for datetime-local (YYYY-MM-DDTHH:MM)
                    const now = new Date();
                    now.setHours(now.getHours() + 1);
                    const localIso = new Date(
                        now.getTime() - now.getTimezoneOffset() * 60000,
                    )
                        .toISOString()
                        .slice(0, 16);
                    const timeInput = document.getElementById(
                        `${modalType}ScheduleTime`,
                    );
                    if (timeInput) timeInput.value = localIso;
                } else {
                    container.classList.add("hidden");
                }
            }
        }

        // Setup confirm click handler
        document
            .getElementById("confirmModalSendBtn")
            .addEventListener("click", () => {
                if (pendingPushSlug && pendingPushBtn) {
                    const slug = pendingPushSlug;
                    const btn = pendingPushBtn;

                    const isScheduled = document.getElementById(
                        "confirmScheduleCheckbox",
                    ).checked;
                    const scheduledTime = document.getElementById(
                        "confirmScheduleTime",
                    ).value;

                    closeConfirmModal();

                    if (isScheduled) {
                        executeScheduleDirect(slug, btn, scheduledTime);
                    } else {
                        executePushDirect(slug, btn);
                    }
                }
            });

        // Setup cancel confirm click handler
        document
            .getElementById("cancelConfirmModalBtn")
            .addEventListener("click", () => {
                if (pendingCancelSlug && pendingCancelBtn) {
                    const slug = pendingCancelSlug;
                    const btn = pendingCancelBtn;
                    closeCancelConfirmModal();
                    executeCancelSchedule(slug, btn);
                }
            });

        // Save and Load Sent/Scheduled Notifications to Persist Across Refreshes
        const LOCAL_STORAGE_KEY = "tsa_sent_notifications";

        function loadSentNotifications() {
            try {
                const stored = localStorage.getItem(LOCAL_STORAGE_KEY);
                if (!stored) return;
                const sentList = JSON.parse(stored);

                Object.keys(sentList).forEach((slug) => {
                    let isoString = "";
                    let status = "sent";

                    if (typeof sentList[slug] === "string") {
                        isoString = sentList[slug];
                    } else if (
                        sentList[slug] &&
                        typeof sentList[slug] === "object"
                    ) {
                        isoString = sentList[slug].time;
                        status = sentList[slug].status || "sent";
                    }

                    const date = new Date(isoString);
                    if (isNaN(date.getTime())) return;

                    const containers = document.querySelectorAll(
                        `[data-sent-for="${slug}"]`,
                    );
                    containers.forEach((container) => {
                        const timeEl = container.querySelector(".sent-time");
                        const textEl =
                            container.querySelector(".sent-indicator");
                        const cancelBtn = container.querySelector(
                            ".cancel-schedule-btn",
                        );

                        if (cancelBtn) {
                            cancelBtn.style.display =
                                status === "scheduled" ? "inline-flex" : "none";
                        }
                        if (textEl) {
                            if (status === "scheduled") {
                                textEl.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Scheduled`;
                                textEl.style.color = "#d97706"; // Amber/Orange
                            } else {
                                textEl.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Sent`;
                                textEl.style.color = "#059669"; // Green
                            }
                        }
                        if (timeEl) {
                            const options = { day: "numeric", month: "short" };
                            const datePart = date.toLocaleDateString(
                                "en-IN",
                                options,
                            );
                            const timePart = date.toLocaleTimeString("en-IN", {
                                hour: "2-digit",
                                minute: "2-digit",
                                hour12: false,
                            });
                            timeEl.textContent = `(${datePart}, ${timePart})`;
                        }
                        container.classList.remove("hidden");
                    });
                });
            } catch (e) {
                console.error("Failed to load sent notifications:", e);
            }
        }

        function saveSentNotification(slug, dateIsoString, status = "sent") {
            try {
                const stored = localStorage.getItem(LOCAL_STORAGE_KEY) || "{}";
                const sentList = JSON.parse(stored);
                sentList[slug] = { time: dateIsoString, status };
                localStorage.setItem(
                    LOCAL_STORAGE_KEY,
                    JSON.stringify(sentList),
                );
            } catch (e) {
                console.error("Failed to save sent notification:", e);
            }
        }

        function showSentIndicator(
            slug,
            optionalDateString,
            status = "sent",
            shouldSave = true,
        ) {
            const containers = document.querySelectorAll(
                `[data-sent-for="${slug}"]`,
            );
            if (containers.length > 0) {
                const isoString =
                    optionalDateString || new Date().toISOString();
                const date = new Date(isoString);

                containers.forEach((container) => {
                    const timeEl = container.querySelector(".sent-time");
                    const textEl = container.querySelector(".sent-indicator");
                    const cancelBtn = container.querySelector(
                        ".cancel-schedule-btn",
                    );

                    if (textEl) {
                        if (status === "scheduled") {
                            textEl.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Scheduled`;
                            textEl.style.color = "#d97706";
                        } else {
                            textEl.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Sent`;
                            textEl.style.color = "#059669";
                        }
                    }
                    if (timeEl && !isNaN(date.getTime())) {
                        const options = { day: "numeric", month: "short" };
                        const datePart = date.toLocaleDateString("en-IN", options); // e.g. "5 Jul"
                        const timePart = date.toLocaleTimeString("en-IN", {
                            hour: "2-digit",
                            minute: "2-digit",
                            hour12: false,
                        }); // e.g. "20:15"
                        timeEl.textContent = `(${datePart}, ${timePart})`;
                    }

                    if (cancelBtn) {
                        cancelBtn.style.display =
                            status === "scheduled" ? "inline-flex" : "none";
                    }
                    container.classList.remove("hidden");
                });

                if (shouldSave) {
                    saveSentNotification(slug, isoString, status);
                }
            }
        }

        async function executeScheduleDirect(slug, btnEl, scheduledTime) {
            if (!scheduledTime) {
                alert("Please select a valid date and time");
                return;
            }
            if (new Date(scheduledTime) <= new Date()) {
                alert("Scheduled time must be in the future");
                return;
            }

            switchMsgTab("console");
            addConsoleLog("info", `Scheduling notification for: ${slug}`);

            btnEl.disabled = true;

            try {
                const utcTime = new Date(scheduledTime).toISOString();
                addConsoleLog(
                    "info",
                    `Calling schedule-notification API for ${new Date(utcTime).toLocaleString()}...`,
                );
                const res = await fetch("/api/schedule-notification", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        slug,
                        scheduled_time: utcTime,
                    }),
                });

                const data = await res.json();

                if (!res.ok || !data.success) {
                    addConsoleLog(
                        "error",
                        `Scheduling error: ${data.error || "Unknown error"}`,
                    );
                    return;
                }

                addConsoleLog(
                    "success",
                    `📅 Notification scheduled successfully for: ${new Date(utcTime).toLocaleString()}`,
                );
                showSentIndicator(slug, utcTime, "scheduled");
            } catch (err) {
                addConsoleLog(
                    "error",
                    `Scheduling request failed: ${err.message}`,
                );
            } finally {
                btnEl.disabled = false;
            }
        }

        function cancelSchedule(slug, trashBtnEl) {
            openCancelConfirmModal(slug, trashBtnEl);
        }

        async function executeCancelSchedule(slug, trashBtnEl) {
            switchMsgTab("console");
            addConsoleLog("info", `Attempting to cancel schedule for: ${slug}`);

            if (trashBtnEl) trashBtnEl.disabled = true;

            try {
                addConsoleLog("info", "Calling cancel-schedule API...");
                const res = await fetch("/api/cancel-schedule", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ slug }),
                });

                const data = await res.json();

                if (!res.ok || !data.success) {
                    addConsoleLog(
                        "error",
                        `Cancellation failed: ${data.error || "Unknown error"}`,
                    );
                    return;
                }

                addConsoleLog(
                    "success",
                    `🧹 Scheduled notification for "${slug}" cancelled successfully`,
                );

                // Remove from localStorage
                try {
                    const stored = localStorage.getItem(LOCAL_STORAGE_KEY);
                    if (stored) {
                        const sentList = JSON.parse(stored);
                        delete sentList[slug];
                        localStorage.setItem(
                            LOCAL_STORAGE_KEY,
                            JSON.stringify(sentList),
                        );
                    }
                } catch (e) {
                    console.error(
                        "Failed to update localStorage on cancel:",
                        e,
                    );
                }

                // Hide indicator container
                const containers = document.querySelectorAll(
                    `[data-sent-for="${slug}"]`,
                );
                containers.forEach((container) => {
                    container.classList.add("hidden");
                });
            } catch (err) {
                addConsoleLog(
                    "error",
                    `Cancellation request failed: ${err.message}`,
                );
            } finally {
                if (trashBtnEl) trashBtnEl.disabled = false;
            }
        }

        // ─── Send Push (Direct — one click) ─────────────────────────────────
        function sendPushDirect(slug, btnEl) {
            // Reset confirm checkbox and container on open
            const checkbox = document.getElementById("confirmScheduleCheckbox");
            if (checkbox) checkbox.checked = false;
            const container = document.getElementById(
                "confirmScheduleTimeContainer",
            );
            if (container) container.classList.add("hidden");

            openConfirmModal(slug, btnEl);
        }

        async function executePushDirect(slug, btnEl) {
            switchMsgTab("console");
            addConsoleLog("info", `Preparing notification for: ${slug}`);

            // Disable button
            btnEl.disabled = true;
            const iconEl = btnEl.querySelector(".send-icon");
            if (iconEl) iconEl.classList.add("spin");

            try {
                addConsoleLog("info", "Calling send-notification API...");
                const res = await fetch("/api/send-notification", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ slug }),
                });

                const data = await res.json();

                if (!res.ok || !data.success) {
                    addConsoleLog(
                        "error",
                        `API error: ${data.error || "Unknown error"}`,
                    );
                    return;
                }

                // Replay server logs into console with slight delays for visual effect
                if (data.logs && Array.isArray(data.logs)) {
                    for (let i = 0; i < data.logs.length; i++) {
                        const log = data.logs[i];
                        await new Promise((r) => setTimeout(r, 80));
                        addConsoleLog(log.type, log.message);
                    }
                }

                // Show sent indicator on the post row
                showSentIndicator(slug);
            } catch (err) {
                addConsoleLog("error", `Request failed: ${err.message}`);
            } finally {
                btnEl.disabled = false;
                if (iconEl) iconEl.classList.remove("spin");
            }
        }

        // ─── Edit Modal ─────────────────────────────────────────────────────
        async function openEditModal(slug) {
            const modal = document.getElementById("editModal");
            if (!modal) return;

            // Reset fields
            document.getElementById("editModalSlug").value = slug;
            document.getElementById("editTitle").value = "";
            document.getElementById("editBody").value = "";
            document.getElementById("editImage").value = "";
            document.getElementById("editUrl").value = "";
            document.getElementById("previewTitle").textContent = "Loading...";
            document.getElementById("previewBody").textContent = "";

            // Reset scheduling fields
            const checkbox = document.getElementById("editScheduleCheckbox");
            if (checkbox) checkbox.checked = false;
            const container = document.getElementById(
                "editScheduleTimeContainer",
            );
            if (container) container.classList.add("hidden");

            modal.classList.remove("hidden");

            // Fetch post metadata
            try {
                const res = await fetch(
                    `/api/send-notification?slug=${encodeURIComponent(slug)}`,
                );
                const data = await res.json();

                if (res.ok) {
                    document.getElementById("editTitle").value =
                        data.title || "";
                    document.getElementById("editBody").value =
                        data.description || "";
                    document.getElementById("editImage").value =
                        data.heroImage || "";
                    document.getElementById("editUrl").value = data.url || "";
                    document.getElementById("previewTitle").textContent =
                        data.title || slug;
                    document.getElementById("previewBody").textContent =
                        data.description || "No description";
                } else {
                    document.getElementById("previewTitle").textContent =
                        "Failed to load";
                    document.getElementById("previewBody").textContent =
                        data.error || "Unknown error";
                }
            } catch (err) {
                document.getElementById("previewTitle").textContent = "Error";
                document.getElementById("previewBody").textContent =
                    err.message;
            }

            // Live preview update listeners
            const titleInput = document.getElementById("editTitle");
            const bodyInput = document.getElementById("editBody");
            titleInput.oninput = () => {
                document.getElementById("previewTitle").textContent =
                    titleInput.value || "—";
            };
            bodyInput.oninput = () => {
                document.getElementById("previewBody").textContent =
                    bodyInput.value || "—";
            };
        }

        function closeEditModal() {
            const modal = document.getElementById("editModal");
            if (modal) modal.classList.add("hidden");
        }

        async function sendModifiedNotification() {
            const slug = document.getElementById("editModalSlug").value;
            const title = document.getElementById("editTitle").value.trim();
            const body = document.getElementById("editBody").value.trim();
            const image = document.getElementById("editImage").value.trim();
            const url = document.getElementById("editUrl").value.trim();
            const sendBtn = document.getElementById("modalSendBtn");

            const isScheduled = document.getElementById(
                "editScheduleCheckbox",
            ).checked;
            const scheduledTime =
                document.getElementById("editScheduleTime").value;

            if (!title) {
                alert("Title is required");
                return;
            }

            closeEditModal();

            if (isScheduled) {
                if (!scheduledTime) {
                    alert("Please select a valid date and time");
                    return;
                }
                if (new Date(scheduledTime) <= new Date()) {
                    alert("Scheduled time must be in the future");
                    return;
                }

                switchMsgTab("console");
                addConsoleLog(
                    "info",
                    `Scheduling modified notification for: ${slug}`,
                );
                if (sendBtn) sendBtn.disabled = true;

                try {
                    const utcTime = new Date(scheduledTime).toISOString();
                    const payload = { slug, scheduled_time: utcTime };
                    if (title) payload.title = title;
                    if (body) payload.body = body;
                    if (image) payload.image = image;
                    if (url) payload.url = url;

                    addConsoleLog(
                        "info",
                        "Calling schedule-notification API...",
                    );
                    const res = await fetch("/api/schedule-notification", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(payload),
                    });

                    const data = await res.json();

                    if (!res.ok || !data.success) {
                        addConsoleLog(
                            "error",
                            `Scheduling error: ${data.error || "Unknown error"}`,
                        );
                        return;
                    }

                    addConsoleLog(
                        "success",
                        `📅 Notification scheduled successfully for: ${new Date(utcTime).toLocaleString()}`,
                    );
                    showSentIndicator(slug, utcTime, "scheduled");
                } catch (err) {
                    addConsoleLog(
                        "error",
                        `Scheduling request failed: ${err.message}`,
                    );
                } finally {
                    if (sendBtn) sendBtn.disabled = false;
                }
            } else {
                switchMsgTab("console");
                addConsoleLog(
                    "info",
                    `Sending modified notification for: ${slug}`,
                );

                if (sendBtn) sendBtn.disabled = true;

                try {
                    const payload = { slug };
                    if (title) payload.title = title;
                    if (body) payload.body = body;
                    if (image) payload.image = image;
                    if (url) payload.url = url;

                    const res = await fetch("/api/send-notification", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(payload),
                    });

                    const data = await res.json();

                    if (!res.ok || !data.success) {
                        addConsoleLog(
                            "error",
                            `API error: ${data.error || "Unknown error"}`,
                        );
                        return;
                    }

                    if (data.logs && Array.isArray(data.logs)) {
                        for (let i = 0; i < data.logs.length; i++) {
                            await new Promise((r) => setTimeout(r, 80));
                            addConsoleLog(
                                data.logs[i].type,
                                data.logs[i].message,
                            );
                        }
                    }

                    showSentIndicator(slug);
                } catch (err) {
                    addConsoleLog("error", `Request failed: ${err.message}`);
                } finally {
                    if (sendBtn) sendBtn.disabled = false;
                }
            }
        }

        // ─── Search ─────────────────────────────────────────────────────────
        (function () {
            const searchInput = document.getElementById("msgSearchInput");
            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    const query = this.value.toLowerCase().trim();
                    document
                        .querySelectorAll(".msg-post-row")
                        .forEach((row) => {
                            const slug = row.dataset.slug || "";
                            const title = row.dataset.title || "";
                            const match =
                                !query ||
                                slug.includes(query) ||
                                title.toLowerCase().includes(query);
                            row.style.display = match ? "" : "none";
                        });
                });
            }
        })();

        // ─── Close modal on overlay click ───────────────────────────────────
        (function () {
            const editModal = document.getElementById("editModal");
            if (editModal) {
                editModal.addEventListener("click", function (e) {
                    if (e.target === editModal) closeEditModal();
                });
            }
            const confirmModal = document.getElementById("confirmModal");
            if (confirmModal) {
                confirmModal.addEventListener("click", function (e) {
                    if (e.target === confirmModal) closeConfirmModal();
                });
            }
            const cancelConfirmModal =
                document.getElementById("cancelConfirmModal");
            if (cancelConfirmModal) {
                cancelConfirmModal.addEventListener("click", function (e) {
                    if (e.target === cancelConfirmModal)
                        closeCancelConfirmModal();
                });
            }
        })();

        // ─── Close modal on Escape key ──────────────────────────────────────
        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape") {
                closeEditModal();
                closeConfirmModal();
                closeCancelConfirmModal();
            }
        });

        // ─── Load Sent Notifications on Init ────────────────────────────────
        loadSentNotifications();
    </script>
</DashboardLayout>
