---
// src/components/TableModal.astro
// Drag-to-select table size builder + header/data rows input
// Inserted as HTML into editor with .tsa-table-wrap
---

<div id="tableModalOverlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden z-[90] transition-opacity duration-300" onclick="closeTableModal()"></div>

<div id="tableModal" class="fixed inset-0 m-auto hidden z-[100] bg-white rounded-2xl shadow-2xl w-[95vw] max-w-xl flex-col overflow-hidden h-fit max-h-[90vh]">
    <div class="flex items-center justify-between px-5 py-3.5 border-b border-[#e2e8f0] bg-[#f8fafc] shrink-0">
        <h3 class="font-bold text-[#1e293b] text-sm uppercase tracking-wide flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18M10 3v18M14 3v18M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z"/>
            </svg>
            Insert Table
        </h3>
        <button type="button" onclick="closeTableModal()" class="text-[#94a3b8] hover:text-[#dc2626] text-2xl leading-none transition-colors">&times;</button>
    </div>

    <div class="p-5 overflow-y-auto space-y-5">
        <!-- Grid Picker -->
        <div>
            <p class="text-xs font-semibold text-[#475569] mb-2">Pick table size (rows × columns)</p>
            <div class="flex items-start gap-4">
                <div id="tableGridPicker" class="grid gap-1 select-none" style="grid-template-columns:repeat(8,1.75rem)">
                    <!-- Cells generated by JS -->
                </div>
                <div class="text-sm font-bold text-[#1a73e8] min-w-[3rem]" id="tableSizeLabel">2 × 3</div>
            </div>
        </div>

        <!-- Manual size inputs -->
        <div class="flex gap-3">
            <div class="flex-1">
                <label class="text-xs font-semibold text-[#475569] mb-1 block">Rows (incl. header)</label>
                <input type="number" id="tableRows" value="3" min="2" max="20"
                    class="w-full border border-[#cbd5e1] rounded-lg px-3 py-2 text-sm focus:border-[#1a73e8] focus:outline-none"
                    oninput="buildTableInputs()" />
            </div>
            <div class="flex-1">
                <label class="text-xs font-semibold text-[#475569] mb-1 block">Columns</label>
                <input type="number" id="tableCols" value="3" min="1" max="12"
                    class="w-full border border-[#cbd5e1] rounded-lg px-3 py-2 text-sm focus:border-[#1a73e8] focus:outline-none"
                    oninput="buildTableInputs()" />
            </div>
        </div>

        <!-- Table data inputs -->
        <div>
            <p class="text-xs font-semibold text-[#475569] mb-2">Enter table data <span class="font-normal text-[#94a3b8]">(Row 1 = Header)</span></p>
            <div id="tableInputGrid" class="overflow-x-auto rounded-xl border border-[#e2e8f0]">
                <!-- Built by buildTableInputs() -->
            </div>
        </div>

        <!-- Style select -->
        <div>
            <label class="text-xs font-semibold text-[#475569] mb-1 block">Output format</label>
            <select id="tableOutputFormat" class="w-full border border-[#cbd5e1] rounded-lg px-3 py-2 text-sm focus:border-[#1a73e8] focus:outline-none bg-[#f8fafc]">
                <option value="html">HTML (Styled tsa-table-wrap)</option>
                <option value="markdown">Markdown (|col|col|)</option>
            </select>
        </div>
    </div>

    <div class="bg-[#f8fafc] px-5 py-3.5 border-t border-[#e2e8f0] flex justify-end gap-2 shrink-0">
        <button type="button" onclick="closeTableModal()"
            class="px-4 py-2 text-xs font-semibold text-[#475569] hover:bg-[#e2e8f0] rounded-lg transition-colors">
            Cancel
        </button>
        <button type="button" onclick="insertTableFromModal()"
            class="px-5 py-2 text-xs font-semibold text-white bg-[#1a73e8] hover:bg-[#1557b0] rounded-lg transition-colors shadow-sm flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            Insert Table
        </button>
    </div>
</div>

<script is:inline>
// ─── Table Modal Controller ──────────────────────────────────────────────────

const TABLE_GRID_ROWS = 8;
const TABLE_GRID_COLS = 8;

let _hoveredRows = 2;
let _hoveredCols = 3;

function _buildGridPicker() {
    const grid = document.getElementById('tableGridPicker');
    if (!grid) return;
    grid.innerHTML = '';
    for (let r = 1; r <= TABLE_GRID_ROWS; r++) {
        for (let c = 1; c <= TABLE_GRID_COLS; c++) {
            const cell = document.createElement('div');
            cell.dataset.r = r;
            cell.dataset.c = c;
            cell.style.cssText = 'width:1.75rem;height:1.75rem;border-radius:4px;border:1.5px solid #e2e8f0;cursor:pointer;transition:background .1s,border-color .1s';
            cell.addEventListener('mouseover', function() {
                _hoveredRows = parseInt(this.dataset.r);
                _hoveredCols = parseInt(this.dataset.c);
                _updateGridHighlight();
            });
            cell.addEventListener('click', function() {
                _hoveredRows = parseInt(this.dataset.r);
                _hoveredCols = parseInt(this.dataset.c);
                document.getElementById('tableRows').value = _hoveredRows;
                document.getElementById('tableCols').value = _hoveredCols;
                buildTableInputs();
            });
            grid.appendChild(cell);
        }
    }
    _updateGridHighlight();
}

function _updateGridHighlight() {
    const label = document.getElementById('tableSizeLabel');
    if (label) label.textContent = _hoveredRows + ' × ' + _hoveredCols;
    document.querySelectorAll('#tableGridPicker > div').forEach(function(cell) {
        const r = parseInt(cell.dataset.r);
        const c = parseInt(cell.dataset.c);
        const active = r <= _hoveredRows && c <= _hoveredCols;
        cell.style.background = active ? '#dbeafe' : '';
        cell.style.borderColor = active ? '#3b82f6' : '#e2e8f0';
    });
}

window.buildTableInputs = function() {
    const rows = Math.min(20, Math.max(2, parseInt(document.getElementById('tableRows').value) || 3));
    const cols = Math.min(12, Math.max(1, parseInt(document.getElementById('tableCols').value) || 3));

    // Build a mini-spreadsheet grid of <input> cells
    let html = '<table style="border-collapse:collapse;width:100%;min-width:' + (cols * 100) + 'px">';
    for (let r = 0; r < rows; r++) {
        const isHeader = r === 0;
        html += '<tr>';
        for (let c = 0; c < cols; c++) {
            const bg = isHeader ? 'background:#1a73e8' : (r % 2 === 0 ? 'background:#f8fafc' : 'background:#fff');
            const color = isHeader ? 'color:#fff;font-weight:700' : 'color:#334155';
            html += `<td style="padding:0;border:1px solid #e2e8f0">
                <input type="text" data-r="${r}" data-c="${c}"
                    placeholder="${isHeader ? 'Header ' + (c + 1) : 'Row ' + r + ', Col ' + (c + 1)}"
                    style="${bg};${color};width:100%;border:none;padding:.45rem .6rem;font-size:.82rem;outline:none;font-family:inherit"
                    class="tbl-cell-input" />
            </td>`;
        }
        html += '</tr>';
    }
    html += '</table>';
    document.getElementById('tableInputGrid').innerHTML = html;
};

function _collectTableData() {
    const rows = parseInt(document.getElementById('tableRows').value) || 3;
    const cols = parseInt(document.getElementById('tableCols').value) || 3;
    const data = [];
    for (let r = 0; r < rows; r++) {
        const row = [];
        for (let c = 0; c < cols; c++) {
            const inp = document.querySelector(`input[data-r="${r}"][data-c="${c}"]`);
            row.push(inp ? inp.value.trim() || (r === 0 ? 'Column ' + (c + 1) : '') : '');
        }
        data.push(row);
    }
    return data;
}

function _dataToMarkdown(data) {
    const cols = data[0].length;
    const header = '| ' + data[0].join(' | ') + ' |';
    const sep = '| ' + Array(cols).fill('---').join(' | ') + ' |';
    const rows = data.slice(1).map(row => '| ' + row.join(' | ') + ' |').join('\n');
    return header + '\n' + sep + '\n' + rows;
}

function _dataToHTML(data) {
    const thead = '<thead><tr>' + data[0].map(h => `<th>${h || '&nbsp;'}</th>`).join('') + '</tr></thead>';
    const tbody = '<tbody>' + data.slice(1).map(row =>
        '<tr>' + row.map(cell => `<td>${cell || '&nbsp;'}</td>`).join('') + '</tr>'
    ).join('') + '</tbody>';
    return `<div class="tsa-table-wrap">\n<table>\n${thead}\n${tbody}\n</table>\n</div>`;
}

window.openTableModal = function() {
    document.getElementById('tableModalOverlay').classList.remove('hidden');
    document.getElementById('tableModal').classList.remove('hidden');
    document.getElementById('tableModal').classList.add('flex');
    _buildGridPicker();
    buildTableInputs();
};

window.closeTableModal = function() {
    document.getElementById('tableModalOverlay').classList.add('hidden');
    document.getElementById('tableModal').classList.add('hidden');
    document.getElementById('tableModal').classList.remove('flex');
};

window.insertTableFromModal = function() {
    const data = _collectTableData();
    const format = document.getElementById('tableOutputFormat').value;

    const TABLE_STYLE_MARKER = '<!-- tsa-table-styles -->';

    let tableBlock;
    if (format === 'markdown') {
        tableBlock = '\n\n' + _dataToMarkdown(data) + '\n\n';
    } else {
        tableBlock = '\n\n' + _dataToHTML(data) + '\n\n';
    }

    if (typeof window.insertRichBlock === 'function') {
        window.insertRichBlock(tableBlock, TABLE_STYLE_MARKER, window._TABLE_CSS || '');
    }

    closeTableModal();
};

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !document.getElementById('tableModal').classList.contains('hidden')) {
        closeTableModal();
    }
});
</script>