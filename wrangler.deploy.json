{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "demo-cms-quicdecode",
	"main": "dist/server/entry.mjs",
	"assets": {
		"directory": "dist/client",
		"binding": "ASSETS"
	},
	"compatibility_date": "2026-06-20",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"workers_dev": true,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"vars": {
		"IMAGE_PUBLIC_BASE_URL": "https://images.YOUR-DOMAIN.com",
		"BLOG_BASE_URL": "https://demo-blog.quicdecode.com",
		"CF_ZONE_TAG": "YOUR_CF_ZONE_TAG",
		"BING_INDEXNOW_KEY": "YOUR_BING_INDEXNOW_KEY",
		"VID_PUBLIC_BASE_URL": "https://cdn.YOUR-DOMAIN.com",
		"CRON_SECRET": "YOUR_RANDOM_CRON_SECRET"
	},
	"kv_namespaces": [
		{
			"binding": "CACHE_KV",
			"id": "54dea43604524adfacaf86e3b559b48f"
		},
		{
			"binding": "SESSION",
			"id": "c622eb21acd240b4a338de0bced4c235"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMG_BUCKET",
			"bucket_name": "demo-qd-images"
		},
		{
			"binding": "STORY_BUCKET",
			"bucket_name": "demo-qd-stories"
		},
		{
			"binding": "VID_BUCKET",
			"bucket_name": "demo-qd-videos"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "demo-qd-cms-db",
			"database_id": "953dde60-da59-4b11-b959-ee6ed7767f1f"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"routes": [
		{
			"pattern": "demo-cms.quicdecode.com",
			"custom_domain": true
		}
	]
}